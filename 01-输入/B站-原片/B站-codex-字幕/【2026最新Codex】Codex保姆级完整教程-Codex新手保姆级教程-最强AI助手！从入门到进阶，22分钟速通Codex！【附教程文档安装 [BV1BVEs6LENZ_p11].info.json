n=playurlv3&os=akam&og=ali&upsig=a07fd0e38e383ccd278e5cf99a421fa9&uparams=e,trid,mid,nbs,deadline,uipk,oi,platform,gen,os,og&hdnts=exp=1780907603~hmac=8baa6487cfe051a72ccd7e1281a8891c1b8fddf060e089422f1fe8c93a687e77&bvc=vod&nettype=0&bw=277668&lrs=0&buvid=56CBBADE-6E37-C95A-FAC9-97160BE6D01C13885infoc&build=0&dl=0&f=u_0_0&qn_dyeid=c7c126320a1780890034aa7a6a266233&agrr=1&orderid=0,2", "ext": "mp4", "fps": 30.0, "width": 1802, "height": 1080, "vcodec": "avc1.640033", "acodec": "none", "dynamic_range": "SDR", "tbr": 277.143, "quality": 80, "format_id": "30080", "format": "1080P 高清", "protocol": "https", "video_ext": "mp4", "audio_ext": "none", "abr": 0, "vbr": 277.143, "resolution": "1802x1080", "aspect_ratio": 1.67, "filesize_approx": 9545047, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/142.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.bilibili.com/video/BV1BVEs6LENZ?p=11"}}], "duration": 275.527, "subtitles": {"danmaku": [{"ext": "xml", "url": "https://comment.bilibili.com/38926289249.xml"}], "ai-zh": [{"ext": "srt", "data": "1\n00:00:01,120 --> 00:00:01,540\nHello\n\n2\n00:00:01,540 --> 00:00:02,640\n小伙伴们大家好\n\n3\n00:00:02,640 --> 00:00:05,689\n这节课呢我们来说一下codex的MCP\n\n4\n00:00:05,689 --> 00:00:07,409\n那什么是MCP呢\n\n5\n00:00:07,409 --> 00:00:09,150\n咱们简单看一下他的介绍吧\n\n6\n00:00:09,150 --> 00:00:14,110\n他说除了使用插件和skills能扩展codex的能力之外呢\n\n7\n00:00:14,110 --> 00:00:15,150\n还有一个方法\n\n8\n00:00:15,150 --> 00:00:17,470\n那就是MCPMCP啊\n\n9\n00:00:17,470 --> 00:00:20,110\n它翻译过来其实是模型上下文协议\n\n10\n00:00:20,110 --> 00:00:23,940\n简单的说MCP呢就是AI大模型的一个标准化工具箱\n\n11\n00:00:23,940 --> 00:00:25,580\n有了这个工具箱之后啊\n\n12\n00:00:25,580 --> 00:00:27,480\n我们就可以去访问第三方文档\n\n13\n00:00:27,480 --> 00:00:30,230\n外部工具以及共享信息等等操作\n\n14\n00:00:30,230 --> 00:00:32,490\n这里呢我们给大家做一个简单的示例吧\n\n15\n00:00:32,490 --> 00:00:34,490\n我们接入GITHUBMCP\n\n16\n00:00:34,490 --> 00:00:37,110\n这样的话我们就可以去管理issue和P2了\n\n17\n00:00:37,110 --> 00:00:40,790\n因为codex本身啊是有get命令的\n\n18\n00:00:40,790 --> 00:00:43,970\n我们用get命令呢也可以做一些基本的版本管理\n\n19\n00:00:43,970 --> 00:00:45,550\n但有些操作他是做不到的\n\n20\n00:00:45,550 --> 00:00:49,360\n比如说去创建PO就是pr或者是管理A宿\n\n21\n00:00:49,360 --> 00:00:50,860\n查看pr的评论\n\n22\n00:00:50,860 --> 00:00:53,420\n这个时候呢我们就需要GITHUB的API了\n\n23\n00:00:53,420 --> 00:00:56,600\n最简单的接入方式呢就是利用远程模式\n\n24\n00:00:56,600 --> 00:00:57,840\n不用装任何东西\n\n25\n00:00:57,840 --> 00:00:59,900\n这样啊我们回到codex里边\n\n26\n00:00:59,900 --> 00:01:01,160\n点击左下角的设置\n\n27\n00:01:01,160 --> 00:01:02,560\n再点击设置设置\n\n28\n00:01:02,560 --> 00:01:04,280\n这里呢有一个MCP的服务\n\n29\n00:01:04,280 --> 00:01:06,590\n我们点击添加服务器\n\n30\n00:01:06,590 --> 00:01:09,390\n这里呢其实添加MCP有两种方式\n\n31\n00:01:09,390 --> 00:01:10,790\n第一种是本地的方式\n\n32\n00:01:10,790 --> 00:01:13,980\n第二种呢相当于流失HTTP就是网络的形式\n\n33\n00:01:13,980 --> 00:01:16,200\n本地的方式呢我们就不给大家演示了\n\n34\n00:01:16,200 --> 00:01:18,440\n因为我本地并没有去创建MCP的服务\n\n35\n00:01:18,440 --> 00:01:20,540\n那我们就可以使用远程的方式\n\n36\n00:01:20,540 --> 00:01:23,940\n因为GITHUB这个它是支持远程模式的对吧\n\n37\n00:01:23,940 --> 00:01:25,720\n他也给出了对应的地址\n\n38\n00:01:25,720 --> 00:01:28,240\n好我们就用这个方式给大家做演示吧\n\n39\n00:01:28,240 --> 00:01:31,570\n那这里呢我们回到这边点击流失HTTP\n\n40\n00:01:31,570 --> 00:01:33,170\n首先呢需要有一个名字\n\n41\n00:01:33,170 --> 00:01:33,890\n名字的话\n\n42\n00:01:33,890 --> 00:01:40,320\n我们就复制mc p server这个点儿改成一个也改成一个下划线吧\n\n43\n00:01:40,320 --> 00:01:41,300\n好吧呃\n\n44\n00:01:41,300 --> 00:01:43,420\n代表是git的一个MCP服务\n\n45\n00:01:43,420 --> 00:01:45,480\n然后这里呢是需要URL地址的\n\n46\n00:01:45,480 --> 00:01:49,660\n那我们这边呢复制一下这个URL地址粘贴过来啊\n\n47\n00:01:49,660 --> 00:01:52,700\n再往下呢它需要有一个token的令牌\n\n48\n00:01:52,700 --> 00:01:55,520\n这个令牌你需要去GITHUB上去申请\n\n49\n00:01:55,520 --> 00:01:59,900\n比如我们这边点击浏览器来到GITHUB上面\n\n50\n00:01:59,900 --> 00:02:02,530\n然后我们点击这里有一个设置\n\n51\n00:02:02,530 --> 00:02:05,190\n就是你的头像的右侧有一个设置设置\n\n52\n00:02:05,190 --> 00:02:05,670\n往下找\n\n53\n00:02:05,670 --> 00:02:07,259\n有一个开发者设置\n\n54\n00:02:07,259 --> 00:02:10,179\n开发者设置呢我们再来点第三个选项\n\n55\n00:02:10,179 --> 00:02:12,399\n点击最后一个tokens\n\n56\n00:02:12,399 --> 00:02:14,099\n然后这里我们可以去添加\n\n57\n00:02:14,099 --> 00:02:14,910\n看到了吧\n\n58\n00:02:14,910 --> 00:02:16,490\n点击第二个选项\n\n59\n00:02:16,490 --> 00:02:18,070\n这样的话我们就可以去创建了\n\n60\n00:02:18,070 --> 00:02:20,570\n比如说我们这是codex杠\n\n61\n00:02:20,570 --> 00:02:23,570\n哎呃这codex原本存在我做测试了啊\n\n62\n00:02:23,570 --> 00:02:24,950\n哎我操操哈\n\n63\n00:02:24,950 --> 00:02:26,110\n这跑哪来了\n\n64\n00:02:26,110 --> 00:02:26,770\n后退啊\n\n65\n00:02:26,770 --> 00:02:28,090\n我们重新创建啊\n\n66\n00:02:28,090 --> 00:02:32,310\n点击嗯codex呃\n\n67\n00:02:32,310 --> 00:02:34,110\n然后杠GITHUB吧\n\n68\n00:02:34,110 --> 00:02:35,350\n可以吧\n\n69\n00:02:36,620 --> 00:02:39,380\nOK下面这里呢是授权的时长\n\n70\n00:02:39,380 --> 00:02:40,680\n我们就选个90天吧\n\n71\n00:02:40,680 --> 00:02:43,900\n然后这里呢我们把所有的选项呢都给它勾选了\n\n72\n00:02:43,900 --> 00:02:46,840\n这是他允许的能力扩展啊\n\n73\n00:02:46,840 --> 00:02:48,480\n就允许它具有哪些功能\n\n74\n00:02:48,480 --> 00:02:50,080\n我们这里没有全选\n\n75\n00:02:50,080 --> 00:02:53,990\n所以只能自己一个一个去去点中选择了\n\n76\n00:02:55,800 --> 00:02:57,320\n就把所有的能力都给他\n\n77\n00:02:57,320 --> 00:02:59,930\n然后我们创建token好\n\n78\n00:02:59,930 --> 00:03:02,970\n现在呢大家可以看到这里呢是不是就有了一个token了\n\n79\n00:03:02,970 --> 00:03:04,330\n我们复制一下啊\n\n80\n00:03:04,330 --> 00:03:05,170\n复制之后呢\n\n81\n00:03:05,170 --> 00:03:07,660\n来到我们的呃这边把它粘贴过来\n\n82\n00:03:07,660 --> 00:03:08,440\n这就是令牌\n\n83\n00:03:08,440 --> 00:03:09,540\n有了这个令牌之后呢\n\n84\n00:03:09,540 --> 00:03:11,160\n其他的值我们就不用管了啊\n\n85\n00:03:11,160 --> 00:03:13,719\n直接点保存好\n\n86\n00:03:13,719 --> 00:03:14,719\n保存完成之后呢\n\n87\n00:03:14,719 --> 00:03:17,419\n我们返回现在呢我们就有了一个MCP服务\n\n88\n00:03:17,419 --> 00:03:18,599\n然后他说老师没有啊\n\n89\n00:03:18,599 --> 00:03:20,299\n没有是因为我们配置完之后啊\n\n90\n00:03:20,299 --> 00:03:23,370\n你要退出当前的codex\n\n91\n00:03:23,370 --> 00:03:25,450\n然后重新打开\n\n92\n00:03:26,500 --> 00:03:28,740\n偶们稍等片刻啊\n\n93\n00:03:30,320 --> 00:03:31,680\nOK打开之后呢\n\n94\n00:03:31,680 --> 00:03:34,240\n我们的MCP啊就已经配置完成了\n\n95\n00:03:34,240 --> 00:03:35,360\n配置完成之后呢\n\n96\n00:03:35,360 --> 00:03:36,640\n我为了不耽误大家时间啊\n\n97\n00:03:36,640 --> 00:03:38,160\n在这里呢我已经提前问好了\n\n98\n00:03:38,160 --> 00:03:38,940\n大家可以看一下\n\n99\n00:03:38,940 --> 00:03:40,140\n我跟他说了一句话\n\n100\n00:03:40,140 --> 00:03:45,849\n我说使用GITHUB的MCP帮我看一下get hub项目最近的五个问题\n\n101\n00:03:45,849 --> 00:03:47,740\n然后按优先级进行排序\n\n102\n00:03:47,740 --> 00:03:50,960\n最开始啊我们在发这句话的时候\n\n103\n00:03:50,960 --> 00:03:53,020\n他并没有给我返回定的信息\n\n104\n00:03:53,020 --> 00:03:54,260\n它返回了一个空列表\n\n105\n00:03:54,260 --> 00:03:54,860\n为什么呢\n\n106\n00:03:54,860 --> 00:03:57,840\n因为我的GITHUB最开始的那个列表它就是空的\n\n107\n00:03:57,840 --> 00:03:58,840\n大家看一下\n\n108\n00:03:58,840 --> 00:04:01,500\n我们找到随便找打开一个项目\n\n109\n00:04:01,500 --> 00:04:02,480\n然后我们可以看一下\n\n110\n00:04:02,480 --> 00:04:03,800\n这里边最开始是空的\n\n111\n00:04:03,800 --> 00:04:06,180\n我是自己去添加了这样一个问题\n\n112\n00:04:06,180 --> 00:04:08,300\n然后之后呢我又跟他说\n\n113\n00:04:08,300 --> 00:04:09,780\n再再次给我做这个事\n\n114\n00:04:09,780 --> 00:04:13,800\n然后呢他用GITHUBMCP帮我查了最近有一个问题不足五个\n\n115\n00:04:13,800 --> 00:04:15,920\n然后P3的优先级\n\n116\n00:04:15,920 --> 00:04:17,500\n然后给出了这样一个信息\n\n117\n00:04:17,500 --> 00:04:20,760\n说明我们MCP已经能正常使用了\n\n118\n00:04:20,760 --> 00:04:22,300\n这是MCP好\n\n119\n00:04:22,300 --> 00:04:23,000\n比较简单\n\n120\n00:04:23,000 --> 00:04:25,320\n事实上大家应该把MCP也好\n\n121\n00:04:25,320 --> 00:04:26,020\nskills也好\n\n122\n00:04:26,020 --> 00:04:30,170\n都应该多用一些他们配合起来才能做更多的事情\n\n123\n00:04:30,170 --> 00:04:32,050\n那关于codex的MCP呢\n\n124\n00:04:32,050 --> 00:04:32,890\n我们就说到这里\n\n125\n00:04:32,890 --> 00:04:33,930\n感谢各位聆听\n\n126\n00:04:33,930 --> 00:04:35,520\n咱们下节再见\n\n"}]}, "webpage_url": "https://www.bilibili.com/video/BV1BVEs6LENZ?p=11", "webpage_url_basename": "BV1BVEs6LENZ", "webpage_url_domain": "bilibili.com", "extractor": "BiliBili", "extractor_key": "BiliBili", "playlist_count": 11, "playlist": "【2026最新Codex】Codex保姆级完整教程-C