j0eN0B599M=&trid=6c07ed2659c84f2a94c2dbce6c403feu&platform=pc&oi=1733154763&gen=playurlv3&os=akam&og=ali&uipk=5&mid=3546568672151587&nbs=1&deadline=1780907556&upsig=1d97e773649912a2581a5943ee039542&uparams=e,trid,platform,oi,gen,os,og,uipk,mid,nbs,deadline&hdnts=exp=1780907556~hmac=81cdab0e2b2a0ea6a96d030a6b371976fa5a6784267cecb0da889dc11762a024&bvc=vod&nettype=0&bw=201514&lrs=0&dl=0&f=u_0_0&qn_dyeid=4ce108c282aecaf6000565be6a266204&agrr=1&buvid=56CBBADE-6E37-C95A-FAC9-97160BE6D01C13885infoc&build=0&orderid=0,2", "ext": "mp4", "fps": 30.0, "width": 1802, "height": 1080, "vcodec": "av01.0.08M.08.0.110.01.01.01.0", "acodec": "none", "dynamic_range": "SDR", "tbr": 201.244, "quality": 80, "format_id": "100026", "format": "1080P 高清", "protocol": "https", "video_ext": "mp4", "audio_ext": "none", "abr": 0, "vbr": 201.244, "resolution": "1802x1080", "aspect_ratio": 1.67, "filesize_approx": 6801368, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/142.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.bilibili.com/video/BV1BVEs6LENZ?p=5"}}], "duration": 270.373, "subtitles": {"danmaku": [{"ext": "xml", "url": "https://comment.bilibili.com/38926287223.xml"}], "ai-zh": [{"ext": "srt", "data": "1\n00:00:00,940 --> 00:00:01,380\nHello\n\n2\n00:00:01,380 --> 00:00:02,500\n小伙伴们大家好\n\n3\n00:00:02,500 --> 00:00:05,960\n这节课呢我们来说一下code x的控制与引导\n\n4\n00:00:05,960 --> 00:00:06,620\n什么意思呢\n\n5\n00:00:06,620 --> 00:00:07,500\n咱们来看一下描述\n\n6\n00:00:07,500 --> 00:00:08,320\n大家也明白了啊\n\n7\n00:00:08,320 --> 00:00:10,640\n他说code x有一个非常强大的功能\n\n8\n00:00:10,640 --> 00:00:11,900\n那就是steer\n\n9\n00:00:11,900 --> 00:00:15,480\nsteer翻译过来应该是我们汽车方向盘的转动\n\n10\n00:00:15,480 --> 00:00:17,100\n就是打方向盘的一个控制\n\n11\n00:00:17,100 --> 00:00:18,580\n也可以理解为掌舵对吧\n\n12\n00:00:18,580 --> 00:00:22,360\n那在这里呢我们可以把它理解成控制和引导干嘛用呢\n\n13\n00:00:22,360 --> 00:00:23,260\n我们接着往下看\n\n14\n00:00:23,260 --> 00:00:29,020\n他说当我们发现AI在执行的过程当中理解错了我们的意思的时候\n\n15\n00:00:29,020 --> 00:00:31,060\n就不应该让它继续再执行了\n\n16\n00:00:31,060 --> 00:00:32,180\n因为已经理解错了\n\n17\n00:00:32,180 --> 00:00:33,420\n继续执行下去也没有意义了\n\n18\n00:00:33,420 --> 00:00:33,880\n对不对\n\n19\n00:00:33,880 --> 00:00:36,660\n所以此时可以人工干预这个过程\n\n20\n00:00:36,660 --> 00:00:38,640\n我们理解为steer好\n\n21\n00:00:38,640 --> 00:00:40,380\n那我们给大家演示一下这个过程吧\n\n22\n00:00:40,380 --> 00:00:41,760\n好回到我们的这边\n\n23\n00:00:41,760 --> 00:00:45,380\n假如说我们先来看一下之前的这个页面吧\n\n24\n00:00:45,380 --> 00:00:48,330\n这个页面我们打开看一眼嗯\n\n25\n00:00:48,330 --> 00:00:49,510\n还是挺美观的对吧\n\n26\n00:00:49,510 --> 00:00:51,530\n比如关于above这块的文本\n\n27\n00:00:51,530 --> 00:00:52,210\n我们想修改\n\n28\n00:00:52,210 --> 00:00:54,690\n或者说我想把这个文本给修改掉\n\n29\n00:00:54,690 --> 00:00:56,450\n那在这里呢我们可以改一下\n\n30\n00:00:56,450 --> 00:01:03,970\n就是跟他说将about部分的文本修改一下对吧\n\n31\n00:01:03,970 --> 00:01:05,330\n我们让它进行去修改\n\n32\n00:01:05,330 --> 00:01:07,530\n然后我们把右侧呃给关掉啊\n\n33\n00:01:07,530 --> 00:01:09,360\n此时他是不是继续修改了呀\n\n34\n00:01:09,360 --> 00:01:10,960\n修改呢他此时正在思考\n\n35\n00:01:10,960 --> 00:01:11,480\n正在操\n\n36\n00:01:11,480 --> 00:01:13,400\n就是等待他接着往下去操作\n\n37\n00:01:13,400 --> 00:01:13,720\n对吧\n\n38\n00:01:13,720 --> 00:01:15,490\n我们可以稍作等待的操作\n\n39\n00:01:15,490 --> 00:01:16,650\n当它操作起来的时候\n\n40\n00:01:16,650 --> 00:01:20,570\n我们会发现它整个的思考过程的呃方向\n\n41\n00:01:20,570 --> 00:01:23,590\n与我们想让它改的方向是错误的\n\n42\n00:01:23,590 --> 00:01:26,790\n那此时你可以继续让它去停掉\n\n43\n00:01:26,790 --> 00:01:30,490\n就是呃重新让他去换一个方向思考\n\n44\n00:01:30,490 --> 00:01:32,650\n比如说我们可以当现在正在思考啊\n\n45\n00:01:32,650 --> 00:01:32,930\n没关系\n\n46\n00:01:32,930 --> 00:01:33,450\n我们先打字\n\n47\n00:01:33,450 --> 00:01:41,330\n就是说将这个部分的内容变得要变得更温馨一点\n\n48\n00:01:41,810 --> 00:01:46,450\n改的更温馨一点对吧\n\n49\n00:01:46,450 --> 00:01:48,090\n当然现在呢他还思考的呢\n\n50\n00:01:48,090 --> 00:01:51,870\n我们还不知道他整个思考过程最终会往哪个方向思考\n\n51\n00:01:51,870 --> 00:01:54,490\n所以这里呢我们可以稍作等待\n\n52\n00:01:56,180 --> 00:01:57,820\nOK我们可以看到他已经说了\n\n53\n00:01:57,820 --> 00:01:59,560\n我把about改成什么什么什么\n\n54\n00:01:59,560 --> 00:02:00,740\n但是我们不希望这个\n\n55\n00:02:00,740 --> 00:02:02,700\n所以我们此时回车回车之后啊\n\n56\n00:02:02,700 --> 00:02:04,360\n你会发现这里面有个引导对吧\n\n57\n00:02:04,360 --> 00:02:05,920\n然后你点一下这个引导\n\n58\n00:02:05,920 --> 00:02:07,940\n因为我们认为它这个方向是错误的\n\n59\n00:02:07,940 --> 00:02:09,500\n你看它也保留什么当季火炉\n\n60\n00:02:09,500 --> 00:02:10,220\n我不想这样\n\n61\n00:02:10,220 --> 00:02:12,159\n我就想让他改的温馨一点对吧\n\n62\n00:02:12,159 --> 00:02:14,539\n所以大家可以看到此时已引导对话\n\n63\n00:02:14,539 --> 00:02:15,739\n看以引导对话\n\n64\n00:02:15,739 --> 00:02:18,420\n他说明白我把欧巴在什么什么什么\n\n65\n00:02:18,420 --> 00:02:20,660\n就按照你的需求再去进行修改了对吧\n\n66\n00:02:20,660 --> 00:02:21,420\n这就是引导\n\n67\n00:02:21,420 --> 00:02:23,460\n所以在整个的执行过程当中啊\n\n68\n00:02:23,460 --> 00:02:26,530\n你可以呃以这种方式来来来来操作\n\n69\n00:02:26,530 --> 00:02:28,730\n当然如果刚刚你在输入信息的时候\n\n70\n00:02:28,730 --> 00:02:30,300\n这里要不点击引导的话\n\n71\n00:02:30,300 --> 00:02:32,560\n那他就会把上一个任务执行完成之后\n\n72\n00:02:32,560 --> 00:02:34,440\n再去执行下一个任务啊\n\n73\n00:02:34,440 --> 00:02:35,620\n你点了引导之后\n\n74\n00:02:35,620 --> 00:02:37,240\n他又把上一个任务给暂停掉了\n\n75\n00:02:37,240 --> 00:02:38,660\n直接执行你的新的任务\n\n76\n00:02:38,660 --> 00:02:40,040\n现在呢他应该就改掉了\n\n77\n00:02:40,040 --> 00:02:41,680\n我们可以再来访问看一眼对吧\n\n78\n00:02:41,680 --> 00:02:43,280\n访问这个文件啊\n\n79\n00:02:43,280 --> 00:02:44,960\n这是他修改的内容对吧\n\n80\n00:02:44,960 --> 00:02:46,360\n这么看可能看着有点累的吧\n\n81\n00:02:46,360 --> 00:02:49,720\n我们回到刚刚这块儿点一下它来看一眼\n\n82\n00:02:49,720 --> 00:02:52,749\n看像回到一种一张熟悉的餐桌\n\n83\n00:02:52,749 --> 00:02:54,569\n哎这就明显温馨很多了对吧\n\n84\n00:02:54,569 --> 00:02:56,269\n熟悉的餐桌不是家的味道嘛\n\n85\n00:02:56,269 --> 00:02:56,740\n对不对\n\n86\n00:02:56,740 --> 00:02:59,320\n好OK那这个就是一个引导操作\n\n87\n00:02:59,320 --> 00:03:02,480\n当然呢我们还可以去修改他的跟进行为\n\n88\n00:03:02,480 --> 00:03:03,080\n刚刚说了\n\n89\n00:03:03,080 --> 00:03:05,880\n如果你不点击那个引导那个按钮的话\n\n90\n00:03:05,880 --> 00:03:07,760\n它就会把上一个任务做完再进行\n\n91\n00:03:07,760 -->