qx6gqj0eN0B599M=&trid=27ce7b5c38964f1cac82816205db02eu&deadline=1780907545&uipk=5&gen=playurlv3&os=akam&og=hw&oi=1733154763&platform=pc&mid=3546568672151587&nbs=1&upsig=f2828cf06750ceb4dd7b84ea7943caf0&uparams=e,trid,deadline,uipk,gen,os,og,oi,platform,mid,nbs&hdnts=exp=1780907545~hmac=9ba1ddc7c00965c6598aae90309b64cab52839cd94091bb8682d9717c52ec0be&bvc=vod&nettype=0&bw=182784&lrs=0&qn_dyeid=0af5a7abee9040a700a789456a2661f9&agrr=1&buvid=56CBBADE-6E37-C95A-FAC9-97160BE6D01C13885infoc&build=0&dl=0&f=u_0_0&orderid=0,2", "ext": "mp4", "fps": 30.0, "width": 1802, "height": 1080, "vcodec": "av01.0.08M.08.0.110.01.01.01.0", "acodec": "none", "dynamic_range": "SDR", "tbr": 182.733, "quality": 80, "format_id": "100026", "format": "1080P 高清", "protocol": "https", "video_ext": "mp4", "audio_ext": "none", "abr": 0, "vbr": 182.733, "resolution": "1802x1080", "aspect_ratio": 1.67, "filesize_approx": 22868989, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/142.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.bilibili.com/video/BV1BVEs6LENZ?p=4"}}], "duration": 1001.198, "subtitles": {"danmaku": [{"ext": "xml", "url": "https://comment.bilibili.com/38926225010.xml"}], "ai-zh": [{"ext": "srt", "data": "1\n00:00:00,760 --> 00:00:01,160\nHello\n\n2\n00:00:01,160 --> 00:00:02,240\n小伙伴们大家好\n\n3\n00:00:02,240 --> 00:00:05,780\n这节课呢我们来说一下code x的功能模块详解\n\n4\n00:00:05,780 --> 00:00:07,080\n回到code x里边\n\n5\n00:00:07,080 --> 00:00:08,210\n我们可以看一下啊\n\n6\n00:00:08,210 --> 00:00:10,650\n它这个里边其实还有很多功能模块\n\n7\n00:00:10,650 --> 00:00:13,790\n比如说左侧这里边有新对话\n\n8\n00:00:13,790 --> 00:00:15,930\n搜索插件自动化等等对吧\n\n9\n00:00:15,930 --> 00:00:17,790\n下方呢还有一个设置\n\n10\n00:00:17,790 --> 00:00:21,970\n中间这个区域呢下右侧这里还有很多模块\n\n11\n00:00:21,970 --> 00:00:23,150\n右侧这里还有模块\n\n12\n00:00:23,150 --> 00:00:25,730\n所以这些模块呢我们要想把code x使用好\n\n13\n00:00:25,730 --> 00:00:28,630\n都需要去掌握每一个模块都有什么样的功能\n\n14\n00:00:28,630 --> 00:00:29,120\n对不对\n\n15\n00:00:29,120 --> 00:00:30,400\n所以接下来呢我们要说的\n\n16\n00:00:30,400 --> 00:00:31,580\n其实就是这个部分内容\n\n17\n00:00:31,580 --> 00:00:33,760\n当然呢在说这些功能模块之前啊\n\n18\n00:00:33,760 --> 00:00:36,000\n先来回顾一下我们上节课留的一个尾巴\n\n19\n00:00:36,000 --> 00:00:36,740\n什么尾巴呢\n\n20\n00:00:36,740 --> 00:00:38,680\n上节课我们是不是创建了两个项目呀\n\n21\n00:00:38,680 --> 00:00:41,520\n一个是做一个页面实现to do list的对吧\n\n22\n00:00:41,520 --> 00:00:43,960\n还有一个是帮我实现一个餐馆的首页\n\n23\n00:00:43,960 --> 00:00:46,060\n看下这两个项目的效果怎么样\n\n24\n00:00:46,060 --> 00:00:47,700\n想看这个效果呢有两种方式\n\n25\n00:00:47,700 --> 00:00:49,540\n一种呢是我们打开它的工作空间\n\n26\n00:00:49,540 --> 00:00:50,680\n也是打开他的目录\n\n27\n00:00:50,680 --> 00:00:53,620\n然后双击找到里边的这个index HTML\n\n28\n00:00:53,620 --> 00:00:55,590\n打开看一眼还是很美观的\n\n29\n00:00:55,590 --> 00:00:56,150\n对不对好\n\n30\n00:00:56,150 --> 00:00:58,400\n这是一种呃看的方式\n\n31\n00:00:58,400 --> 00:01:00,440\n第二种呃呃不不还没完事\n\n32\n00:01:00,440 --> 00:01:01,800\n这里面还有一个to do list的呢\n\n33\n00:01:01,800 --> 00:01:02,280\n对不对好\n\n34\n00:01:02,280 --> 00:01:03,460\n这是to do list的好\n\n35\n00:01:03,460 --> 00:01:05,080\n大家可以进行添加删除等等\n\n36\n00:01:05,080 --> 00:01:05,940\n就增删改查嘛\n\n37\n00:01:05,940 --> 00:01:07,009\n代办事项好\n\n38\n00:01:07,009 --> 00:01:07,729\n那翻回来\n\n39\n00:01:07,729 --> 00:01:08,729\n这是第一种方式\n\n40\n00:01:08,729 --> 00:01:10,429\n第二种方式还可以怎么办呢\n\n41\n00:01:10,429 --> 00:01:12,509\n我们这里面其实是有浏览器的\n\n42\n00:01:12,509 --> 00:01:13,209\n在哪呢\n\n43\n00:01:13,209 --> 00:01:13,889\n大家看啊\n\n44\n00:01:13,889 --> 00:01:15,900\n我们无论是选中这个也好\n\n45\n00:01:15,900 --> 00:01:16,940\n选中上面这个也好\n\n46\n00:01:16,940 --> 00:01:18,380\n其实在右侧这里边啊\n\n47\n00:01:18,380 --> 00:01:20,200\n是不是有一个这样的图标啊\n\n48\n00:01:20,200 --> 00:01:21,740\n我们点一下这个图标\n\n49\n00:01:21,740 --> 00:01:22,660\n点一下这个图标之后\n\n50\n00:01:22,660 --> 00:01:24,060\n你可以看到我们默认啊\n\n51\n00:01:24,060 --> 00:01:25,020\n他肯定是这样的\n\n52\n00:01:25,020 --> 00:01:26,320\n我们点开它是空的\n\n53\n00:01:26,320 --> 00:01:27,020\n空的之后呢\n\n54\n00:01:27,020 --> 00:01:28,220\n这有个加号点加号\n\n55\n00:01:28,220 --> 00:01:29,500\n这里有一个浏览器\n\n56\n00:01:29,500 --> 00:01:30,100\n看到了吗\n\n57\n00:01:30,100 --> 00:01:31,860\n我们点一下这个浏览器\n\n58\n00:01:31,860 --> 00:01:33,800\n这里就会输入一个输入ULO地址\n\n59\n00:01:33,800 --> 00:01:37,440\n然后把你那个本地访问的地址给到他就可以了\n\n60\n00:01:37,440 --> 00:01:38,680\n或者你感觉麻烦\n\n61\n00:01:38,680 --> 00:01:43,050\n你也可以直接点它这里边所给出的这个index点HTML\n\n62\n00:01:43,050 --> 00:01:44,410\n他说点它就能看对吧\n\n63\n00:01:44,410 --> 00:01:45,190\n我们点一下\n\n64\n00:01:45,190 --> 00:01:47,530\n你看右侧是不是就访问这个地址了\n\n65\n00:01:47,530 --> 00:01:49,270\n然后大家可以看到就能看到了\n\n66\n00:01:49,270 --> 00:01:51,660\n也就说cox其实它是集成的浏览器\n\n67\n00:01:51,660 --> 00:01:53,840\n当然它这里其实是浏览器的插件对吧\n\n68\n00:01:53,840 --> 00:01:55,460\n好我们关掉这是一种\n\n69\n00:01:55,460 --> 00:01:56,780\n然后下面这个也是如此\n\n70\n00:01:56,780 --> 00:01:58,260\n我们点这个index HTML呢\n\n71\n00:01:58,260 --> 00:02:00,140\n它就可以看到这个to do list了\n\n72\n00:02:00,140 --> 00:02:01,180\n效果还是很好的\n\n73\n00:02:01,180 --> 00:02:03,110\n好关掉它不管它了\n\n74\n00:02:03,110 --> 00:02:05,930\n我们翻回来说我们本节课的重点功能模块详解\n\n75\n00:02:05,930 --> 00:02:07,510\n先来说第一个功能模块\n\n76\n00:02:07,510 --> 00:02:08,940\n搜索历史对话\n\n77\n00:02:08,940 --> 00:02:10,520\n左侧菜单栏的搜索\n\n78\n00:02:10,520 --> 00:02:14,280\n或者是快捷键CTRL加G就可以打开对话搜索\n\n79\n00:02:14,280 --> 00:02:16,080\n可以搜索到所有的历史对话\n\n80\n00:02:16,080 --> 00:02:17,700\n注意温馨提示\n\n81\n00:02:17,700 --> 00:02:19,920\n只能搜到对话的标题\n\n82\n00:02:19,920 --> 00:02:22,020\n是无法搜索到对话的内容的\n\n83\n00:02:22,020 --> 00:02:23,420\n你比如说我们回到这边\n\n84\n00:02:23,420 --> 00:02:25,720\n我们直接点左侧这个搜索\n\n85\n00:02:25,720 --> 00:02:28,690\n或者是大家按CTRL加G也可以打开\n\n86\n00:02:28,690 --> 00:02:31,610\n你看下面有很多是历史我的信息\n\n87\n00:02:31,610 --> 00:02:32,030\n对不对\n\n88\n00:02:32,030 --> 00:02:33,210\n在这里你就可以搜到了\n\n89\n00:02:33,210 --> 00:02:35,210\n比如我要搜餐馆\n\n90\n00:02:36,560 --> 00:02:37,680\n是不是就能搜到了\n\n91\n00:02:37,680 --> 00:02:38,600\n这是我历史的对话\n\n92\n00:02:38,600 --> 00:02:39,220