0eN0B599M=&mid=3546568672151587&uipk=5&trid=2bdf4ac36a604eb480a8d2592a20a14u&nbs=1&gen=playurlv3&os=akam&og=ali&deadline=1780907590&platform=pc&oi=1733154763&upsig=33ccf4f1fee44d618f3bf321325b45a2&uparams=e,mid,uipk,trid,nbs,gen,os,og,deadline,platform,oi&hdnts=exp=1780907590~hmac=7c417ec3e00e1e73be513b674150b8baf6fdba463a40c497f0a88d84fddb3ec8&bvc=vod&nettype=0&bw=202493&lrs=0&build=0&dl=0&f=u_0_0&qn_dyeid=decd39a1566e1271007286ef6a266226&agrr=1&buvid=56CBBADE-6E37-C95A-FAC9-97160BE6D01C13885infoc&orderid=0,2", "ext": "mp4", "fps": 30.0, "width": 1802, "height": 1080, "vcodec": "av01.0.08M.08.0.110.01.01.01.0", "acodec": "none", "dynamic_range": "SDR", "tbr": 202.152, "quality": 80, "format_id": "100026", "format": "1080P 高清", "protocol": "https", "video_ext": "mp4", "audio_ext": "none", "abr": 0, "vbr": 202.152, "resolution": "1802x1080", "aspect_ratio": 1.67, "filesize_approx": 10124277, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/142.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.bilibili.com/video/BV1BVEs6LENZ?p=9"}}], "duration": 400.66, "subtitles": {"danmaku": [{"ext": "xml", "url": "https://comment.bilibili.com/38926288317.xml"}], "ai-zh": [{"ext": "srt", "data": "1\n00:00:01,200 --> 00:00:01,640\nHello\n\n2\n00:00:01,640 --> 00:00:02,700\n小伙伴们大家好\n\n3\n00:00:02,700 --> 00:00:06,280\n这节课呢我们来说一下codex的插件与自动化\n\n4\n00:00:06,280 --> 00:00:08,260\n插件和自动化我们之前见过了\n\n5\n00:00:08,260 --> 00:00:09,540\n回到我们的codex里面\n\n6\n00:00:09,540 --> 00:00:11,220\n还记得我们左上角这里吗\n\n7\n00:00:11,220 --> 00:00:12,520\n我们讲了新对话\n\n8\n00:00:12,520 --> 00:00:13,460\n讲了搜索\n\n9\n00:00:13,460 --> 00:00:15,240\n但是没有讲插件和自动化\n\n10\n00:00:15,240 --> 00:00:15,920\n那这节课呢\n\n11\n00:00:15,920 --> 00:00:18,580\n我们就把插件和自动化给大家详细讲解一下\n\n12\n00:00:18,580 --> 00:00:19,590\n先来看插件\n\n13\n00:00:19,590 --> 00:00:20,750\n什么是插件呢\n\n14\n00:00:20,750 --> 00:00:24,200\n插件啊是第三方服务器为codex编写的软件包\n\n15\n00:00:24,200 --> 00:00:26,600\n而这些第三方软件把自己的能力啊\n\n16\n00:00:26,600 --> 00:00:29,400\n以插件的形式注入到了codex里边\n\n17\n00:00:29,400 --> 00:00:32,000\n目前codex插件的市场已经非常非常丰富了\n\n18\n00:00:32,000 --> 00:00:33,090\n有非常多的插件\n\n19\n00:00:33,090 --> 00:00:34,770\n这里呢为了给大家去演示啊\n\n20\n00:00:34,770 --> 00:00:36,950\n我们可以安装两个插件来做测试\n\n21\n00:00:36,950 --> 00:00:39,750\n安装一个比较常用的GITHUB和一个比较常用的GMAIL\n\n22\n00:00:39,750 --> 00:00:43,060\n当然有同学说老师这里为什么用谷歌的邮件呢\n\n23\n00:00:43,060 --> 00:00:43,980\n不用网易啊\n\n24\n00:00:43,980 --> 00:00:45,120\n或者其他的邮件呢\n\n25\n00:00:45,120 --> 00:00:48,660\n是因为其他邮件他们并没有去写这个插件是吧\n\n26\n00:00:48,660 --> 00:00:50,920\n目前邮件这只有GMAIL好\n\n27\n00:00:50,920 --> 00:00:52,510\n所以我们用GMAIL来做测试\n\n28\n00:00:52,510 --> 00:00:55,530\ncortex呢再去连接GITHUB和GMAIL的时候\n\n29\n00:00:55,530 --> 00:00:56,390\n需要进行授权\n\n30\n00:00:56,390 --> 00:00:57,530\n这个大家要注意啊\n\n31\n00:00:57,530 --> 00:00:58,110\n那这样吧\n\n32\n00:00:58,110 --> 00:00:59,839\n我们先给大家安装一下好\n\n33\n00:00:59,839 --> 00:01:02,219\n回到我们这边点击左侧的插件\n\n34\n00:01:02,219 --> 00:01:04,599\n然后大家可以看到下面有很多插件\n\n35\n00:01:04,599 --> 00:01:05,059\n对不对\n\n36\n00:01:05,059 --> 00:01:06,719\n我们找第一个是GITHUB\n\n37\n00:01:06,719 --> 00:01:08,699\n点击加号给他安装上\n\n38\n00:01:08,699 --> 00:01:10,380\n好进行安装\n\n39\n00:01:10,380 --> 00:01:12,420\n安装的可能要稍等一点点\n\n40\n00:01:12,420 --> 00:01:13,060\n注意啊\n\n41\n00:01:13,060 --> 00:01:14,100\n在安装的时候\n\n42\n00:01:14,100 --> 00:01:18,060\n他需要你授权用你的GITHUB账号去进行登录\n\n43\n00:01:18,060 --> 00:01:19,860\n授权就可以了\n\n44\n00:01:20,930 --> 00:01:23,130\nOK我这里呢已经安装完成了\n\n45\n00:01:23,130 --> 00:01:25,050\n但是我这个没有授权的过程\n\n46\n00:01:25,050 --> 00:01:27,340\n是因为我之前安装过授权了\n\n47\n00:01:27,340 --> 00:01:29,960\n你们只需要去用你的GITHUB账号去登录\n\n48\n00:01:29,960 --> 00:01:30,800\n授权就可以了\n\n49\n00:01:30,800 --> 00:01:32,120\n我们再往下去找一下\n\n50\n00:01:32,120 --> 00:01:33,680\n真没有\n\n51\n00:01:34,400 --> 00:01:36,240\n在这儿呢\n\n52\n00:01:36,640 --> 00:01:38,240\n这是谷歌邮箱GMAIL\n\n53\n00:01:38,240 --> 00:01:40,680\n然后我们等待安装额\n\n54\n00:01:40,680 --> 00:01:42,620\nGMAIL也是要有个授权的过程的啊\n\n55\n00:01:42,620 --> 00:01:43,440\n一样的好\n\n56\n00:01:43,440 --> 00:01:45,000\n我们等待安装\n\n57\n00:01:45,700 --> 00:01:47,260\nOK也已经安装成功\n\n58\n00:01:47,260 --> 00:01:50,660\n此时呢我们可以回到这边\n\n59\n00:01:50,660 --> 00:01:51,940\n回到对话这里啊\n\n60\n00:01:51,940 --> 00:01:53,710\n然后打一个斜杠\n\n61\n00:01:53,710 --> 00:01:55,170\n斜杠呢往下找\n\n62\n00:01:55,170 --> 00:01:56,670\n你可以找到GITHUB\n\n63\n00:01:56,670 --> 00:01:57,750\n我们看一眼啊\n\n64\n00:01:57,750 --> 00:01:59,130\n大家可以看到这里有个GITHUB\n\n65\n00:01:59,130 --> 00:02:00,560\n也有这个对吧\n\n66\n00:02:00,560 --> 00:02:02,480\n那这两个就说明我们就安装成功了\n\n67\n00:02:02,480 --> 00:02:03,540\n呃为了测试呢\n\n68\n00:02:03,540 --> 00:02:04,900\n我们可以先给大家一个场景\n\n69\n00:02:04,900 --> 00:02:05,660\n什么场景呢\n\n70\n00:02:05,660 --> 00:02:09,900\n就是我们将GITHUB每月关于AI项目增长\n\n71\n00:02:09,900 --> 00:02:11,800\nstar最多的前十的项目呢\n\n72\n00:02:11,800 --> 00:02:13,980\n通过GML邮件的方式发送给我们\n\n73\n00:02:13,980 --> 00:02:15,260\n所以大家可能很奇怪\n\n74\n00:02:15,260 --> 00:02:17,380\n说老师我上哪儿去获取信息\n\n75\n00:02:17,380 --> 00:02:20,860\n说当前哪些AI的项目增长是最好的\n\n76\n00:02:20,860 --> 00:02:23,680\n就是值得我们去花时间精力去看一看呢\n\n77\n00:02:23,680 --> 00:02:25,720\n那最大的平台不就是GITHUB吗\n\n78\n00:02:25,720 --> 00:02:27,100\n所以你去GITHUB去找啊\n\n79\n00:02:27,100 --> 00:02:28,580\n去找star前十的\n\n80\n00:02:28,580 --> 00:02:29,780\n如果你自己手动去找\n\n81\n00:02:29,780 --> 00:02:30,460\n会比较麻烦\n\n82\n00:02:30,460 --> 00:02:31,580\n如果让AI帮我们去找\n\n83\n00:02:31,580 --> 00:02:32,660\n是不是就方便很多了\n\n84\n00:02:32,660 --> 00:02:35,709\n所以这样我们复制这个文本啊\n\n85\n00:02:35,709 --> 00:02:37,829\n这里我们这么来写\n\n86\n00:02:37,829 --> 00:02:41,149\n首先呢先调用这个GITHUB\n\n87\n00:02:41,149 --> 00:02:42,329\n然后复制过来\n\n88\n00:02:42,329 --> 00:02:49,690\n将GITHUB美月关于AI项目大增长最多的前十项目\n\n89\n00:02:49,690 --> 00:02:56,620\n通过这里杠找到GMAIL好发送给我们\n\n90\n00:02:56,620 --> 00:03:00,200\n这个时候我们回车等待它去操作就行了\n\n91\n00:03:05,080 --> 00:03:07,040\nOK我们看一下它已经生成了\n\n92\n00:03:07,0