J6mqF2fka1mqx6gqj0eN0B599M=&uipk=5&nbs=1&platform=pc&gen=playurlv3&oi=1733154763&mid=3546568672151587&deadline=1780907596&trid=d4fd37298437411e81381d3ae665dd5u&os=akam&og=hw&upsig=193ff76e514ce3e6aba0367dd448cc34&uparams=e,uipk,nbs,platform,gen,oi,mid,deadline,trid,os,og&hdnts=exp=1780907596~hmac=b9efce84340cc81f61f8cde070ea6216d4dc711c3bae6e7bd10d736cf62a3138&bvc=vod&nettype=0&bw=202508&lrs=0&agrr=1&buvid=56CBBADE-6E37-C95A-FAC9-97160BE6D01C13885infoc&build=0&dl=0&f=u_0_0&qn_dyeid=3d891421bb2622d700ef01316a26622c&orderid=0,2", "ext": "mp4", "fps": 30.0, "width": 1802, "height": 1080, "vcodec": "av01.0.00M.10.0.110.01.01.01.0", "acodec": "none", "dynamic_range": "SDR", "tbr": 202.331, "quality": 80, "format_id": "100026", "format": "1080P 高清", "protocol": "https", "video_ext": "mp4", "audio_ext": "none", "abr": 0, "vbr": 202.331, "resolution": "1802x1080", "aspect_ratio": 1.67, "filesize_approx": 13262771, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/142.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.bilibili.com/video/BV1BVEs6LENZ?p=10"}}], "duration": 524.399, "subtitles": {"danmaku": [{"ext": "xml", "url": "https://comment.bilibili.com/38926288795.xml"}], "ai-zh": [{"ext": "srt", "data": "1\n00:00:01,020 --> 00:00:01,460\nHello\n\n2\n00:00:01,460 --> 00:00:02,560\n小伙伴们大家好\n\n3\n00:00:02,560 --> 00:00:06,320\n这节课呢我们来说一下codex的skills技能\n\n4\n00:00:06,320 --> 00:00:08,280\n关于skills的简介呢\n\n5\n00:00:08,280 --> 00:00:09,840\n我们这里就不多介绍了\n\n6\n00:00:09,840 --> 00:00:11,280\n因为在之前的一期课程当中\n\n7\n00:00:11,280 --> 00:00:13,480\n我们已经完整的介绍了agent的skills\n\n8\n00:00:13,480 --> 00:00:14,760\n从入门到实战\n\n9\n00:00:14,760 --> 00:00:17,120\n那本节课呢我们关于skills的基础知识啊\n\n10\n00:00:17,120 --> 00:00:18,160\n这里就不单独讲解了\n\n11\n00:00:18,160 --> 00:00:20,780\n有兴趣的去可以搜我们之前的视频\n\n12\n00:0