0eN0B599M=&og=hw&deadline=1780907582&platform=pc&os=akam&trid=7e0b2d8a584e4dcd88ae2698ccec63au&nbs=1&uipk=5&oi=1733154763&mid=3546568672151587&gen=playurlv3&upsig=7139cf231cf1064a84289971b78c9803&uparams=e,og,deadline,platform,os,trid,nbs,uipk,oi,mid,gen&hdnts=exp=1780907582~hmac=a5e217819877a94b2587de649f854d75e4b6e37794c20fbab1b07e3b63df4541&bvc=vod&nettype=0&bw=200904&lrs=0&agrr=1&buvid=56CBBADE-6E37-C95A-FAC9-97160BE6D01C13885infoc&build=0&dl=0&f=u_0_0&qn_dyeid=3eb1949a72ea5a8d001a32f46a26621e&orderid=0,2", "ext": "mp4", "fps": 30.0, "width": 1802, "height": 1080, "vcodec": "av01.0.08M.08.0.110.01.01.01.0", "acodec": "none", "dynamic_range": "SDR", "tbr": 200.486, "quality": 80, "format_id": "100026", "format": "1080P 高清", "protocol": "https", "video_ext": "mp4", "audio_ext": "none", "abr": 0, "vbr": 200.486, "resolution": "1802x1080", "aspect_ratio": 1.67, "filesize_approx": 10974227, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/142.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.bilibili.com/video/BV1BVEs6LENZ?p=8"}}], "duration": 437.905, "subtitles": {"danmaku": [{"ext": "xml", "url": "https://comment.bilibili.com/38926288109.xml"}], "ai-zh": [{"ext": "srt", "data": "1\n00:00:01,120 --> 00:00:01,560\nHello\n\n2\n00:00:01,560 --> 00:00:02,660\n小伙伴们大家好\n\n3\n00:00:02,660 --> 00:00:05,260\n这节课呢我们来说一下codex记忆系统\n\n4\n00:00:05,260 --> 00:00:06,740\n那什么是记忆系统呢\n\n5\n00:00:06,740 --> 00:00:08,080\n我们来看一个情景啊\n\n6\n00:00:08,080 --> 00:00:08,980\n大家就明白了\n\n7\n00:00:08,980 --> 00:00:10,740\n他说开启一个新的对话\n\n8\n00:00:10,740 --> 00:00:13,980\n就等于进入到了一个全新的上下文环境\n\n9\n00:00:13,980 --> 00:00:15,940\n那进入到了一个全新的上源环境\n\n10\n00:00:15,940 --> 00:00:16,980\n会有什么影响呢\n\n11\n00:00:16,980 --> 00:00:19,680\nAI啊会不记得之前发生了什么\n\n12\n00:00:19,680 --> 00:00:23,080\n甚至啊对整个项目的记忆啊都是空白的\n\n13\n00:00:23,080 --> 00:00:25,340\n那么当项目变得非常复杂以后啊\n\n14\n00:00:25,340 --> 00:00:29,120\n每次对话都需要给AI去提示一遍项目背景\n\n15\n00:00:29,120 --> 00:00:31,860\n或者你也可以让AI自己再去读一遍代码\n\n16\n00:00:31,860 --> 00:00:34,000\n但无论是重新给他提示项目背景\n\n17\n00:00:34,000 --> 00:00:34,400\n还是这样\n\n18\n00:00:34,400 --> 00:00:35,480\n得读一段段代码\n\n19\n00:00:35,480 --> 00:00:38,580\n这种这两种方式啊都是非常低效的工作方式\n\n20\n00:00:38,580 --> 00:00:40,560\n如果我们开启一个新的对话\n\n21\n00:00:40,560 --> 00:00:42,340\n他也能有之前的上下文记忆\n\n22\n00:00:42,340 --> 00:00:43,720\n那是无疑最好的了\n\n23\n00:00:43,720 --> 00:00:44,160\n对不对\n\n24\n00:00:44,160 --> 00:00:45,160\n能不能做到呢\n\n25\n00:00:45,160 --> 00:00:45,980\n当然是能的\n\n26\n00:00:45,980 --> 00:00:48,370\n那就是给codex增加记忆系统\n\n27\n00:00:48,370 --> 00:00:50,490\ncortex增加机器系统有两种方案\n\n28\n00:00:50,490 --> 00:00:51,990\n第一种叫通用方式\n\n29\n00:00:51,990 --> 00:00:55,130\n也就是说在当前项目的根目录去创建一个agents\n\n30\n00:00:55,130 --> 00:00:55,980\n点MB文件\n\n31\n00:00:55,980 --> 00:00:59,300\n在这个MD文件当中呢去给它添好项目的背景\n\n32\n00:00:59,300 --> 00:01:01,099\n或者是添好一些约束\n\n33\n00:01:01,099 --> 00:01:03,179\n第二种方式呢叫全局方式\n\n34\n00:01:03,179 --> 00:01:06,329\n全局方式呢就是在呃呃任何项目都生效\n\n35\n00:01:06,329 --> 00:01:08,689\n你这个通用方式只在当前项目中生效\n\n36\n00:01:08,689 --> 00:01:10,549\n因为它是在当前项目的根目中创建嘛\n\n37\n00:01:10,549 --> 00:01:12,569\n而全局方式是所有项目都生效的\n\n38\n00:01:12,569 --> 00:01:15,970\n可以存放一些你的个人的呃编码约束\n\n39\n00:01:15,970 --> 00:01:19,290\n那大家可以看一下cortex的设置里边有个个性化\n\n40\n00:01:19,290 --> 00:01:20,490\n个性化里面有个自定义指令\n\n41\n00:01:20,490 --> 00:01:23,100\n在这个指针自定义指令中去编写就可以了\n\n42\n00:01:23,100 --> 00:01:24,660\n那我们一种一种来介绍啊\n\n43\n00:01:24,660 --> 00:01:26,770\n先来说通用方式\n\n44\n00:01:26,770 --> 00:01:28,330\n我们在当前项目的根目录\n\n45\n00:01:28,330 --> 00:01:30,110\n去创建一个agents的MD文件\n\n46\n00:01:30,110 --> 00:01:31,360\n复制一下啊\n\n47\n00:01:31,360 --> 00:01:32,280\n来到这边\n\n48\n00:01:32,280 --> 00:01:34,930\n我们打开当前项目啊\n\n49\n00:01:35,250 --> 00:01:36,210\n这里关掉啊\n\n50\n00:01:36,210 --> 00:01:36,930\n这边也关掉\n\n51\n00:01:36,930 --> 00:01:38,290\n在当前项目的根目录\n\n52\n00:01:38,290 --> 00:01:39,490\n这就是它的根目录了\n\n53\n00:01:39,490 --> 00:01:41,550\n新建一个文件啊\n\n54\n00:01:41,550 --> 00:01:45,110\n然后复制一下这个agents点MD\n\n55\n00:01:45,110 --> 00:01:47,030\n注意这个agents要大写好吗\n\n56\n00:01:47,030 --> 00:01:48,010\nagents点MD\n\n57\n00:01:48,010 --> 00:01:48,710\n在这里呢\n\n58\n00:01:48,710 --> 00:01:49,430\n我们干嘛呢\n\n59\n00:01:49,430 --> 00:01:50,660\n来看文档啊\n\n60\n00:01:50,660 --> 00:01:53,440\n他说在这里去添加一些基本信息\n\n61\n00:01:53,440 --> 00:01:53,860\n注意啊\n\n62\n00:01:53,860 --> 00:01:56,460\n这个agency的MD只对当前项目生效\n\n63\n00:01:56,460 --> 00:01:57,220\n这我们已经说过了\n\n64\n00:01:57,220 --> 00:01:58,960\n比如说我们随便给他一个文本吧\n\n65\n00:01:58,960 --> 00:02:00,540\n啊我是红豆很懒\n\n66\n00:02:00,540 --> 00:02:01,920\n但是喜欢新技术好\n\n67\n00:02:01,920 --> 00:02:02,800\n这样就可以了\n\n68\n00:02:02,800 --> 00:02:03,280\n可以了\n\n69\n00:02:03,280 --> 00:02:03,820\n之后呢\n\n70\n00:02:03,820 --> 00:02:05,680\n我们可以回到codex这边\n\n71\n00:02:05,680 --> 00:02:07,080\n然后我们可以呃\n\n72\n00:02:07,080 --> 00:02:08,259\n这个就是新开对话框啊\n\n73\n00:02:08,259 --> 00:02:09,699\n你我们可以问他一句话\n\n74\n00:02:09,699 --> 00:02:10,240\n问他什么呢\n\n75\n00:02:10,240 --> 00:02:11,280\n比如说我是什么\n\n76\n00:02:11,280 --> 00:02:12,320\n我叫什么呃\n\n77\n00:02:12,320 --> 00:02:13,440\n有什么特点\n\n78\n00:02:14,910 --> 00:02:15,570\n注意啊\n\n79\n00:02:15,570 --> 00:02:16,670\n必须在当前项目\n\n80\n00:02:16,670 --> 00:02:19,570\n也就是在这个codex shop这个项目下去问啊\n\n81\n00:02:19,570 --> 00:02:21,520\n别的项目下是无效的啊\n\n82\n00:02:21,520 --> 00:02:22,720\n这里还有一个小问题\n\n83\n00:02:22,720 --> 00:02:25,280\n就是我们有时候在问这句话的时候\n\n84\n00:02:25,280 --> 00:02:28,360\n在这里的回复可能并没有能准确的回复你信息\n\n85\n00:02:28,360 --> 00:02:30,540\n你需要把当前的cortex关闭一下\n\n86\n00:02:30,540 --> 00:02:32,320\n再次打开之后就可以了\n\n87\n00:02:32,320 --> 00:02:34,440\n当然这个不是每次每个人都会发生\n\n88\n00:02:34,440 --> 00:02:35,600\n有的人会发生这个问题\n\n89\n00:02:35,600 --> 00:02:36,960\n有的人不会发生好\n\n90\n00:02:36,960 --> 00:02:38,840\n我们稍等片刻\n\n91\n00:02:42,120 --> 00:02:43,000\nOK我们看啊\n\n92\n00:02:43,000 --> 00:02:43,920\n他已经给出回复\n\n93\n00:02:43,920 --> 00:02