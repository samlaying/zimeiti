s=akam&platform=pc&nbs=1&og=cos&upsig=10476af40732a79b450384a99d7ea7fd&uparams=e,oi,uipk,trid,mid,deadline,gen,os,platform,nbs,og&hdnts=exp=1780726402~hmac=c06eaa980f6303287eb82654c3141decec4060a9f67319fb1a37260fd38edf3f&bvc=vod&nettype=0&bw=98383&lrs=0&f=u_0_0&qn_dyeid=25607784b32a4fdd00b5bb5c6a239e62&agrr=0&buvid=56CBBADE-6E37-C95A-FAC9-97160BE6D01C13885infoc&build=0&dl=0&orderid=0,2", "ext": "mp4", "fps": 30.0, "width": 1920, "height": 1080, "vcodec": "avc1.640033", "acodec": "none", "dynamic_range": "SDR", "tbr": 98.204, "quality": 80, "format_id": "30080", "format": "1080P 高清", "protocol": "https", "video_ext": "mp4", "audio_ext": "none", "abr": 0, "vbr": 98.204, "resolution": "1920x1080", "aspect_ratio": 1.78, "filesize_approx": 4057494, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/138.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.bilibili.com/video/BV1D5Gi6QEN7?p=43"}}], "duration": 330.536, "subtitles": {"danmaku": [{"ext": "xml", "url": "https://comment.bilibili.com/38553193262.xml"}], "ai-zh": [{"ext": "srt", "data": "1\n00:00:00,980 --> 00:00:01,860\n同学们大家好\n\n2\n00:00:01,860 --> 00:00:03,140\n我是你们泽文老师\n\n3\n00:00:03,140 --> 00:00:04,820\n这堂课我们来学习一下\n\n4\n00:00:04,820 --> 00:00:08,050\n如何利用AI工具去创作幽默段子\n\n5\n00:00:08,050 --> 00:00:09,530\n你有没有这种感觉\n\n6\n00:00:09,530 --> 00:00:13,210\n就是打开手机以后铺天盖地的这种AI写段子\n\n7\n00:00:13,210 --> 00:00:14,690\nAI生成短句\n\n8\n00:00:14,690 --> 00:00:16,410\n结果点进去一看啊\n\n9\n00:00:16,410 --> 00:00:19,910\n感觉还不还不如楼下大爷的那种讲的冷笑话\n\n10\n00:00:19,910 --> 00:00:21,570\n要么就是尬的飞起\n\n11\n00:00:21,570 --> 00:00:23,870\n要么就是笑点太教科书了\n\n12\n00:00:23,870 --> 00:00:26,270\n要么干脆呢就像在背范文\n\n13\n00:00:26,270 --> 00:00:27,470\n你可能会心想\n\n14\n00:00:27,470 --> 00:00:29,510\n这种AI不会写段子\n\n15\n00:00:29,510 --> 00:00:30,720\n他没有幽默感\n\n16\n00:00:30,720 --> 00:00:33,980\n其实呢真相是这个AI不是不会写\n\n17\n00:00:33,980 --> 00:00:37,030\n而是你不会叫他写的像人话一样\n\n18\n00:00:37,030 --> 00:00:38,510\n咱们今天这堂课\n\n19\n00:00:38,510 --> 00:00:42,150\n我就带你用一套非AI签的这样一个段子\n\n20\n00:00:42,150 --> 00:00:43,600\n去生成一个结构\n\n21\n00:00:43,600 --> 00:00:47,269\n那么做出能够笑出声的这种幽默的文案\n\n22\n00:00:47,269 --> 00:00:49,369\n不管你是想要发微博也好\n\n23\n00:00:49,369 --> 00:00:50,569\n做段子号也好\n\n24\n00:00:50,569 --> 00:00:52,409\n还是拍短剧脚本也好\n\n25\n00:00:52,409 --> 00:00:53,690\n通通都能用\n\n26\n00:00:53,690 --> 00:00:55,750\n那么首先呢我们来看一下\n\n27\n00:00:55,750 --> 00:00:58,290\n像这样的一个写段子的方式\n\n28\n00:00:58,290 --> 00:01:00,430\n应该用什么样的结构\n\n29\n00:01:00,430 --> 00:01:02,830\n我们说AI这个段子啊\n\n30\n00:01:02,830 --> 00:01:03,910\n如果要写的话\n\n31\n00:01:03,910 --> 00:01:06,460\n它有五大黄金结构公式\n\n32\n00:01:06,460 --> 00:01:08,320\nAI的这种幽默能力呢\n\n33\n00:01:08,320 --> 00:01:12,470\n其实是靠的你给他的一种节奏感情境感\n\n34\n00:01:12,470 --> 00:01:13,410\n人设感\n\n35\n00:01:13,410 --> 00:01:15,530\n情绪的反差以及反转点\n\n36\n00:01:15,530 --> 00:01:16,650\n这么五个点\n\n37\n00:01:16,650 --> 00:01:20,410\n咱们通过这五个点可以总结出来一种\n\n38\n00:01:20,410 --> 00:01:23,580\n有五种常见的这种段子的结构\n\n39\n00:01:23,580 --> 00:01:26,180\n第一种就是生活冷知识\n\n40\n00:01:26,180 --> 00:01:29,590\n然后加上意外意料之外的一种反应\n\n41\n00:01:29,590 --> 00:01:33,230\n比如说啊下面这一段话就是生活小技巧啊\n\n42\n00:01:33,230 --> 00:01:35,310\n用指甲盖去掐一下手心\n\n43\n00:01:35,310 --> 00:01:38,160\n是可以缓解想买东西的冲动的\n\n44\n00:01:38,160 --> 00:01:40,120\n那有的人就会说我试了\n\n45\n00:01:40,120 --> 00:01:42,840\n结果买了更贵的东西安慰自己哈\n\n46\n00:01:42,840 --> 00:01:45,060\n这就是一个意料之外的反应\n\n47\n00:01:45,060 --> 00:01:48,940\n第二个呢就是错位类比加上自嘲啊\n\n48\n00:01:48,940 --> 00:01:50,500\n像情感就是感情\n\n49\n00:01:50,500 --> 00:01:52,810\n像呃U盘插电脑\n\n50\n00:01:52,810 --> 00:01:55,350\n结果呢插了十几次才对得上\n\n51\n00:01:55,350 --> 00:01:56,590\n终于插上了吧\n\n52\n00:01:56,590 --> 00:01:58,770\n结果设备未识别哈\n\n53\n00:01:58,770 --> 00:02:00,630\n这就是一种自嘲\n\n54\n00:02:00,630 --> 00:02:03,470\n第三个呢就是我朋友这样一个结构\n\n55\n00:02:03,470 --> 00:02:05,470\n我朋友当然是加引号的啊\n\n56\n00:02:05,470 --> 00:02:09,669\n那可以写就我朋友今天就是昨天心情很差\n\n57\n00:02:09,669 --> 00:02:11,150\n疯狂的吃夜宵\n\n58\n00:02:11,150 --> 00:02:13,040\n刷剧骂前男友\n\n59\n00:02:13,040 --> 00:02:18,160\n他呢是一枚是一个非常合格的减肥失败者啊\n\n60\n00:02:18,160 --> 00:02:20,200\n所以你看我朋友是吧\n\n61\n00:02:20,200 --> 00:02:21,860\n他是个减肥的失败者\n\n62\n00:02:21,860 --> 00:02:25,850\n前面的这些和最后的这个啊是能够联系得上吗\n\n63\n00:02:25,850 --> 00:02:29,520\n好然后还有一个就是反应过度加反转呃\n\n64\n00:02:29,520 --> 00:02:31,860\n早上挤地铁挤得我差点报警\n\n65\n00:02:31,860 --> 00:02:34,120\n因为有人踩了我新买的鞋\n\n66\n00:02:34,120 --> 00:02:36,240\n而我刚分期还款啊\n\n67\n00:02:36,240 --> 00:02:37,240\n这是一种反转\n\n68\n00:02:37,240 --> 00:02:40,160\n也就是说他前面说的这个报警没有想到\n\n69\n00:02:40,160 --> 00:02:42,300\n其实是因为踩了他新买的鞋\n\n70\n00:02:42,300 --> 00:02:45,310\n最后一个就是冷笑话的升级版\n\n71\n00:02:45,310 --> 00:02:47,430\n我问AI你有情绪吗\n\n72\n00:02:47,430 --> 00:02:51,670\n他说我只会在服务器过热的时候热情似火哈\n\n73\n00:02:51,670 --> 00:02:53,860\n这是一种冷笑话好\n\n74\n00:02:53,860 --> 00:02:58,340\n那我们接下来呢用一个实践的案例去看一看\n\n75\n00:02:58,340 --> 00:03:00,769\n像这样的段子究竟应该怎么写\n\n76\n00:03:00,769 --> 00:03:05,100\n我们把这样一段提示词复制粘贴给DP sic\n\n77\n00:03:05,260 --> 00:03:06,920\n可以看到他写的是\n\n78\n00:03:06,920 --> 00:03:09,620\n请以25~35岁城市打工人\n\n79\n00:03:09,620 --> 00:03:10,640\n第一人称\n\n80\n00:03:10,640 --> 00:03:12,760\n模仿微博段子手风格\n\n81\n00:03:12,760 --> 00:03:16,420\n去写一个150字以内的原创的幽默段子\n\n82\n00:03:16,420 --> 00:03:19,380\n内容结构需要包括以下四点\n\n83\n00:03:19,380 --> 00:03:21,740\n第一个呢就是日常生活的切片\n\n84\n00:03:21,740 --> 00:03:23,160\n要有情境感\n\n85\n00:03:23,160 --> 00:03:26,800\n第二个就是意外反应或者是反差\n\n86\n00:03:26,800 --> 00:03:27,780\n要有笑点\n\n87\n00:03:27,780 --> 00:03:31,680\n第三个最后一行要带一句适合被转发的京剧\n\n88\n00:03:31,680 --> 00:03:33,810\n第四个要禁用AI签\n\n89\n00:03:33,810 --> 00:03:34,510\n不能写\n\n90\n00:03:34,510 --> 00:03:35,530\n像什么赋能啊\n\n91\n00:03:35,530 --> 00:03:36,050\n创新啊\n\n92\n00:03:36,050 --> 00:03:37,130\n解决痛点等等\n\n93\n00:03:37,130 --> 00:03:39,270\n像这样的词语好\n\n94\n00:03:39,270 --> 00:03:40,510\n我们一起来看一看\n\n95\n00:03:40,510 --> 00:03:42,390\n像这样的一个模板\n\n96\n00:03:42,390 --> 00:03:45,230\n他会给我们一个什么样的答案\n\n97\n00:03:56,560 --> 00:03:58,080\n好我们可以看一下啊\n\n98\n00:03:58,080 --> 00:04:01,940\n他写的是职场水豚工位摸鱼的时候\n\n99\n00:04:01,940 --> 00:04:03,930\n突然被领导cue到\n\n100\n00:04:03,930 --> 00:04:05,910\n手忙脚乱关掉了淘宝\n\n101\n00:04:05,910 --> 00:04:09,350\n结果把年终述职的PPT也给查了\n\n102\n00:04:09,350 --> 00:04:13,579\n屏幕上赫然弹出了昨晚熬夜写的周报的标题\n\n103\n00:04:13,579 --> 00:04:15,499\n如何避免成为团队\n\n104\n00:04:15,499 --> 00:04:16,079\n等一下\n\n105\n00:04:16,079 --> 00:04:17,939\n现在后面没有生成啊\n\n106\n00:04:17,939 --> 00:04:20,139\n我们重新刷新一下\n\n107\n00:04:21,000 --> 00:04:22,300\n有他换了一个\n\n108\n00:04:22,300 --> 00:04:24,560\n那我们看看新的这个吧\n\n109\n00:04:25,420 --> 00:04:26,880\n好可以看一下啊\n\n110\n00:04:26,880 --> 00:04:29,040\n他写的是职场水逆蹲坑\n\n111\n00:04:29,040 --> 00:04:30,870\n刷到老板的朋友圈\n\n112\n00:04:30,870 --> 00:04:33,070\n周末团建自愿报名\n\n113\n00:04:33,070 --> 00:04:34,270\n手滑点了个赞\n\n114\n00:04:34,270 --> 00:04:36,390\n瞬间弹出了三条私聊\n\n115\n00:04:36,390 --> 00:04:37,930\n还是你觉悟高啊\n\n116\n00:04:37,930 --> 00:04:39,960\n这是他的同事在讽刺他\n\n117\n00:04:39,960 --> 00:04:42,080\n那周六七点呃\n\n118\n00:04:42,080 --> 00:04:44,340\n七点公司集合记得带登山杖\n\n119\n00:04:44,340 --> 00:04:46,400\n我盯着马桶里打转的屎\n\n120\n00:04:46,400 --> 00:04:49,840\n终于懂了什么叫做一失足成千古恨\n\n121\n00:04:49,840 --> 00:04:50,840\n京剧是什么呢\n\n122\n00:04:50,840 --> 00:04:53,660\n就是成年人的崩溃都是从手贱开始的\n\n123\n00:04:53,660 --> 00:04:54,660\n转发这条\n\n124\n00:04:54,660 --> 00:04:58,050\n明天你的赞就会精准的屏蔽领导是吧\n\n125\n00:04:58,050 --> 00:04:59,010\n可以看到啊\n\n126\n00:04:59,010 --> 00:05:00,410\n像这种职场水逆\n\n127\n00:05:00,410 --> 00:05:02,050\n我们平时打工人的时候\n\n128\n00:05:02,050 --> 00:05:05,539\n很有可能会出现这样的乌龙事件啊\n\n129\n00:05:05,539 --> 00:05:07,599\n这就是一个很有趣的\n\n130\n00:05:07,599 --> 00:05:09,439\n像这种就同一个模板\n\n131\n00:05:09,439 --> 00:05:10,619\n你点一次刷新\n\n132\n00:05:10,619 --> 00:05:12,499\n它给你的答案都是不一样的\n\n133\n00:05:12,499 --> 00:05:14,980\n那也就是说这样的小段子\n\n134\n00:05:14,980 --> 00:05:17,520\n我们是不是可以经常的去发微博\n\n135\n00:05:17,520 --> 00:05:19,740\n或者是呃发小红书等等\n\n136\n00:05:19,740 --> 00:05:21,910\n像这样的社交媒体好\n\n137\n00:05:21,910 --> 00:05:26,270\n那么以上呢就是如何利用AI工具去创作\n\n138\n00:05:26,270 --> 00:05:27,750\n幽默的段子的方法\n\n139\n00:05:27,750 --> 00:05:29,460\n咱们大家学会了吗\n\n"}]}, "webpage_url": "https://www.bilibili.com/video/BV1D5Gi6QEN7?p=43", "webpage_url_basename": "BV1D5Gi6QEN7", "webpage_url_domain": "bilibili.com", "extractor": "BiliBili", "extractor_key": "BiliBili", "playlist_count": 82, "playlist": "【AI零基础入门】清华大佬终于讲完了AIGC全套教程变现课！含AI广告制作+AI绘画+视频视听语言全流程！全程干货无废话，学完即可副业变现！", "playlist_id": "BV1D5Gi6QEN7", "playlist_title": "【AI零基础入门】清华大佬终于讲完了AIGC全套教程变现课！含AI广告制作+AI绘画+视频视听语言全流程！全程干货无废话，学完即可副业变现！", "playlist_webpage_url": "https://www.bilibili.com/video/BV1D5Gi6QEN7/", "n_entries": 64, "playlist_index": 43, "thumbnails": [{"url": "http://i2.hdslb.com/bfs/archive/ddf2b57576483ae9189affdcd82a8353a0b54e86.jpg", "id": "0"}], "display_id": "BV1D5Gi6QEN7_p43", "fulltitle": "【AI零基础入门】清华大佬终于讲完了AIGC全套教程变现课！含AI广告制作+AI绘画+视频视听语言全流程！全程干货无废话，学完即可副业变现！", "duration_string": "5:30", "upload_date": "20260523", "epoch": 1780719224, "format": "1080P 高清+30280 - audio only", "format_id": "30080+30280", "ext": "mp4", "protocol": "https+https", "filesize_approx": 7676491, "tbr": 185.795, "width": 1920, "height": 1080, "resolution": "1920x1080", "fps": 30.0, "dynamic_range": "SDR", "vcodec": "avc1.640033", "vbr": 98.204, "aspect_ratio": 1.78, "acodec": "mp4a.40.2", "abr": 87.591, "_type": "video", "_version": {"version": "2026.03.17", "release_git_head": "04d6974f502bbdfaed72c624344f262e30ad9708", "repository": "yt-dlp/yt-dlp"}}