 1920, "height": 1080, "vcodec": "avc1.640033", "acodec": "none", "dynamic_range": "SDR", "tbr": 320.691, "quality": 80, "format_id": "30080", "format": "1080P 高清", "protocol": "https", "video_ext": "mp4", "audio_ext": "none", "abr": 0, "vbr": 320.691, "resolution": "1920x1080", "aspect_ratio": 1.78, "filesize_approx": 21175787, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/141.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.bilibili.com/video/BV1D5Gi6QEN7?p=14"}}], "duration": 528.254, "subtitles": {"danmaku": [{"ext": "xml", "url": "https://comment.bilibili.com/38552800769.xml"}], "ai-zh": [{"ext": "srt", "data": "1\n00:00:00,940 --> 00:00:01,860\n同学们大家好\n\n2\n00:00:01,860 --> 00:00:03,240\n我是你们的子文老师\n\n3\n00:00:03,240 --> 00:00:05,600\n那么这堂课呢我们来学习一下\n\n4\n00:00:05,600 --> 00:00:09,930\n如何利用AI工具去设计一个定制服装的图案\n\n5\n00:00:09,930 --> 00:00:12,330\n现在如果有一个叫做绿色\n\n6\n00:00:12,330 --> 00:00:14,950\n未来的可持续发展的运动品牌\n\n7\n00:00:14,950 --> 00:00:17,410\n他想要推出一个自然融合系列\n\n8\n00:00:17,410 --> 00:00:20,050\n那么这个系列呢需要将自然元素\n\n9\n00:00:20,050 --> 00:00:21,570\n比如说像海洋\n\n10\n00:00:21,570 --> 00:00:25,650\n森林山脉等等融入到运动服装的设计中\n\n11\n00:00:25,650 --> 00:00:28,070\n既要体现现代环保的理念\n\n12\n00:00:28,070 --> 00:00:29,650\n又要保持时尚感\n\n13\n00:00:29,650 --> 00:00:31,510\n品牌希望通过MAD journey\n\n14\n00:00:31,510 --> 00:00:33,570\n去生成一个概念的设计图\n\n15\n00:00:33,570 --> 00:00:35,430\n为设计师提供灵感\n\n16\n00:00:35,430 --> 00:00:37,970\n那么这个时候我们怎么办呢\n\n17\n00:00:37,970 --> 00:00:41,810\n呃我们可以首先先借用一下deep sick这个工具\n\n18\n00:00:41,810 --> 00:00:42,410\n然后呢\n\n19\n00:00:42,410 --> 00:00:46,380\n让他去给我们出一套MJ的提示词的方案\n\n20\n00:00:46,380 --> 00:00:48,080\n然后再到MAD journey\n\n21\n00:00:48,080 --> 00:00:50,720\n也就是MJ这个工具里面去出图\n\n22\n00:00:50,720 --> 00:00:52,180\n好我们来看一看\n\n23\n00:00:52,180 --> 00:00:56,720\n首先我们如何利用deep sick去进行提问\n\n24\n00:01:04,339 --> 00:01:06,619\n我们把提示词复制一下\n\n25\n00:01:07,619 --> 00:01:11,739\n现有一个在这里面写现在的线\n\n26\n00:01:13,340 --> 00:01:16,660\n现有一个名为绿色未来的可持续发展的品牌\n\n27\n00:01:16,660 --> 00:01:19,470\n想要推出一个自然融合系列\n\n28\n00:01:19,470 --> 00:01:22,910\n那么这个系列它就有自然元素是海洋\n\n29\n00:01:22,910 --> 00:01:26,350\n森林和山脉融入到服装设计中啊等等等等\n\n30\n00:01:26,350 --> 00:01:30,690\n然后最后呢要说需要你为我提供三套灵感方案\n\n31\n00:01:30,690 --> 00:01:33,020\n和配套的MJ的提示词\n\n32\n00:01:33,020 --> 00:01:36,640\n那么在这里我们可以发现对它的限定几乎没有\n\n33\n00:01:36,640 --> 00:01:40,150\n因为我们现在想要的是一个概念设计图\n\n34\n00:01:40,150 --> 00:01:42,030\n那么既然是概念设计图的话\n\n35\n00:01:42,030 --> 00:01:44,990\n在这里面就可以充分的去发挥AI工具\n\n36\n00:01:44,990 --> 00:01:47,390\n它自己本身的这种能动性啊\n\n37\n00:01:47,390 --> 00:01:50,990\n那么让他去给我们提供一个非常好的这种想法\n\n38\n00:01:50,990 --> 00:01:52,150\n所以呢在这里面\n\n39\n00:01:52,150 --> 00:01:54,590\n我们不需要其他的一些个限制啊\n\n40\n00:01:54,590 --> 00:01:56,780\n就直接让它出提示词就可以了\n\n41\n00:01:56,780 --> 00:01:58,220\n我们可以看看一下\n\n42\n00:01:58,220 --> 00:02:01,580\n这个deep sc给我们一个什么样的好的方法\n\n43\n00:02:04,060 --> 00:02:05,000\n有网络异常\n\n44\n00:02:05,000 --> 00:02:06,180\n我们就直接点击一下\n\n45\n00:02:06,180 --> 00:02:07,740\n重新生成\n\n46\n00:02:16,660 --> 00:02:18,380\nOK他现在已经出来了\n\n47\n00:02:18,380 --> 00:02:20,920\n第一个方案就是海洋律动系列\n\n48\n00:02:20,920 --> 00:02:22,920\n那么在这里面的话呢\n\n49\n00:02:22,920 --> 00:02:26,120\n它有呃列出来的这个设计灵感是什么啊\n\n50\n00:02:26,120 --> 00:02:28,310\n以及下面的这个提示词\n\n51\n00:02:28,310 --> 00:02:33,210\n然后接下来第二个是森森林呼吸系列的好\n\n52\n00:02:33,210 --> 00:02:36,510\n第三个是扇贝光影系列的\n\n53\n00:02:40,040 --> 00:02:42,880\nOK那么我们先来看第一个哈\n\n54\n00:02:42,880 --> 00:02:44,380\n这个海洋律动系列\n\n55\n00:02:44,380 --> 00:02:47,480\n它里面的话呢是呃有颜色渐变\n\n56\n00:02:47,480 --> 00:02:49,640\n是深蓝到浅水海呃\n\n57\n00:02:49,640 --> 00:02:50,800\n海海水绿\n\n58\n00:02:50,800 --> 00:02:54,470\n然后呢搭配珍珠反白的光条等等哈\n\n59\n00:02:54,470 --> 00:02:59,270\n那它的纹理是模仿海浪的这种激光压胶的工艺\n\n60\n00:02:59,270 --> 00:03:00,700\n还有一些个细节\n\n61\n00:03:00,700 --> 00:03:03,800\n那么我们来看一看它的这一套提示词\n\n62\n00:03:03,800 --> 00:03:05,720\n生成的效果是什么样\n\n63\n00:03:05,720 --> 00:03:07,400\n我们来到DISCCOT社区\n\n64\n00:03:07,400 --> 00:03:13,350\n然后呢在这里面去找一个呃输入栏\n\n65\n00:03:14,099 --> 00:03:17,459\n然后来一个wait journey的大模型\n\n66\n00:03:17,459 --> 00:03:18,259\nCTRLV粘贴\n\n67\n00:03:19,419 --> 00:03:21,419\n然后回车确定\n\n68\n00:03:32,620 --> 00:03:34,020\n好我们来看一下啊\n\n69\n00:03:34,020 --> 00:03:36,520\n这是他给我们的第一个灵感\n\n70\n00:03:36,520 --> 00:03:38,780\n就是来源于海洋的\n\n71\n00:03:38,780 --> 00:03:41,740\n那它有各种的这种呃蓝颜色\n\n72\n00:03:41,740 --> 00:03:43,340\n青色的这种渐变\n\n73\n00:03:43,340 --> 00:03:47,250\n然后呢它还有一些呃波浪的这种感觉\n\n74\n00:03:47,250 --> 00:03:51,130\n你看这种纹理还是很美的是吧\n\n75\n00:03:51,130 --> 00:03:51,690\n还是很美的\n\n76\n00:03:51,690 --> 00:03:55,100\n而且呢它已经穿在这个模特的身上了\n\n77\n00:03:55,100 --> 00:03:58,420\n并且他的整个环境就是在海边呃\n\n78\n00:03:58,420 --> 00:04:00,240\n他给我们的这样的一个灵感\n\n79\n00:04:00,240 --> 00:04:03,120\n像这个嗯这个还是非常漂亮的是吧\n\n80\n00:04:03,120 --> 00:04:06,279\n哎好那么这是我们的第一套灵感\n\n81\n00:04:06,279 --> 00:04:08,799\n当然这一套灵感我们可以重复出图\n\n82\n00:04:08,799 --> 00:04:11,230\n可以点击一下这个蓝色的小按钮\n\n83\n00:04:11,230 --> 00:04:14,690\n然后呢他就按照刚才我们第一段这个提示词\n\n84\n00:04:14,690 --> 00:04:16,790\n重新再来一套\n\n85\n00:04:21,220 --> 00:04:23,340\n好点击下提交\n\n86\n00:04:34,280 --> 00:04:35,380\n好我们来看一下\n\n87\n00:04:35,380 --> 00:04:38,740\n这是第二套放大一点图啊\n\n88\n00:04:38,740 --> 00:04:39,900\n非常漂亮的啊\n\n89\n00:04:39,900 --> 00:04:41,060\n像这种层层叠叠\n\n90\n00:04:41,060 --> 00:04:43,540\n像海浪波纹那样这种感觉\n\n91\n00:04:43,540 --> 00:04:45,300\n而且呢它的这种配色的话\n\n92\n00:04:45,300 --> 00:04:47,240\n显得也非常的高级对吧\n\n93\n00:04:47,240 --> 00:04:49,340\n呃这就是我们的第一套啊\n\n94\n00:04:49,340 --> 00:04:50,900\n然后接下来我们看看第二套\n\n95\n00:04:50,900 --> 00:04:53,179\n这是森林呼吸系列的\n\n96\n00:04:53,179 --> 00:04:57,160\n那么它里面的一些个视觉元素呢是有苔藓的\n\n97\n00:04:57,160 --> 00:04:57,880\n绿色树\n\n98\n00:04:57,880 --> 00:04:59,320\n树皮的棕色\n\n99\n00:04:59,320 --> 00:05:01,960\n然后还有就是呃棉花\n\n100\n00:05:01,960 --> 00:05:03,690\n还有桉树的纤维\n\n101\n00:05:03,690 --> 00:05:05,270\n还有像防水涂层\n\n102\n00:05:05,270 --> 00:05:07,370\n树皮纹理的防水涂层啊\n\n103\n00:05:07,370 --> 00:05:09,390\n还有一些不对称的拼接设计\n\n104\n00:05:09,390 --> 00:05:11,410\n我们来看一下效果\n\n105\n00:05:21,580 --> 00:05:22,900\nOK我们来看一下啊\n\n106\n00:05:22,900 --> 00:05:25,400\n这是第二套森林系列\n\n107\n00:05:25,400 --> 00:05:28,840\n那么这一套的话配色是完全改变了对吧\n\n108\n00:05:28,840 --> 00:05:31,450\n那么它是呃要这种树林\n\n109\n00:05:31,450 --> 00:05:32,690\n那竹林对吧\n\n110\n00:05:32,690 --> 00:05:35,290\n还有土地岩石这种感觉的\n\n111\n00:05:35,290 --> 00:05:38,600\n那它的颜色呢相对来说是比较厚重\n\n112\n00:05:38,600 --> 00:05:39,480\n比较适合\n\n113\n00:05:39,480 --> 00:05:42,720\n给我感觉还比较适合秋冬的这种感觉是吧\n\n114\n00:05:42,720 --> 00:05:44,520\n哎这是属于第二套\n\n115\n00:05:44,520 --> 00:05:49,140\n那么咱们再来看一下第三套山脉的\n\n116\n00:06:07,400 --> 00:06:08,360\n程序没响应\n\n117\n00:06:08,360 --> 00:06:10,160\n我们重新来一遍\n\n118\n00:06:17,660 --> 00:06:19,100\n好我们来看一下啊\n\n119\n00:06:19,100 --> 00:06:20,960\n这是第三套呃\n\n120\n00:06:20,960 --> 00:06:22,260\n现在没有完全加载\n\n121\n00:06:23,380 --> 00:06:25,500\nOK那像这一套的话呢\n\n122\n00:06:25,500 --> 00:06:26,840\n它的整个呃\n\n123\n00:06:26,840 --> 00:06:31,100\n就是感觉颜色上就会比较深沉和更加厚重一些\n\n124\n00:06:31,100 --> 00:06:34,840\n那他整个的这个模特的所在的这个场景\n\n125\n00:06:34,840 --> 00:06:37,180\n也会换到了山上是吧\n\n126\n00:06:37,180 --> 00:06:38,840\n哎有岩石一看呢\n\n127\n00:06:38,840 --> 00:06:42,539\n就是比较呃这种冬天的这种氛围啊\n\n128\n00:06:42,539 --> 00:06:45,799\n那么户外运动就是冲锋衣啊\n\n129\n00:06:45,799 --> 00:06:47,060\n像这样的感觉\n\n130\n00:06:47,060 --> 00:06:50,280\n那么像像这样的这些个感觉的话\n\n131\n00:06:50,280 --> 00:06:54,020\n我们全都是可以重新再去进行生成的\n\n132\n00:06:54,020 --> 00:06:57,200\n用这种方式去得到一些个概念图\n\n133\n00:06:57,200 --> 00:06:59,000\n那么这些个概念图的话呢\n\n134\n00:06:59,000 --> 00:07:02,900\n是呃可以很好的给我们设计师去提供灵感的\n\n135\n00:07:02,900 --> 00:07:07,900\n这也是我们AI工具它的一个特别优秀的地方啊\n\n136\n00:07:07,900 --> 00:07:10,120\n那么他去做概念图这件事\n\n137\n00:07:10,120 --> 00:07:10,860\n提供灵感\n\n138\n00:07:10,860 --> 00:07:13,130\n这件事是非常擅长的\n\n139\n00:07:13,130 --> 00:07:17,690\n我们再来看看第二轮给我们的是什么样\n\n140\n00:07:19,720 --> 00:07:22,640\n好你看哎同样是冬装对吧\n\n141\n00:07:22,640 --> 00: