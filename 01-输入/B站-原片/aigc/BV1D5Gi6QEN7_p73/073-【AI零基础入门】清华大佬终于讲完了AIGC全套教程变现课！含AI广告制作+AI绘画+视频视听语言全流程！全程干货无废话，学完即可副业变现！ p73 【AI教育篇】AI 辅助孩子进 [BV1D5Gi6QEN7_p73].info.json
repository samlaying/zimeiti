deo_ext": "mp4", "audio_ext": "none", "abr": 0, "vbr": 139.768, "resolution": "1920x1080", "aspect_ratio": 1.78, "filesize_approx": 4856745, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/138.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.bilibili.com/video/BV1D5Gi6QEN7?p=73"}}], "duration": 277.989, "subtitles": {"danmaku": [{"ext": "xml", "url": "https://comment.bilibili.com/38553455110.xml"}], "ai-zh": [{"ext": "srt", "data": "1\n00:00:01,020 --> 00:00:01,900\n同学们大家好\n\n2\n00:00:01,900 --> 00:00:03,180\n我是你们的子文老师\n\n3\n00:00:03,180 --> 00:00:04,840\n这堂课我们来学习一下\n\n4\n00:00:04,840 --> 00:00:09,520\n如何利用AI工具辅助孩子进行体育锻炼的指导\n\n5\n00:00:09,520 --> 00:00:10,920\n你有没有这种感觉\n\n6\n00:00:10,920 --> 00:00:13,360\n就是每次孩子跑两步就喘\n\n7\n00:00:13,360 --> 00:00:15,030\n跳几下呢就喊累\n\n8\n00:00:15,030 --> 00:00:17,050\n家长急着想要直冲上去\n\n9\n00:00:17,050 --> 00:00:17,790\n教他怎么练\n\n10\n00:00:17,790 --> 00:00:18,710\n但是一开口\n\n11\n00:00:18,710 --> 00:00:20,150\n孩子直接就摆烂了\n\n12\n00:00:20,150 --> 00:00:20,670\n不练了\n\n13\n00:00:20,670 --> 00:00:21,570\n不喜欢\n\n14\n00:00:21,570 --> 00:00:24,390\n其实大多数的家长都忽略了一件事儿\n\n15\n00:00:24,390 --> 00:00:26,610\n就是体育锻炼不是靠管的\n\n16\n00:00:26,610 --> 00:00:27,590\n而是靠引\n\n17\n00:00:27,590 --> 00:00:29,710\n我们在用AI教孩子画画\n\n18\n00:00:29,710 --> 00:00:30,510\n学编程\n\n19\n00:00:30,510 --> 00:00:31,770\n学英语的时候\n\n20\n00:00:31,770 --> 00:00:33,570\n发现他像一个小助手\n\n21\n00:00:33,570 --> 00:00:34,950\n温柔专注\n\n22\n00:00:34,950 --> 00:00:35,950\n没有压力\n\n23\n00:00:35,950 --> 00:00:37,550\n但是呢一提到锻炼\n\n24\n00:00:37,550 --> 00:00:39,770\n很多人就会觉得只能是靠端\n\n25\n00:00:39,770 --> 00:00:40,590\n靠监督\n\n26\n00:00:40,590 --> 00:00:41,480\n靠喊\n\n27\n00:00:41,480 --> 00:00:45,740\n现在的AI其实已经可以变成一个不会催不捞的\n\n28\n00:00:45,740 --> 00:00:48,360\n还能陪着玩的一个运动搭子\n\n29\n00:00:48,360 --> 00:00:50,930\n尤其是对那些注意力弱\n\n30\n00:00:50,930 --> 00:00:52,210\n缺乏坚持力\n\n31\n00:00:52,210 --> 00:00:54,410\n抗拒枯燥训练的孩子来说\n\n32\n00:00:54,410 --> 00:00:59,290\nAI的互动能力反而是一种润物细无声的教育场\n\n33\n00:00:59,290 --> 00:01:03,490\n我们要做的是让AI不再只会提醒动一动\n\n34\n00:01:03,490 --> 00:01:05,489\n而是真正能够懂孩子\n\n35\n00:01:05,489 --> 00:01:06,430\n陪孩子\n\n36\n00:01:06,430 --> 00:01:08,250\n引导孩子动得开心\n\n37\n00:01:08,250 --> 00:01:09,479\n练得科学\n\n38\n00:01:09,479 --> 00:01:12,059\n那么在这里面呢有一个专业的原理\n\n39\n00:01:12,059 --> 00:01:14,130\n就是所谓的运动计划\n\n40\n00:01:14,130 --> 00:01:17,610\n它是等于游戏机制加上功能目标\n\n41\n00:01:17,610 --> 00:01:19,420\n加上个性反馈\n\n42\n00:01:19,420 --> 00:01:23,120\n所谓的游戏机制就是能不能像打卡一样的有趣\n\n43\n00:01:23,120 --> 00:01:25,810\n像闯关一样的成就感满满\n\n44\n00:01:25,810 --> 00:01:29,730\n那功能目标呢就是具体到提心核心力量\n\n45\n00:01:29,730 --> 00:01:33,000\n还是要改善协调性这样的一个目标\n\n46\n00:01:33,000 --> 00:01:37,860\n那个性反馈呢就是根据孩子的性格兴趣\n\n47\n00:01:37,860 --> 00:01:39,260\n专注的时长\n\n48\n00:01:39,260 --> 00:01:42,220\n调节节奏和奖励的方法\n\n49\n00:01:42,220 --> 00:01:44,760\n具体到我们真正的实践\n\n50\n00:01:44,760 --> 00:01:48,320\n可以用一个万能的提示词模板来实现\n\n51\n00:01:48,320 --> 00:01:50,180\n我们一起来看一下\n\n52\n00:01:51,760 --> 00:01:54,600\n我们把这段提示词粘贴给TIPSICK\n\n53\n00:01:54,600 --> 00:01:55,580\n他写的是\n\n54\n00:01:55,580 --> 00:01:59,080\n你是一个针对七岁儿童的AI运动指导助手\n\n55\n00:01:59,080 --> 00:02:01,560\n了解儿童的身心发展规律\n\n56\n00:02:01,560 --> 00:02:04,160\n运动心理行为的激励机制\n\n57\n00:02:04,160 --> 00:02:05,980\n请你为一个七岁的男孩\n\n58\n00:02:05,980 --> 00:02:07,220\n他体重超标\n\n59\n00:02:07,220 --> 00:02:08,660\n跑跳能力比较弱\n\n60\n00:02:08,660 --> 00:02:10,100\n但是呢喜欢恐龙\n\n61\n00:02:10,100 --> 00:02:12,760\n喜欢模仿和比赛的这样一个孩子\n\n62\n00:02:12,760 --> 00:02:16,200\n去设计一套为期五天的趣味运动计划\n\n63\n00:02:16,200 --> 00:02:18,899\n每次的锻炼时间不超过15分钟\n\n64\n00:02:18,899 --> 00:02:23,459\n具具体的这个目标是如改善心肺耐力\n\n65\n00:02:23,459 --> 00:02:24,579\n提升兴趣\n\n66\n00:02:24,579 --> 00:02:26,890\n让运动变成日常习惯\n\n67\n00:02:26,890 --> 00:02:28,910\n下面的是一些个要求\n\n68\n00:02:28,910 --> 00:02:31,330\n第一个就是使用游戏化的语言\n\n69\n00:02:31,330 --> 00:02:32,770\n比如说像闯关啊\n\n70\n00:02:32,770 --> 00:02:34,230\n挑战啊奖励\n\n71\n00:02:34,230 --> 00:02:37,630\n第二个是每节运动要含3~4个项目\n\n72\n00:02:37,630 --> 00:02:39,710\n项项目的设计呢要有层次\n\n73\n00:02:39,710 --> 00:02:41,070\n要有能量的递进\n\n74\n00:02:41,070 --> 00:02:44,950\n第三个是每项运动都需要有详细的步骤\n\n75\n00:02:44,950 --> 00:02:46,230\n有动作的标准\n\n76\n00:02:46,230 --> 00:02:48,200\n要有激励和反馈的语言\n\n77\n00:02:48,200 --> 00:02:52,280\n第四个就是风格像一个幽默又温柔的一个卡通\n\n78\n00:02:52,280 --> 00:02:52,760\n教练\n\n79\n00:02:52,760 --> 00:02:54,140\n不催促鼓励\n\n80\n00:02:54,140 --> 00:02:55,200\n要多一些\n\n81\n00:02:55,200 --> 00:02:57,860\n请生成今天的训练计划\n\n82\n00:02:57,860 --> 00:03:00,280\n那我们来看一看它具体的\n\n83\n00:03:00,280 --> 00:03:02,520\n这个生成的内容是什么\n\n84\n00:03:06,560 --> 00:03:10,480\n好你看他写的是恐龙小勇士训练营\n\n85\n00:03:10,480 --> 00:03:12,470\n第一天闯关计划\n\n86\n00:03:12,470 --> 00:03:14,810\n那像孔小勇士的名字\n\n87\n00:03:14,810 --> 00:03:16,770\n肯定就是小小朋友的名字啊\n\n88\n00:03:16,770 --> 00:03:20,079\n今天的任务标是穿越侏罗纪的丛林\n\n89\n00:03:20,079 --> 00:03:22,739\n通关的目标是变身灵活的小恐龙\n\n90\n00:03:22,739 --> 00:03:24,719\n完成三个秘密的训练\n\n91\n00:03:24,719 --> 00:03:27,310\n悄悄提升心肺的耐力\n\n92\n00:03:27,310 --> 00:03:29,050\n第一个呢就是热身关\n\n93\n00:03:29,050 --> 00:03:30,010\n火山苏醒\n\n94\n00:03:30,010 --> 00:03:31,670\n一共是3分钟啊\n\n95\n00:03:31,670 --> 00:03:34,730\n然后呢让他动作一就是恐龙蛋摇摆\n\n96\n00:03:34,730 --> 00:03:35,890\n步骤是什么\n\n97\n00:03:35,890 --> 00:03:37,070\n鼓励语是什么\n\n98\n00:03:37,070 --> 00:03:38,930\n然后动作二又是什么\n\n99\n00:03:38,930 --> 00:03:40,250\n翼龙展翅是吧\n\n100\n00:03:40,250 --> 00:03:40,970\n还有步骤\n\n101\n00:03:40,970 --> 00:03:42,550\n还有奖奖励语\n\n102\n00:03:42,550 --> 00:03:45,290\n然后呢下面是有能量的升级关\n\n103\n00:03:45,290 --> 00:03:46,770\n恐龙大追捕\n\n104\n00:03:46,770 --> 00:03:47,890\n然后挑战一\n\n105\n00:03:47,890 --> 00:03:48,550\n挑战二\n\n106\n00:03:48,550 --> 00:03:49,930\n挑战三\n\n107\n00:03:50,250 --> 00:03:54,410\n还有终极的奖励关恐龙勋章啊\n\n108\n00:03:54,410 --> 00:03:55,890\n动作胜利之舞\n\n109\n00:03:55,890 --> 00:03:57,650\n然后有步骤有奖励\n\n110\n00:03:57,650 --> 00:03:58,680\n还有庆祝语\n\n111\n00:03:58,680 --> 00:04:01,570\n最后还有一个小勇士的备忘录\n\n112\n00:04:01,570 --> 00:04:04,250\n那还有教练的悄悄话啊\n\n113\n00:04:04,250 --> 00:04:07,090\n像这样的一个非常具有童趣的\n\n114\n00:04:07,090 --> 00:04:10,470\n非常适合孩子的闯关计划的锻炼\n\n115\n00:04:10,470 --> 00:04:11,890\n就是锻炼方法\n\n116\n00:04:11,890 --> 00:04:15,730\n那相信孩子还是非常愿意去进行完成的\n\n117\n00:04:15,730 --> 00:04:16,310\n当然了\n\n118\n00:04:16,310 --> 00:04:18,339\n这是今天的一个训练计划\n\n119\n00:04:18,339 --> 00:04:20,440\n后面的话如果是五天\n\n120\n00:04:20,440 --> 00:04:24,260\n每一天都可以按照这种方式去进行生成\n\n121\n00:04:24,260 --> 00:04:25,260\n久而久之呢\n\n122\n00:04:25,260 --> 00:04:29,470\n孩子肯定是愿意去进行体育锻炼的好\n\n123\n00:04:29,470 --> 00:04:32,870\n那么以上呢就是如何利用AI工具去辅助孩子\n\n124\n00:04:32,870 --> 00:04:35,330\n进行一个体育锻炼的指导的方法\n\n125\n00:04:35,330 --> 00:04:37,040\n咱们大家学会了吗\n\n"}]}, "webpage_url": "https://www.bilibili.com/video/BV1D5Gi6QEN7?p=73", "webpage_url_basename": "BV1D5Gi6QEN7", "webpage_url_domain": "bilibili.com", "extractor": "BiliBili", "extractor_key": "BiliBili", "playlist_count": 82, "playlist": "【AI零基础入门】清华大佬终于讲完了AIGC全套教程变现课！含AI广告制作+AI绘画+视频视听语言全流程！全程干货无废话，学完即可副业变现！", "playlist_id": "BV1D5Gi6QEN7", "playlist_title": "【AI零基础入门】清华大佬终于讲完了AIGC全套教程变现课！含AI广告制作+AI绘画+视频视听语言全流程！全程干货无废话，学完即可副业变现！", "playlist_webpage_url": "https://www.bilibili.com/video/BV1D5Gi6QEN7/", "n_entries": 64, "playlist_index": 73, "thumbnails": [{"url": "http://i2.hdslb.com/bfs/archive/ddf2b57576483ae9189affdcd82a8353a0b54e86.jpg", "id": "0"}], "display_id": "BV1D5Gi6QEN7_p73", "fulltitle": "【AI零基础入门】清华大佬终于讲完了AIGC全套教程变现课！含AI广告制作+AI绘画+视频视听语言全流程！全程干货无废话，学完即可副业变现！ p73 【AI教育篇】AI 辅助孩子进行体育锻炼指导", "duration_string": "4:37", "upload_date": "20260523", "epoch": 1780721251, "format": "1080P 高清+30280 - audio only", "format_id": "30080+30280", "ext": "mp4", "protocol": "https+https", "filesize_approx": 7954584, "tbr": 228.918, "width": 1920, "height": 1080, "resolution": "1920x1080", "fps": 30.0, "dynamic_range": "SDR", "vcodec": "avc1.640033", "vbr": 139.768, "aspect_ratio": 1.78, "acodec": "mp4a.40.2", "abr": 89.15, "_type": "video", "_version": {"version": "2026.03.17", "release_git_head": "04d6974f502bbdfaed72c624344f262e30ad9708", "repository": "yt-dlp/yt-dlp"}}