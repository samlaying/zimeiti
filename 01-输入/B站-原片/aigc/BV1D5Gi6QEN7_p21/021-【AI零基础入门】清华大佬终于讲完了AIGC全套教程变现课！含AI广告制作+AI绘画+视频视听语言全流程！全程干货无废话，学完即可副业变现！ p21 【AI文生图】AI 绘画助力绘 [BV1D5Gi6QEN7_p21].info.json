=playurlv3&os=akam&og=hw&platform=pc&deadline=1780724621&uipk=5&upsig=92293b0a428a546657b1ec4cd4c13ad9&uparams=e,mid,nbs,trid,oi,gen,os,og,platform,deadline,uipk&hdnts=exp=1780724621~hmac=f02a8892db1ffcfbea11a81884bcf776a360cfdd21c1d7695f34825fab50a9be&bvc=vod&nettype=0&bw=325670&lrs=0&agrr=0&buvid=56CBBADE-6E37-C95A-FAC9-97160BE6D01C13885infoc&build=0&dl=0&f=u_0_0&qn_dyeid=12e877d24fa7313300fe2f896a23976d&orderid=0,2", "ext": "mp4", "fps": 30.0, "width": 1920, "height": 1080, "vcodec": "avc1.640033", "acodec": "none", "dynamic_range": "SDR", "tbr": 324.446, "quality": 80, "format_id": "30080", "format": "1080P 高清", "protocol": "https", "video_ext": "mp4", "audio_ext": "none", "abr": 0, "vbr": 324.446, "resolution": "1920x1080", "aspect_ratio": 1.78, "filesize_approx": 5129450, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/138.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.bilibili.com/video/BV1D5Gi6QEN7?p=21"}}], "duration": 126.479, "subtitles": {"danmaku": [{"ext": "xml", "url": "https://comment.bilibili.com/38552930457.xml"}], "ai-zh": [{"ext": "srt", "data": "1\n00:00:00,780 --> 00:00:01,700\n同学们大家好\n\n2\n00:00:01,700 --> 00:00:03,120\n我是你们的子文老师\n\n3\n00:00:03,120 --> 00:00:04,880\n这堂课我们来学习一下\n\n4\n00:00:04,880 --> 00:00:07,220\n如何利用AI工具去绘制\n\n5\n00:00:07,220 --> 00:00:10,710\n一个家庭照片墙的创意边框\n\n6\n00:00:10,710 --> 00:00:13,670\n这是一个为家庭设计的一个创意的\n\n7\n00:00:13,670 --> 00:00:15,300\n照片墙的项目呃\n\n8\n00:00:15,300 --> 00:00:18,620\n一家人呢想要展示一下春季的家庭照片\n\n9\n00:00:18,620 --> 00:00:20,280\n希望这些春季的照片\n\n10\n00:00:20,280 --> 00:00:23,490\n有鲜明的特色和装饰的边框\n\n11\n00:00:23,490 --> 00:00:25,030\n以突出季节的特点\n\n12\n00:00:25,030 --> 00:00:27,330\n并且增强以下视觉的美感\n\n13\n00:00:27,330 --> 00:00:28,950\n那么像这样的一个边框\n\n14\n00:00:28,950 --> 00:00:31,030\n我们可以怎么去写提示词呢\n\n15\n00:00:31,030 --> 00:00:32,250\n一起来看一下\n\n16\n00:00:32,250 --> 00:00:36,340\n我们把提示词粘贴到翻译工具里\n\n17\n00:00:36,340 --> 00:00:39,910\n那可以看到他写的是错综复杂的边框\n\n18\n00:00:39,910 --> 00:00:44,470\n灵感是来自春季精致的樱花和年轻的绿叶\n\n19\n00:00:44,470 --> 00:00:46,790\n就是嗯比较鲜嫩的啊\n\n20\n00:00:46,790 --> 00:00:48,910\n这种绿叶缠绕在边缘\n\n21\n00:00:48,910 --> 00:00:50,090\n水彩的风格\n\n22\n00:00:50,090 --> 00:00:51,250\n柔和的粉彩\n\n23\n00:00:51,250 --> 00:00:55,239\n粉色和薄荷绿的调色板就是这样的配色\n\n24\n00:00:55,239 --> 00:00:56,439\n天然的木纹\n\n25\n00:00:56,439 --> 00:00:57,559\n木纹的背景\n\n26\n00:00:57,559 --> 00:00:59,019\n优雅的植物设计\n\n27\n00:00:59,019 --> 00:01:00,840\n微妙的金色色调\n\n28\n00:01:00,840 --> 00:01:02,180\n高细节的工艺\n\n29\n00:01:02,180 --> 00:01:04,599\n专业的摄影照明8K的分辨率\n\n30\n00:01:04,599 --> 00:01:07,870\n那么像这样的一组提示词\n\n31\n00:01:07,870 --> 00:01:11,010\n我们把它粘贴到MAD journey里\n\n32\n00:01:11,010 --> 00:01:14,330\n看一看它能生成一个什么样的画面\n\n33\n00:01:22,740 --> 00:01:24,320\n好我们一起来看一下\n\n34\n00:01:24,320 --> 00:01:26,740\n那么现在的这个四幅画面的话呢\n\n35\n00:01:26,740 --> 00:01:29,470\n都是额木质的\n\n36\n00:01:29,470 --> 00:01:32,710\n就是底板上面的话有绿叶\n\n37\n00:01:32,710 --> 00:01:33,690\n有樱花\n\n38\n00:01:33,690 --> 00:01:36,650\n那整个这个画面很有春天的气息\n\n39\n00:01:36,650 --> 00:01:40,550\n当然它这里面不同的这个造型还是有区别的\n\n40\n00:01:40,550 --> 00:01:43,370\n所以呢我们大家可以在这里面去选择\n\n41\n00:01:43,370 --> 00:01:44,480\n其中的一幅\n\n42\n00:01:44,480 --> 00:01:46,360\n那中间空白的地方\n\n43\n00:01:46,360 --> 00:01:49,360\n后期我们是可以贴上自己的这个照片的\n\n44\n00:01:49,360 --> 00:01:52,460\n它是一个可以做一个很好的这种呃\n\n45\n00:01:52,460 --> 00:01:55,710\n装饰照片的一种边框和底纹\n\n46\n00:01:55,710 --> 00:01:59,470\n那么以上呢就是如何利用AI工具去绘制\n\n47\n00:01:59,470 --> 00:02:01,110\n一个家庭的照片\n\n48\n00:02:01,110 --> 00:02:02,370\n墙的创意边框\n\n49\n00:02:02,370 --> 00:02:04,200\n咱们大家学会了吗\n\n"}]}, "webpage_url": "https://www.bilibili.com/video/BV1D5Gi6QEN7?p=21", "webpage_url_basename": "BV1D5Gi6QEN7", "webpage_url_domain": "bilibili.com", "extractor": "BiliBili", "extractor_key": "BiliBili", "playlist_count": 82, "playlist": "【AI零基础入门】清华大佬终于讲完了AIGC全套教程变现课！含AI广告制