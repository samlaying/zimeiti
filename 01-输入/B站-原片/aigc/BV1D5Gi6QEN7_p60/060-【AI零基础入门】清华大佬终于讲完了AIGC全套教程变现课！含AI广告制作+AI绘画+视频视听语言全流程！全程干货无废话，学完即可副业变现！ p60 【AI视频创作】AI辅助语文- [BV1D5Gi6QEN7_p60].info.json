form=pc&nbs=1&os=estghw&og=hw&trid=e25139bacb1d41f2899c76a7eccc0efu&gen=playurlv3&upsig=9113b37ff7f8d31016113ed35773c245&uparams=e,mid,deadline,oi,uipk,platform,nbs,os,og,trid,gen&bvc=vod&nettype=0&bw=86964&lrs=0&qn_dyeid=2b8af38ba9f379bd00b0b8bc6a23a3b2&agrr=0&buvid=56CBBADE-6E37-C95A-FAC9-97160BE6D01C13885infoc&build=0&dl=0&f=u_0_0&orderid=0,3", "ext": "mp4", "fps": 30.0, "width": 1280, "height": 720, "vcodec": "avc1.640033", "acodec": "none", "dynamic_range": "SDR", "tbr": 86.829, "quality": 64, "format_id": "30064", "format": "720P 准高清", "protocol": "https", "video_ext": "mp4", "audio_ext": "none", "abr": 0, "vbr": 86.829, "resolution": "1280x720", "aspect_ratio": 1.78, "filesize_approx": 7618593, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/138.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.bilibili.com/video/BV1D5Gi6QEN7?p=60"}}, {"url": "https://upos-sz-mirror08c.bilivideo.com/upgcxcode/77/38/38553453877/38553453877-1-30080.m4s?e=ig8euxZM2rNcNbdlhoNvNC8BqJIzNbfqXBvEqxTEto8BTrNvN0GvT90W5JZMkX_YN0MvXg8gNEV4NC8xNEV4N03eN0B5tZlqNxTEto8BTrNvNeZVuJ10Kj_g2UB02J0mN0B5tZlqNCNEto8BTrNvNC7MTX502C8f2jmMQJ6mqF2fka1mqx6gqj0eN0B599M=&trid=e25139bacb1d41f2899c76a7eccc0efu&mid=3546568672151587&uipk=5&os=08cbv&platform=pc&nbs=1&deadline=1780727762&oi=1875881457&gen=playurlv3&og=hw&upsig=9dfa2abb90b0b2734340df85d5dc5ce2&uparams=e,trid,mid,uipk,os,platform,nbs,deadline,oi,gen,og&bvc=vod&nettype=0&bw=169904&lrs=0&f=u_0_0&qn_dyeid=2b8af38ba9f379bd00b0b8bc6a23a3b2&agrr=0&buvid=56CBBADE-6E37-C95A-FAC9-97160BE6D01C13885infoc&build=0&dl=0&orderid=0,3", "ext": "mp4", "fps": 30.0, "width": 1920, "height": 1080, "vcodec": "avc1.640033", "acodec": "none", "dynamic_range": "SDR", "tbr": 169.659, "quality": 80, "format_id": "30080", "format": "1080P 高清", "protocol": "https", "video_ext": "mp4", "audio_ext": "none", "abr": 0, "vbr": 169.659, "resolution": "1920x1080", "aspect_ratio": 1.78, "filesize_approx": 14886304, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/138.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.bilibili.com/video/BV1D5Gi6QEN7?p=60"}}], "duration": 701.94, "subtitles": {"danmaku": [{"ext": "xml", "url": "https://comment.bilibili.com/38553453877.xml"}], "ai-zh": [{"ext": "srt", "data": "1\n00:00:01,120 --> 00:00:02,000\n同学们大家好\n\n2\n00:00:02,000 --> 00:00:03,320\n我是你们的子文老师\n\n3\n00:00:03,320 --> 00:00:05,160\n这堂课我们来学习一下\n\n4\n00:00:05,160 --> 00:00:08,650\n如何利用AI工具去辅助语文的教学\n\n5\n00:00:08,650 --> 00:00:10,770\n助力古诗词的理解\n\n6\n00:00:10,770 --> 00:00:12,990\n你有没有遇到过这样一种情况\n\n7\n00:00:12,990 --> 00:00:14,970\n就是明明读了很多的李白\n\n8\n00:00:14,970 --> 00:00:15,540\n杜甫\n\n9\n00:00:15,540 --> 00:00:16,620\n字儿都认识\n\n10\n00:00:16,620 --> 00:00:18,140\n意思呢也大概都懂\n\n11\n00:00:18,140 --> 00:00:20,800\n但就是读不出来那种情绪的美\n\n12\n00:00:20,800 --> 00:00:22,009\n画面的诗\n\n13\n00:00:22,009 --> 00:00:24,469\n总觉得是隔着书本和课本\n\n14\n00:00:24,469 --> 00:00:26,700\n跟诗人之间还是有点远\n\n15\n00:00:26,700 --> 00:00:30,800\n或者你是老师讲课讲到了孤帆远影碧空尽\n\n16\n00:00:30,800 --> 00:00:33,200\n但是呢学生仍然是一脸懵\n\n17\n00:00:33,200 --> 00:00:36,300\n只能干巴巴巴的去进行背诵和理解\n\n18\n00:00:36,300 --> 00:00:40,350\n却没有办法真的去走进那条江上的小船里\n\n19\n00:00:40,350 --> 00:00:42,010\n这个不是你不努力\n\n20\n00:00:42,010 --> 00:00:44,480\n而是语言本身它的障碍\n\n21\n00:00:44,480 --> 00:00:47,500\n古诗词从来不是讲给今天的人听的\n\n22\n00:00:47,500 --> 00:00:50,500\n他要的是借你一个想象力的门\n\n23\n00:00:50,500 --> 00:00:52,290\n带你去穿越时空\n\n24\n00:00:52,290 --> 00:00:56,019\n看到诗人彼时彼地的心绪和场景\n\n25\n00:00:56,019 --> 00:01:00,179\n那么AI这个工具能不能帮我们把这道门打开呢\n\n26\n00:01:00,179 --> 00:01:02,920\n能而且比你想象的要更厉害\n\n27\n00:01:02,920 --> 00:01:06,360\n但关键是AI不能代替你去读诗\n\n28\n00:01:06,360 --> 00:01:10,390\n而是需要让它变成你的失敬的导航员\n\n29\n00:01:10,830 --> 00:01:13,470\n那么AI怎么去理解时\n\n30\n00:01:13,470 --> 00:01:15,370\n我们怎么去用好它呢\n\n31\n00:01:15,370 --> 00:01:18,870\n其实我们拆解一下这个古诗的理解障碍\n\n32\n00:01:18,870 --> 00:01:20,570\n一共就是三点\n\n33\n00:01:20,570 --> 00:01:23,090\n第一点呢就是词义的模糊\n\n34\n00:01:23,090 --> 00:01:26,790\n很多字词在古文中它是有多重含义的\n\n35\n00:01:26,790 --> 00:01:30,010\nAI能够快速的去给出多个的解释\n\n36\n00:01:30,010 --> 00:01:31,919\n以及语境的对比\n\n37\n00:01:31,919 --> 00:01:34,759\n第二个就是情境难以还原\n\n38\n00:01:34,759 --> 00:01:36,919\n诗写的其实是场景\n\n39\n00:01:36,919 --> 00:01:37,699\n情绪\n\n40\n00:01:37,699 --> 00:01:38,750\n还有象征\n\n41\n00:01:38,750 --> 00:01:41,290\n那么AI呢就能生成图像\n\n42\n00:01:41,290 --> 00:01:42,870\n可以还原环境\n\n43\n00:01:42,870 --> 00:01:44,720\n可以构建情境\n\n44\n00:01:44,720 --> 00:01:47,289\n第三个就是诗意不好讲\n\n45\n00:01:47,289 --> 00:01:52,149\nAI呢能把复杂抽象的感觉去转译成类比\n\n46\n00:01:52,149 --> 00:01:53,809\n还有故事和画面\n\n47\n00:01:53,809 --> 00:01:56,139\n能够帮助学生有感\n\n48\n00:01:56,139 --> 00:01:59,579\n所以AI不是一个知识点的提取器\n\n49\n00:01:59,579 --> 00:02:02,500\n而是一个共情的翻译官\n\n50\n00:02:02,820 --> 00:02:07,240\n咱们使用AI的思路可以归纳总结成三个字\n\n51\n00:02:07,240 --> 00:02:09,930\n第一个呢就是引引导的引\n\n52\n00:02:09,930 --> 00:02:12,550\n第二个就是扩扩展扩\n\n53\n00:02:12,550 --> 00:02:15,620\n还有一个是还还原的意思\n\n54\n00:02:15,620 --> 00:02:18,800\n那么首先引它引的是关键词\n\n55\n00:02:18,800 --> 00:02:20,020\n是句意\n\n56\n00:02:20,020 --> 00:02:20,920\n是背景\n\n57\n00:02:20,920 --> 00:02:22,350\n它可以做铺垫\n\n58\n00:02:22,350 --> 00:02:24,850\n那么扩呢是扩展意向\n\n59\n00:02:24,850 --> 00:02:26,050\n生成画面\n\n60\n00:02:26,050 --> 00:02:27,530\n调动想象\n\n61\n00:02:27,530 --> 00:02:29,790\n还是还原情绪\n\n62\n00:02:29,790 --> 00:02:31,070\n补足诗境\n\n63\n00:02:31,070 --> 00:02:34,260\n让读者读者能够身临其境\n\n64\n00:02:34,260 --> 00:02:36,680\n比如说月落乌啼\n\n65\n00:02:36,680 --> 00:02:37,720\n霜霜满天\n\n66\n00:02:37,720 --> 00:02:40,880\n那你就可以让AI去画一张图\n\n67\n00:02:40,880 --> 00:02:44,060\n更妙的是是可以让AI去写一段\n\n68\n00:02:44,060 --> 00:02:48,250\n我在当时的那个场景中行走的时候的心理描写\n\n69\n00:02:48,250 --> 00:02:51,120\n去引导学生进行代入\n\n70\n00:02:51,400 --> 00:02:54,960\n那么接下来咱们通过一个实例去说明\n\n71\n00:02:54,960 --> 00:02:57,250\n以上的过程是什么样\n\n72\n00:02:57,650 --> 00:03:03,050\n首先第一个我们就可以通过一段提示词去做\n\n73\n00:03:03,050 --> 00:03:03,810\n解释\n\n74\n00:03:03,810 --> 00:03:05,450\n古诗词的含义\n\n75\n00:03:05,450 --> 00:03:06,610\n可以加上画面\n\n76\n00:03:06,610 --> 00:03:07,450\n还有情绪\n\n77\n00:03:07,450 --> 00:03:09,459\n我们一起来看一下\n\n78\n00:03:09,459 --> 00:03:14,280\n我们把这段提示词给到deep sick这个AI工具\n\n79\n00:03:14,280 --> 00:03:19,280\n那么他写的是你是一位古代文学的讲解专家\n\n80\n00:03:19,280 --> 00:03:21,760\n请你逐句的解读这首诗\n\n81\n00:03:21,760 --> 00:03:23,840\n当然这个诗的名字啊\n\n82\n00:03:23,840 --> 00:03:25,080\n我们是可以替换的\n\n83\n00:03:25,080 --> 00:03:28,230\n现在呢我们写的是李清照的一剪梅\n\n84\n00:03:28,230 --> 00:03:31,450\n那么包括以下以下的那这几个内容\n\n85\n00:03:31,450 --> 00:03:34,820\n第一个呢是需要有美剧的现代的意思\n\n86\n00:03:34,820 --> 00:03:37,040\n还要有画面的描绘\n\n87\n00:03:37,040 --> 00:03:39,640\n可以用比喻或者是视觉语言\n\n88\n00:03:39,640 --> 00:03:41,880\n第三个呢是情绪的表达\n\n89\n00:03:41,880 --> 00:03:45,430\n诗人死时可能的情感的状态是什么\n\n90\n00:03:45,430 --> 00:03:47,510\n要求语言生动\n\n91\n00:03:47,510 --> 00:03:49,570\n自然适合学生理解\n\n92\n00:03:49,570 --> 00:03:51,610\n避免机械式的解释\n\n93\n00:03:51,610 --> 00:03:55,350\n那么这样的一套提示词给到deep sick以后\n\n94\n00:03:55,350 --> 00:04:00,979\n他就可以给我们一个像这样的很详细的解释\n\n95\n00:04:01,979 --> 00:04:03,739\n如果你遇到了像这种网络异常\n\n96\n00:04:03,739 --> 00:04:06,139\n我们直接刷新一下就可以了\n\n97\n00:04:10,900 --> 00:04:13,840\n好你看他现在已经出现答案啊\n\n98\n00:04:13,840 --> 00:04:14,860\n首先呢有个引子\n\n99\n00:04:14,860 --> 00:04:15,280\n好的\n\n100\n00:04:15,280 --> 00:04:17,589\n让我们先拨开一枚清甜的莲子\n\n101\n00:04:17,589 --> 00:04:20,709\n那样细细地品味李清照的这首一剪梅\n\n102\n00:04:20,709 --> 00:04:24,290\n然后下面这是诗词的第一句话啊\n\n103\n00:04:24,290 --> 00:04:25,850\n红藕相残于店秋\n\n104\n00:04:25,850 --> 00:04:30,330\n现代的意思就是红粉粉红色的荷花凋谢了\n\n105\n00:04:30,330 --> 00:04:32,440\n竹席透着秋凉\n\n106\n00:04:32,440 --> 00:04:34,600\n然后画面是什么样的啊\n\n107\n00:04:34,600 --> 00:04:36,630\n然后情绪是什么样的\n\n108\n00:04:36,630 --> 00:04:39,590\n然后下面清洁罗裳独上兰舟啊\n\n109\n00:04:39,590 --> 00:04:41,930\n现代的意思画面感是什么样\n\n110\n00:04:41,930 --> 00:04:43,070\n情绪感是什么样\n\n111\n00:04:43,070 --> 00:04:44,590\n你看这样的话呢\n\n112\n00:04:44,590 --> 00:04:46,150\n每一句啊\n\n113\n00:04:46,150 --> 00:04:47,890\n每一句的这样的诗词\n\n114\n00:04:47,890 --> 00:04:50,230\n他全都给你进行展开\n\n115\n00:04:50,230 --> 00:04:52,630\n然后有现代的翻译\n\n116\n00:04:52,630 --> 00:04:54,650\n有画面感的描述\n\n117\n00:04:54,650 --> 00:04:57,659\n还有呢相应的情绪是什么感觉\n\n118\n00:04:57,659 --> 00:05:01,479\n这样的话我们同学在看到这样的一个解释以后\n\n119\n00:05:01,479 --> 00:05:05,909\n他就可以诶非常好的去理解这首诗的意境\n\n120\n00:05:05,909 --> 00:05:10,300\n比我们干巴巴的去背这首诗要好很多好\n\n121\n00:05:10,300 --> 00:05:12,000\n这是第一种情况\n\n122\n00:05:12,000 --> 00:05:13,280\n那么第二种\n\n123\n00:05:13,280 --> 00:05:17,950\n还有一种就是代入场景式的这种模拟啊\n\n124\n00:05:17,950 --> 00:05:20,880\n可以非常方便的用于我们的课堂讲解\n\n125\n00:05:20,880 --> 00:05:22,560\n或者是作文的引导\n\n126\n00:05:22,560 --> 00:05:25,560\n我们一起来看一下这种是什么样子\n\n127\n00:05:25,560 --> 00:05:28,780\n把这段提示词同样发送给deep sick\n\n128\n00:05:28,780 --> 00:05:30,060\n那么他写的是\n\n129\n00:05:30,060 --> 00:05:33,620\n请你扮演一位亲历干师长景的旅人\n\n130\n00:05:33,620 --> 00:05:37,180\n用第一人称去描述当时的景象\n\n131\n00:05:37,180 --> 00:05:39,290\n或者是感受背景呢\n\n132\n00:05:39,290 --> 00:05:41,090\n是这首诗还是刚才的啊\n\n133\n00:05:41,090 --> 00:05:43,490\n就是哎红藕香残玉垫秋\n\n134\n00:05:43,490 --> 00:05:44,690\n然后轻解罗裳\n\n135\n00:05:44,690 --> 00:05:45,610\n独上兰舟\n\n136\n00:05:45,610 --> 00:05:49,460\n目标是让学生去感受适中的情绪与环境\n\n137\n00:05:49,460 --> 00:05:50,460\n语言要真实\n\n138\n00:05:50,460 --> 00:05:51,140\n有画面感\n\n139\n00:05:51,140 --> 00:05:51,880\n有细节\n\n140\n00:05:51,880 --> 00:05:56,120\n不要用AI的术语或者是现代感的语言\n\n141\n00:05:56,120 --> 00:05:59,920\n所以呢你看他就是把刚才的那首诗里面的\n\n142\n00:05:59,920 --> 00:06:03,290\n其中几句话给它单独提取出来\n\n143\n00:06:03,290 --> 00:06:07,510\n然后呢把这几把这几句话去描绘成一个情景\n\n144\n00:06:07,510 --> 00:06:09,310\n我们一起来看一下\n\n145\n00:06:18,260 --> 00:06:19,820\n好你看哎\n\n146\n00:06:19,820 --> 00:06:22,300\n他是以女人独白的这种形式\n\n147\n00:06:22,300 --> 00:06:24,419\n把它写成了一个小短文\n\n14