o_ext": "mp4", "audio_ext": "none", "abr": 0, "vbr": 119.657, "resolution": "1920x1080", "aspect_ratio": 1.78, "filesize_approx": 4529196, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/138.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.bilibili.com/video/BV1D5Gi6QEN7?p=75"}}], "duration": 302.812, "subtitles": {"danmaku": [{"ext": "xml", "url": "https://comment.bilibili.com/38553455159.xml"}], "ai-zh": [{"ext": "srt", "data": "1\n00:00:01,520 --> 00:00:02,360\n同学们大家好\n\n2\n00:00:02,360 --> 00:00:03,760\n我是你们的子文老师\n\n3\n00:00:03,760 --> 00:00:05,460\n这堂课我们来学习一下\n\n4\n00:00:05,460 --> 00:00:09,210\n如何利用AI工具助力孩子拓展课外知识\n\n5\n00:00:09,210 --> 00:00:10,470\n有没有那么一刻\n\n6\n00:00:10,470 --> 00:00:12,130\n你在看着孩子写作业\n\n7\n00:00:12,130 --> 00:00:13,750\n忽然冒出来一个念头\n\n8\n00:00:13,750 --> 00:00:14,730\n除了课本\n\n9\n00:00:14,730 --> 00:00:16,009\n他还知道什么\n\n10\n00:00:16,009 --> 00:00:18,149\n或者在刷短视频的时候\n\n11\n00:00:18,149 --> 00:00:21,269\n听到孩子问宇宙膨胀是什么意思\n\n12\n00:00:21,269 --> 00:00:23,150\n你一下子答不上来\n\n13\n00:00:23,150 --> 00:00:24,210\n我们这一代\n\n14\n00:00:24,210 --> 00:00:26,690\n我们这一代的父母其实都挺焦虑的\n\n15\n00:00:26,690 --> 00:00:28,689\n一边怕孩子只会考试\n\n16\n00:00:28,689 --> 00:00:32,560\n一边呢又怕他浪费时间学习一些无用的东西\n\n17\n00:00:32,560 --> 00:00:34,560\n但是当你认真去想想\n\n18\n00:00:34,560 --> 00:00:35,460\n你会发现\n\n19\n00:00:35,460 --> 00:00:38,660\n孩子真正的竞争力可能根本不在课堂里\n\n20\n00:00:38,660 --> 00:00:41,880\n而是他在课外好奇心有多大\n\n21\n00:00:41,880 --> 00:00:43,340\n能够走多远\n\n22\n00:00:43,340 --> 00:00:44,840\n但是问题也来了\n\n23\n00:00:44,840 --> 00:00:48,410\n很多父母很想支持孩子拓展课外知识\n\n24\n00:00:48,410 --> 00:00:50,550\n可是现实是自己没有精力\n\n25\n00:00:50,550 --> 00:00:51,590\n也没有时间\n\n26\n00:00:51,590 --> 00:00:53,370\n更没有系统的思路\n\n27\n00:00:53,370 --> 00:00:55,530\n给孩子看一些视频和文章\n\n28\n00:00:55,530 --> 00:00:57,090\n全是靠碰运气\n\n29\n00:00:57,090 --> 00:00:58,910\n孩子刚感兴趣了几天\n\n30\n00:00:58,910 --> 00:01:01,370\n就被一些无效的信息劝退了\n\n31\n00:01:01,370 --> 00:01:03,810\n这个时候你是不是也会问\n\n32\n00:01:03,810 --> 00:01:06,230\nAI工具到底能不能帮我\n\n33\n00:01:06,230 --> 00:01:07,740\n那么怎么用\n\n34\n00:01:07,740 --> 00:01:11,580\n今天咱们就彻底讲透这么一个底层的逻辑\n\n35\n00:01:11,580 --> 00:01:14,240\nAI呢它不是知识的搬运工\n\n36\n00:01:14,240 --> 00:01:16,420\n而是兴趣的放大器\n\n37\n00:01:16,420 --> 00:01:18,740\n关键在于你是怎么问\n\n38\n00:01:18,740 --> 00:01:20,160\n你要问的对的话\n\n39\n00:01:20,160 --> 00:01:24,850\n他是能从宇宙讲到蚂蚁都能讲得引人入胜\n\n40\n00:01:24,850 --> 00:01:26,850\n如果你要是问的错了\n\n41\n00:01:26,850 --> 00:01:30,770\n他就是只会照搬一些什么维基百科呀\n\n42\n00:01:30,770 --> 00:01:32,390\n百度百科之类的\n\n43\n00:01:32,390 --> 00:01:34,950\n想让AI真正能够帮上忙\n\n44\n00:01:34,950 --> 00:01:37,910\n你是需要掌握三个核心原则的\n\n45\n00:01:37,910 --> 00:01:41,180\n第一个核心原则就是从问题出发\n\n46\n00:01:41,180 --> 00:01:43,220\n而不是从知识出发\n\n47\n00:01:43,220 --> 00:01:44,920\n也就是孩子的问题\n\n48\n00:01:44,920 --> 00:01:47,120\n他才是学习的起点\n\n49\n00:01:47,120 --> 00:01:49,720\n第二个呢就是AI像是朋友\n\n50\n00:01:49,720 --> 00:01:51,090\n而不是老师\n\n51\n00:01:51,090 --> 00:01:52,410\n越像对话\n\n52\n00:01:52,410 --> 00:01:54,730\n那么孩子就越越愿意听\n\n53\n00:01:54,730 --> 00:01:57,310\n如果你是单纯的讲授的话\n\n54\n00:01:57,310 --> 00:01:59,700\n孩子会觉得枯燥无味\n\n55\n00:01:59,700 --> 00:02:02,740\n第三个呢就是控制信息的密度\n\n56\n00:02:02,740 --> 00:02:04,440\n别一口喂的太多了\n\n57\n00:02:04,440 --> 00:02:06,400\n每一次呢只讲一个点\n\n58\n00:02:06,400 --> 00:02:07,320\n讲清楚\n\n59\n00:02:07,320 --> 00:02:08,180\n讲有趣\n\n60\n00:02:08,180 --> 00:02:09,610\n这就可以了\n\n61\n00:02:09,610 --> 00:02:13,390\n那么接下来我们用一个通用的提示词模板\n\n62\n00:02:13,390 --> 00:02:17,480\n来看一看以上的这个过程应该怎么实现\n\n63\n00:02:18,040 --> 00:02:20,780\n我们把这段提示词给到deep sc\n\n64\n00:02:20,780 --> 00:02:22,130\n可以看一下\n\n65\n00:02:22,130 --> 00:02:26,370\n他写的是你是一位擅长讲给孩子听的知识\n\n66\n00:02:26,370 --> 00:02:27,360\n讲解者\n\n67\n00:02:27,360 --> 00:02:29,360\n请用孩子能够听懂的\n\n68\n00:02:29,360 --> 00:02:30,300\n听懂的语言\n\n69\n00:02:30,300 --> 00:02:34,060\n解释一个关于为什么天上的星星有的很亮\n\n70\n00:02:34,060 --> 00:02:34,880\n有的很暗\n\n71\n00:02:34,880 --> 00:02:36,140\n这样一个问题\n\n72\n00:02:36,140 --> 00:02:38,980\n要求是语言自然像聊天儿\n\n73\n00:02:38,980 --> 00:02:40,280\n不要像教科书\n\n74\n00:02:40,280 --> 00:02:44,600\n用小故事比喻举例等方式让孩子理解\n\n75\n00:02:44,600 --> 00:02:46,100\n信息量要适中\n\n76\n00:02:46,100 --> 00:02:48,960\n控制在3分钟之内就能讲完\n\n77\n00:02:48,960 --> 00:02:52,040\n适合8~12岁的孩子能够听懂\n\n78\n00:02:52,040 --> 00:02:54,520\n最后呢要抛出一个类似于\n\n79\n00:02:54,520 --> 00:02:57,080\n那你觉得呢这样的开放式的问题\n\n80\n00:02:57,080 --> 00:02:59,880\n去引导孩子延伸时思考\n\n81\n00:02:59,880 --> 00:03:02,480\n那么下面就是开始解释这个问题\n\n82\n00:03:02,480 --> 00:03:04,240\n为什么天上的星星有的很亮\n\n83\n00:03:04,240 --> 00:03:05,160\n有的很暗啊\n\n84\n00:03:05,160 --> 00:03:06,640\n当然咱们在这里面\n\n85\n00:03:06,640 --> 00:03:09,560\n家长是可以灵活地去进行使用的\n\n86\n00:03:09,560 --> 00:03:13,240\n里面的一些信息你是可以自由地进行替换好\n\n87\n00:03:13,240 --> 00:03:16,420\n那我们来看一看他是怎么去回答\n\n88\n00:03:20,660 --> 00:03:22,800\n好你看他写的是嘿小朋友\n\n89\n00:03:22,800 --> 00:03:24,460\n你有没有发现天上的星星\n\n90\n00:03:24,460 --> 00:03:26,860\n就像一群调皮的小朋友在玩躲猫猫\n\n91\n00:03:26,860 --> 00:03:28,780\n有的星星特别的爱表现\n\n92\n00:03:28,780 --> 00:03:30,480\n把手电筒开到最亮\n\n93\n00:03:30,480 --> 00:03:31,740\n比如说像天狼星\n\n94\n00:03:31,740 --> 00:03:33,860\n有的呢就像害羞的小姑娘\n\n95\n00:03:33,860 --> 00:03:35,760\n只敢发出一点点的微光\n\n96\n00:03:35,760 --> 00:03:37,040\n比如说北极星\n\n97\n00:03:37,040 --> 00:03:38,520\n你知道这是为什么吗\n\n98\n00:03:38,520 --> 00:03:42,260\n你看它是一种非常的亲切自然\n\n99\n00:03:42,260 --> 00:03:45,840\n但同时呢又很适合小孩的这种年龄段的\n\n100\n00:03:45,840 --> 00:03:47,150\n一种语气\n\n101\n00:03:47,150 --> 00:03:50,350\n那下面他写的是来我们玩个想象的游戏\n\n102\n00:03:50,350 --> 00:03:51,930\n假如你站在操场上\n\n103\n00:03:51,930 --> 00:03:54,730\n远处有个同学举着手机的闪\n\n104\n00:03:54,730 --> 00:03:56,300\n举着手机的闪光灯\n\n105\n00:03:56,300 --> 00:03:59,620\n近处有个同学举着超亮的手电筒\n\n106\n00:03:59,620 --> 00:04:01,820\n那么你觉得哪个更亮呢\n\n107\n00:04:01,820 --> 00:04:03,420\n这星星也是这样\n\n108\n00:04:03,420 --> 00:04:05,060\n有的星星呢离我们特别近\n\n109\n00:04:05,060 --> 00:04:05,960\n比如说像太阳\n\n110\n00:04:05,960 --> 00:04:09,079\n那么它其实就是一颗超近的星星\n\n111\n00:04:09,079 --> 00:04:11,519\n有的是住在银河系的另一端\n\n112\n00:04:11,519 --> 00:04:13,939\n就像住在不同楼层的邻居\n\n113\n00:04:13,939 --> 00:04:16,630\n那离得远的说话声自然就小\n\n114\n00:04:16,630 --> 00:04:17,850\n还有一个小秘密\n\n115\n00:04:17,850 --> 00:04:19,350\n星星就像不同的灯泡\n\n116\n00:04:19,350 --> 00:04:21,720\n有的天生的是100瓦的大灯泡\n\n117\n00:04:21,720 --> 00:04:24,260\n比如说像蓝白色的年轻的星星\n\n118\n00:04:24,260 --> 00:04:26,120\n有的呢像5瓦的小夜灯\n\n119\n00:04:26,120 --> 00:04:28,400\n比如说红巨星的爷爷等等\n\n120\n00:04:28,400 --> 00:04:31,170\n你看他的这种表述的呃\n\n121\n00:04:31,170 --> 00:04:35,750\n就是这种语气表述的方式都是非常适合孩子的\n\n122\n00:04:35,750 --> 00:04:37,300\n用一种比喻的\n\n123\n00:04:37,300 --> 00:04:41,490\n这样的贴近生活的方式去讲述一个小故事\n\n124\n00:04:41,490 --> 00:04:45,530\n那用这样的方式呢会让孩子更加容易接受啊\n\n125\n00:04:45,530 --> 00:04:48,210\n就不是那种非常枯燥无味的一种\n\n126\n00:04:48,210 --> 00:04:50,830\n科普性的这种感觉好\n\n127\n00:04:50,830 --> 00:04:54,770\n那么以上呢就是如何利用AI工具去做\n\n128\n00:04:54,770 --> 00:04:58,980\n咱们这种孩子的拓展课外知识的讲授\n\n129\n00:04:58,980 --> 00:05:01,040\n咱们大家学会了吗\n\n"}]}, "webpage_url": "https://www.bilibili.com/video/BV1D5Gi6QEN7?p=75", "webpage_url_basename": "BV1D5Gi6QEN7", "webpage_url_domain": "bilibili.com", "extractor": "BiliBili", "extractor_key": "BiliBili", "playlist_count": 82, "playlist": "【AI零基础入门】清华大佬终于讲完了AIGC全套教程变现课！含AI广告制作+AI绘画+视频视听语言全流程！全程干货无废话，学完即可副业变现！", "playlist_id": "BV1D5Gi6QEN7", "playlist_title": "【AI零基础入门】清华大佬终于讲完了AIGC全套教程变现课！含AI广告制作+AI绘画+视频视听语言全流程！全程干货无废话，学完即可副业变现！", "playlist_webpage_url": "https://www.bilibili.com/video/BV1D5Gi6QEN7/", "n_entries": 64, "playlist_index": 75, "thumbnails": [{"url": "http://i2.hdslb.com/bfs/archive/ddf2b57576483ae9189affdcd82a8353a0b54e86.jpg", "id": "0"}], "display_id": "BV1D5Gi6QEN7_p75", "fulltitle": "【AI零基础入门】清华大佬终于讲完了AIGC全套教程变现课！含AI广告制作+AI绘画+视频视听语言全流程！全程干货无废话，学完即可副业变现！ p75 【AI教育篇】AI 助力孩子拓展课外知识", "duration_string": "5:02", "upload_date": "20260523", "epoch": 1780721345, "format": "1080P 高清+30280 - audio only", "format_id": "30080+30280", "ext": "mp4", "protocol": "https+https", "filesize_approx": 7895784, "tbr": 208.599, "width": 1920, "height": 1080, "resolution": "1920x1080", "fps": 30.0, "dynamic_range": "SDR", "vcodec": "avc1.640033", "vbr": 119.657, "aspect_ratio": 1.78, "acodec": "mp4a.40.2", "abr": 88.942, "_type": "video", "_version": {"version": "2026.03.17", "release_git_head": "04d6974f502bbdfaed72c624344f262e30ad9708", "repository": "yt-dlp/yt-dlp"}}