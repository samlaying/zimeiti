077u&uipk=5&oi=1733154763&os=akam&og=cos&platform=pc&upsig=8d9ea4a1ac72be6513744e7b05196051&uparams=e,mid,deadline,nbs,gen,trid,uipk,oi,os,og,platform&hdnts=exp=1780725256~hmac=274a8879a5874d24687b5547755373779a3dd557b198f4b31d8b42a2e09f9a8c&bvc=vod&nettype=0&bw=197913&lrs=0&buvid=56CBBADE-6E37-C95A-FAC9-97160BE6D01C13885infoc&build=0&dl=0&f=u_0_0&qn_dyeid=0e7c84b465217cca00f4e3a76a2399e8&agrr=0&orderid=0,2", "ext": "mp4", "fps": 30.0, "width": 1920, "height": 1080, "vcodec": "avc1.640033", "acodec": "none", "dynamic_range": "SDR", "tbr": 196.789, "quality": 80, "format_id": "30080", "format": "1080P 高清", "protocol": "https", "video_ext": "mp4", "audio_ext": "none", "abr": 0, "vbr": 196.789, "resolution": "1920x1080", "aspect_ratio": 1.78, "filesize_approx": 3240868, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/138.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.bilibili.com/video/BV1D5Gi6QEN7?p=29"}}], "duration": 131.75, "subtitles": {"danmaku": [{"ext": "xml", "url": "https://comment.bilibili.com/38553060451.xml"}], "ai-zh": [{"ext": "srt", "data": "1\n00:00:00,860 --> 00:00:01,880\n同学们大家好\n\n2\n00:00:01,880 --> 00:00:03,060\n我是你们的子文老师\n\n3\n00:00:03,060 --> 00:00:04,760\n这堂课我们来学习一下\n\n4\n00:00:04,760 --> 00:00:08,640\n如何利用AI去生成一个小红书的种草文案\n\n5\n00:00:08,640 --> 00:00:11,440\n我们现在有一个新上市的保湿面霜\n\n6\n00:00:11,440 --> 00:00:14,390\n需要创作一篇小红书的种草笔记\n\n7\n00:00:14,390 --> 00:00:17,790\n目标是吸引25~35岁的都市女性\n\n8\n00:00:17,790 --> 00:00:18,790\n去进行购买\n\n9\n00:00:18,790 --> 00:00:22,090\n那么我们来看一下相应的大圆模型的提示词\n\n10\n00:00:22,090 --> 00:00:23,520\n应该怎么书写\n\n11\n00:00:23,520 --> 00:00:26,860\n我们把提示词粘贴到deep sick里\n\n12\n00:00:26,860 --> 00:00:28,080\n他是这么写的\n\n13\n00:00:28,080 --> 00:00:30,740\n请帮我创作一篇小红书的种草笔记\n\n14\n00:00:30,740 --> 00:00:35,900\n推荐的是基本原水漾清润保湿净化霜\n\n15\n00:00:35,900 --> 00:00:38,860\n然后下面呢是它的一些产品信息\n\n16\n00:00:38,860 --> 00:00:40,260\n包括价格\n\n17\n00:00:40,260 --> 00:00:41,140\n主要成分\n\n18\n00:00:41,140 --> 00:00:42,020\n产品特点\n\n19\n00:00:42,020 --> 00:00:43,040\n适用肤质\n\n20\n00:00:43,040 --> 00:00:47,080\n使个人使用个人使用一周以后是什么样的感受\n\n21\n00:00:47,080 --> 00:00:49,280\n那下面是具体的一些要求\n\n22\n00:00:49,280 --> 00:00:52,800\n第一个就是使用小红书平台的风格亲切自然\n\n23\n00:00:52,800 --> 00:00:56,430\n向朋友间的分享加入一些吸引人的表情符号\n\n24\n00:00:56,430 --> 00:00:58,190\n标题需要吸引眼球\n\n25\n00:00:58,190 --> 00:00:59,230\n制造惊喜感\n\n26\n00:00:59,230 --> 00:01:02,550\n内容结构分为开场吸引产品介绍\n\n27\n00:01:02,550 --> 00:01:03,390\n使用心得\n\n28\n00:01:03,390 --> 00:01:05,610\n效果展示和总结推荐\n\n29\n00:01:05,610 --> 00:01:09,090\n突出平价好用和改善肌肤屏障的卖点\n\n30\n00:01:09,090 --> 00:01:11,550\n字数要控制在800字以内\n\n31\n00:01:11,550 --> 00:01:16,230\n在文末要加入两两到三个相关话题的标签\n\n32\n00:01:16,230 --> 00:01:20,930\n好我们一起来看一下它能够怎么去书写\n\n33\n00:01:24,360 --> 00:01:25,760\n好它已经生成了啊\n\n34\n00:01:25,760 --> 00:01:27,060\n首先就是一个标题\n\n35\n00:01:27,060 --> 00:01:30,880\n震惊158元居然能买到贵妇级的保湿霜\n\n36\n00:01:30,880 --> 00:01:32,670\n干皮的姐妹速来\n\n37\n00:01:32,670 --> 00:01:34,530\n可以看到像这样的一个标题\n\n38\n00:01:34,530 --> 00:01:38,210\n是非常符合小红书种草笔记的这样一个风格的\n\n39\n00:01:38,210 --> 00:01:40,610\n然后下面的话呢是一个开场啊\n\n40\n00:01:40,610 --> 00:01:42,810\n就是姐妹们要挖到宝了啊\n\n41\n00:01:42,810 --> 00:01:43,530\n怎么怎么样\n\n42\n00:01:43,530 --> 00:01:47,400\n然后下面的话呢是这个产品的一些个介绍呃\n\n43\n00:01:47,400 --> 00:01:48,900\n这是什么神仙面霜\n\n44\n00:01:48,900 --> 00:01:52,260\n还有一周以后的真实反馈效果暴击\n\n45\n00:01:52,260 --> 00:01:53,800\n最后的是总结\n\n46\n00:01:53,800 --> 00:01:56,820\n那可以看到他这里面用了很多的\n\n47\n00:01:56,820 --> 00:01:58,640\n像这样的小表情符号啊\n\n48\n00:01:58,640 --> 00:02:00,480\n非常的呃可爱\n\n49\n00:02:00,480 --> 00:02:02,560\n而且呢能够引人注目\n\n50\n00:02:02,560 --> 00:02:06,120\n那么以上呢就是如何利用AI工具去\n\n51\n00:02:06,120 --> 00:02:09,020\n生成一个小红书的种草文案的方法\n\n52\n00:02:09,020 --> 00:02:10,780\n咱们大家学会了吗\n\n"}]}, "webpage_url": "https://www.bilibili.com/video/BV1D5Gi6QEN7?p=29", "webpage_url_base