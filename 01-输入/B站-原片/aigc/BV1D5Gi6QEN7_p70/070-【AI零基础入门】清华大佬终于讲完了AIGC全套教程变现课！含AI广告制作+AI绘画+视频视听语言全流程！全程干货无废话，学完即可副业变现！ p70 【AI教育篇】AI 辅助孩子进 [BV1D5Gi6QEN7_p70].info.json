7&uipk=5&og=cos&deadline=1780728293&oi=1875881457&nbs=1&gen=playurlv3&os=cosbv&upsig=e835c0722d7e00008091ea5c384b8194&uparams=e,trid,platform,mid,uipk,og,deadline,oi,nbs,gen,os&bvc=vod&nettype=0&bw=61372&lrs=0&agrr=0&buvid=56CBBADE-6E37-C95A-FAC9-97160BE6D01C13885infoc&build=0&dl=0&f=u_0_0&qn_dyeid=3346ba92b0ff010800e551d16a23a5c5&orderid=0,3", "ext": "mp4", "fps": 30.0, "width": 1280, "height": 720, "vcodec": "avc1.640033", "acodec": "none", "dynamic_range": "SDR", "tbr": 61.127, "quality": 64, "format_id": "30064", "format": "720P 准高清", "protocol": "https", "video_ext": "mp4", "audio_ext": "none", "abr": 0, "vbr": 61.127, "resolution": "1280x720", "aspect_ratio": 1.78, "filesize_approx": 1602818, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/138.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.bilibili.com/video/BV1D5Gi6QEN7?p=70"}}, {"url": "https://upos-sz-estgoss.bilivideo.com/upgcxcode/31/48/38553454831/38553454831-1-30080.m4s?e=ig8euxZM2rNcNbdlhoNvNC8BqJIzNbfqXBvEqxTEto8BTrNvN0GvT90W5JZMkX_YN0MvXg8gNEV4NC8xNEV4N03eN0B5tZlqNxTEto8BTrNvNeZVuJ10Kj_g2UB02J0mN0B5tZlqNCNEto8BTrNvNC7MTX502C8f2jmMQJ6mqF2fka1mqx6gqj0eN0B599M=&uipk=5&trid=e7f010e1e30545ebad54b58ec2df2a8u&platform=pc&mid=3546568672151587&oi=1875881457&nbs=1&deadline=1780728293&gen=playurlv3&os=estgoss&og=ali&upsig=0ee3af3b0729f34f2309c8afcc21b7e8&uparams=e,uipk,trid,platform,mid,oi,nbs,deadline,gen,os,og&bvc=vod&nettype=0&bw=111867&lrs=0&dl=0&f=u_0_0&qn_dyeid=3346ba92b0ff010800e551d16a23a5c5&agrr=0&buvid=56CBBADE-6E37-C95A-FAC9-97160BE6D01C13885infoc&build=0&orderid=0,3", "ext": "mp4", "fps": 30.0, "width": 1920, "height": 1080, "vcodec": "avc1.640033", "acodec": "none", "dynamic_range": "SDR", "tbr": 111.438, "quality": 80, "format_id": "30080", "format": "1080P 高清", "protocol": "https", "video_ext": "mp4", "audio_ext": "none", "abr": 0, "vbr": 111.438, "resolution": "1920x1080", "aspect_ratio": 1.78, "filesize_approx": 2922029, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/138.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.bilibili.com/video/BV1D5Gi6QEN7?p=70"}}], "duration": 209.769, "subtitles": {"danmaku": [{"ext": "xml", "url": "https://comment.bilibili.com/38553454831.xml"}], "ai-zh": [{"ext": "srt", "data": "1\n00:00:00,860 --> 00:00:01,700\n同学们大家好\n\n2\n00:00:01,700 --> 00:00:03,020\n我是你们的子文老师\n\n3\n00:00:03,020 --> 00:00:04,680\n这堂课我们来学习一下\n\n4\n00:00:04,680 --> 00:00:09,469\n如何利用AI工具辅助孩子进行艺术鉴赏的学习\n\n5\n00:00:09,469 --> 00:00:12,209\n你有没有试过带孩子去美术馆\n\n6\n00:00:12,209 --> 00:00:15,219\n站在一幅画前不到十秒钟他就走开了\n\n7\n00:00:15,219 --> 00:00:16,799\n然后你问你看到了什么呀\n\n8\n00:00:16,799 --> 00:00:17,859\n他说不知道\n\n9\n00:00:17,859 --> 00:00:19,020\n就是画嘛\n\n10\n00:00:19,020 --> 00:00:22,380\n很多家长可能会误以为孩子对艺术没有兴趣\n\n11\n00:00:22,380 --> 00:00:23,100\n看不懂\n\n12\n00:00:23,100 --> 00:00:24,160\n其实不是的\n\n13\n00:00:24,160 --> 00:00:27,180\n而是没有人教他应该怎么去看\n\n14\n00:00:27,180 --> 00:00:28,240\n更重要的是\n\n15\n00:00:28,240 --> 00:00:31,580\n没有人告诉我们应该怎么陪他们去看\n\n16\n00:00:31,580 --> 00:00:34,580\n艺术鉴赏不是解读的标准答案\n\n17\n00:00:34,580 --> 00:00:38,170\n而是一种视觉情感和思维的探索\n\n18\n00:00:38,170 --> 00:00:39,130\n问题在于\n\n19\n00:00:39,130 --> 00:00:41,430\n大多数的家长都缺少方法论\n\n20\n00:00:41,430 --> 00:00:42,630\n也缺少工具\n\n21\n00:00:42,630 --> 00:00:46,379\n那AI能不能成为这个共同的陪伴者呢\n\n22\n00:00:46,379 --> 00:00:50,879\n那么AI呢它其实不是代替你去讲解作品的背景\n\n23\n00:00:50,879 --> 00:00:53,499\n而是要帮你提出有趣的问题\n\n24\n00:00:53,499 --> 00:00:56,759\n问题引导孩子自己去发现细节\n\n25\n00:00:56,759 --> 00:00:59,210\n鼓励他们自己说出感受\n\n26\n00:00:59,210 --> 00:01:04,590\n换句话说是用AI把艺术变得可谈可干可玩\n\n27\n00:01:04,590 --> 00:01:07,370\n我们今天这一讲就是聚焦这一点\n\n28\n00:01:07,370 --> 00:01:10,910\n接下来我们用一个非常专业的提示词模板\n\n29\n00:01:10,910 --> 00:01:14,050\n去看一看整个过程是什么\n\n30\n00:01:14,300 --> 00:01:18,090\n我们把这段提示词直接给到deep sc\n\n31\n00:01:18,370 --> 00:01:20,110\n那么这里面他写的是\n\n32\n00:01:20,110 --> 00:01:22,810\n你是一位儿童艺术引导老师\n\n33\n00:01:22,810 --> 00:01:24,890\n请基于以下的艺术信息\n\n34\n00:01:24,890 --> 00:01:28,260\n艺术作品的信息为6~12岁的孩子\n\n35\n00:01:28,260 --> 00:01:30,620\n生成一组艺术对话\n\n36\n00:01:30,620 --> 00:01:31,670\n引导问题\n\n37\n00:01:31,670 --> 00:01:34,390\n目标是帮助孩子观察细节\n\n38\n00:01:34,390 --> 00:01:35,490\n表达情绪\n\n39\n00:01:35,490 --> 00:01:36,590\n启发思考\n\n40\n00:01:36,590 --> 00:01:37,890\n不需要标准答案\n\n41\n00:01:37,890 --> 00:01:39,830\n每个问题要简单易懂\n\n42\n00:01:39,830 --> 00:01:41,030\n具有启发性\n\n43\n00:01:41,030 --> 00:01:42,680\n适合亲子共读\n\n44\n00:01:42,680 --> 00:01:45,380\n请根据以下的结构说出五个问题\n\n45\n00:01:45,380 --> 00:01:46,880\n第一个呢是描述型\n\n46\n00:01:46,880 --> 00:01:49,740\n要引导孩子看到了什么感受型\n\n47\n00:01:49,740 --> 00:01:51,540\n引导孩子感觉如何\n\n48\n00:01:51,540 --> 00:01:53,180\n第三个呢是想象型\n\n49\n00:01:53,180 --> 00:01:55,180\n引导孩子展开想象\n\n50\n00:01:55,180 --> 00:01:56,160\n对比型\n\n51\n00:01:56,160 --> 00:01:58,540\n引导孩子联想与自己\n\n52\n00:01:58,540 --> 00:02:00,100\n第五个是反思型\n\n53\n00:02:00,100 --> 00:02:01,870\n引导孩子说出看法\n\n54\n00:02:01,870 --> 00:02:03,250\n作品的信息如下\n\n55\n00:02:03,250 --> 00:02:05,910\n当然呢这个作品我们是可以替换的啊\n\n56\n00:02:05,910 --> 00:02:07,750\n也就是名称是兴业\n\n57\n00:02:07,750 --> 00:02:09,169\n作者是梵高\n\n58\n00:02:09,169 --> 00:02:10,990\n风格是表现主义\n\n59\n00:02:10,990 --> 00:02:15,030\n内容是画面呈现夜空下小镇的风景\n\n60\n00:02:15,030 --> 00:02:17,620\n有旋转的星星和深蓝色的天空\n\n61\n00:02:17,620 --> 00:02:20,040\n那最后请说出五个问题\n\n62\n00:02:20,040 --> 00:02:21,820\n每个不要超过20个字\n\n63\n00:02:21,820 --> 00:02:25,030\n用儿童友好的语言去进行表达好\n\n64\n00:02:25,030 --> 00:02:27,970\n那我们来看一看像这样的一个提示词模板啊\n\n65\n00:02:27,970 --> 00:02:30,970\n它生成的是什么样子\n\n66\n00:02:39,520 --> 00:02:43,510\n好我们可以看到他先输出的是描述型\n\n67\n00:02:43,790 --> 00:02:44,570\n问孩子\n\n68\n00:02:44,570 --> 00:02:47,589\n你看到夜空中有哪些颜色和形状呢\n\n69\n00:02:47,589 --> 00:02:52,160\n感受型这样的星空让你的心情快乐还是安静\n\n70\n00:02:52,160 --> 00:02:53,140\n想象型\n\n71\n00:02:53,140 --> 00:02:54,440\n如果飞进画面里\n\n72\n00:02:54,440 --> 00:02:56,240\n你会摸到那些星星吗\n\n73\n00:02:56,240 --> 00:02:57,180\n对比型\n\n74\n00:02:57,180 --> 00:02:59,880\n你见过的夜空和画里是一样的吗\n\n75\n00:02:59,880 --> 00:03:00,720\n反思型\n\n76\n00:03:00,720 --> 00:03:04,240\n你觉得梵高为什么会把星星画成漩涡呢\n\n77\n00:03:04,240 --> 00:03:07,120\n你看像这样的几个问题的话\n\n78\n00:03:07,120 --> 00:03:08,590\n是不是就很生动啊\n\n79\n00:03:08,590 --> 00:03:12,430\n唉那么他是可以开发孩子的这种想象力\n\n80\n00:03:12,430 --> 00:03:14,720\n和他们的描述的能力的\n\n81\n00:03:14,720 --> 00:03:19,340\n用这样的方法去帮助孩子进行艺术鉴赏的学习\n\n82\n00:03:19,340 --> 00:03:21,410\n会非常的有效果好\n\n83\n00:03:21,410 --> 00:03:24,870\n那么以上呢就是如何利用AI工具去辅助孩子\n\n84\n00:03:24,870 --> 00:03:27,010\n进行艺术鉴赏学习的方法\n\n85\n00:03:27,010 --> 00:03:28,720\n咱们大家学会了吗\n\n"}]}, "webpage_url": "https://www.bilibili.com/video/BV1D5Gi6QEN7?p=70", "webpage_url_basename": "BV1D5Gi6QEN7", "webpage_url_domain": "bilibili.com", "extractor": "BiliBili", "extractor_key": "BiliBili", "playlist_count": 82, "playlist": "【AI零基础入门】清华大佬终于讲完了AIGC全套教程变现课！含AI广告制作+AI绘画+视频视听语言全流程！全程干货无废话，学完即可副业变现！", "playlist_id": "BV1D5Gi6QEN7", "playlist_title": "【AI零基础入门】清华大佬终于讲完了AIGC全套教程变现课！含AI广告制作+AI绘画+视频视听语言全流程！全程干货无废话，学完即可副业变现！", "playlist_webpage_url": "https://www.bilibili.com/video/BV1D5Gi6QEN7/", "n_entries": 64, "playlist_index": 70, "thumbnails": [{"url": "http://i2.hdslb.com/bfs/archive/ddf2b57576483ae9189affdcd82a8353a0b54e86.jpg", "id": "0"}], "display_id": "BV1D5Gi6QEN7_p70", "fulltitle": "【AI零基础入门】清华大佬终于讲完了AIGC全套教程变现课！含AI广告制作+AI绘画+视频视听语言全流程！全程干货无废话，学完即可副业变现！ p70 【AI教育篇】AI 辅助孩子进行艺术鉴赏学习", "duration_string": "3:29", "upload_date": "20260523", "epoch": 1780721102, "format": "1080P 高清+30280 - audio only", "format_id": "30080+30280", "ext": "mp4", "protocol": "https+https", "filesize_approx": 5180847, "tbr": 197.583, "width": 1920, "height": 1080, "resolution": "1920x1080", "fps": 30.0, "dynamic_range": "SDR", "vco