o_ext": "mp4", "audio_ext": "none", "abr": 0, "vbr": 165.816, "resolution": "1920x1080", "aspect_ratio": 1.78, "filesize_approx": 8779998, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/138.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.bilibili.com/video/BV1D5Gi6QEN7?p=64"}}], "duration": 423.602, "subtitles": {"danmaku": [{"ext": "xml", "url": "https://comment.bilibili.com/38553454385.xml"}], "ai-zh": [{"ext": "srt", "data": "1\n00:00:01,180 --> 00:00:02,020\n同学们大家好\n\n2\n00:00:02,020 --> 00:00:03,340\n我是你们子文老师\n\n3\n00:00:03,340 --> 00:00:05,060\n这堂课我们来学习一下\n\n4\n00:00:05,060 --> 00:00:09,739\n如何利用AI工具去辅助地理地图知识的学习\n\n5\n00:00:09,739 --> 00:00:12,759\n你小时候是不是也被地图搞得头大\n\n6\n00:00:12,759 --> 00:00:14,919\n什么五代线等高线\n\n7\n00:00:14,919 --> 00:00:17,619\n南北半球老师讲的飞起\n\n8\n00:00:17,619 --> 00:00:19,179\n但是咱们越听越懵\n\n9\n00:00:19,179 --> 00:00:20,859\n到底是地理太难呢\n\n10\n00:00:20,859 --> 00:00:23,840\n还是咱们这个脑子不适合看这个地图\n\n11\n00:00:23,840 --> 00:00:25,300\n其实不是你笨\n\n12\n00:00:25,300 --> 00:00:27,240\n而是这个方法不对\n\n13\n00:00:27,240 --> 00:00:31,060\n咱们地理学起来最需要的是空间的想象力\n\n14\n00:00:31,060 --> 00:00:32,900\n和多维的联想能力\n\n15\n00:00:32,900 --> 00:00:37,640\n但是咱们这个教材和课堂大多是用二维的死图\n\n16\n00:00:37,640 --> 00:00:39,370\n再加上抽象的知识\n\n17\n00:00:39,370 --> 00:00:42,490\n就好像你看着说明书去学跳舞\n\n18\n00:00:42,490 --> 00:00:43,870\n不尬才怪呢\n\n19\n00:00:43,870 --> 00:00:45,410\n但是现在不一样了\n\n20\n00:00:45,410 --> 00:00:48,060\nAI给我们悄悄的打开了一扇窗\n\n21\n00:00:48,060 --> 00:00:51,620\n你可以用一句话去生成一张地理的图景\n\n22\n00:00:51,620 --> 00:00:55,340\n也可以把文字知识变形成为一些个动态图\n\n23\n00:00:55,340 --> 00:00:57,830\n立体图和类游戏的任务\n\n24\n00:00:57,830 --> 00:01:02,130\n一句话就是地图它不一定非得靠死记硬背\n\n25\n00:01:02,130 --> 00:01:04,970\nAI是能够让地理知识动起来\n\n26\n00:01:04,970 --> 00:01:07,160\n亮起来火起来的\n\n27\n00:01:07,440 --> 00:01:10,400\n我们用AI去辅助地图学习\n\n28\n00:01:10,400 --> 00:01:12,440\n一共有三种打开方式\n\n29\n00:01:12,440 --> 00:01:16,680\n第一种呢就是图形变形到认知建构\n\n30\n00:01:16,680 --> 00:01:21,190\n也就是空间信息的AI可视化地形图\n\n31\n00:01:21,190 --> 00:01:22,710\n你看不懂没关系\n\n32\n00:01:22,710 --> 00:01:25,970\n输入坐标点加上等高线数据\n\n33\n00:01:25,970 --> 00:01:29,870\n让AI去帮你生成一张3D的地形图\n\n34\n00:01:29,870 --> 00:01:32,050\n那世界地图太抽象了\n\n35\n00:01:32,050 --> 00:01:32,890\n没关系\n\n36\n00:01:32,890 --> 00:01:35,430\n你可以用deep sick去帮你\n\n37\n00:01:35,430 --> 00:01:38,520\n拟人化的去描述这个五代的分布\n\n38\n00:01:38,520 --> 00:01:42,780\n比如说像赤道像腰带一样绕着地球一圈\n\n39\n00:01:42,780 --> 00:01:45,100\n两侧是热带的火圈\n\n40\n00:01:45,100 --> 00:01:46,560\n越远越冷静\n\n41\n00:01:46,560 --> 00:01:47,860\n成为寒带等等\n\n42\n00:01:48,980 --> 00:01:52,259\n第二点呢就是从知识点到故事线\n\n43\n00:01:52,259 --> 00:01:56,119\n用地图的内容给这个AI文本重写\n\n44\n00:01:56,119 --> 00:01:59,120\n把地图上标出什么北京啊\n\n45\n00:01:59,120 --> 00:01:59,940\n上海啊\n\n46\n00:01:59,940 --> 00:02:00,840\n广州啊\n\n47\n00:02:00,840 --> 00:02:03,140\n这类机械的任务变成什么呢\n\n48\n00:02:03,140 --> 00:02:06,710\n变成外星人参观中国城市这样的任务\n\n49\n00:02:06,710 --> 00:02:09,970\n用角色扮演加上路径的生成\n\n50\n00:02:09,970 --> 00:02:14,689\n趣味化的趣味化的去讲解整个一个过程\n\n51\n00:02:14,689 --> 00:02:17,470\n让你的记忆力同时进行提升\n\n52\n00:02:17,470 --> 00:02:20,730\nAI还能根据教材的内容去生成\n\n53\n00:02:20,730 --> 00:02:23,170\n像地理旅行对话剧本\n\n54\n00:02:23,170 --> 00:02:25,550\n让学生一边读一边演\n\n55\n00:02:25,550 --> 00:02:28,310\n这样的话记忆就更扎实\n\n56\n00:02:28,310 --> 00:02:33,570\n第三种就是从图题练习到解题思维\n\n57\n00:02:33,570 --> 00:02:36,400\n让AI助力分析推演\n\n58\n00:02:36,400 --> 00:02:41,560\n地理选择题经常出现像等高线加上水系流向\n\n59\n00:02:41,560 --> 00:02:44,160\n那你就可以用AI去画图\n\n60\n00:02:44,160 --> 00:02:45,310\n辅助推理\n\n61\n00:02:45,310 --> 00:02:49,170\n利用DPSICK去分析历年中高考地图\n\n62\n00:02:49,170 --> 00:02:51,330\n地图题的这种逻辑模式\n\n63\n00:02:51,330 --> 00:02:54,390\n让孩子掌握出题人的视角\n\n64\n00:02:54,390 --> 00:02:55,930\n那么像这样的能力\n\n65\n00:02:55,930 --> 00:02:59,430\n其实都不属于这个AI擅长的复杂分析\n\n66\n00:02:59,430 --> 00:03:03,450\n但是呢非常适合AI去做认知中介\n\n67\n00:03:03,450 --> 00:03:06,830\n也就是把静态的知识变得有互动感\n\n68\n00:03:06,830 --> 00:03:10,040\n让孩子先玩起来才能学得下去\n\n69\n00:03:10,040 --> 00:03:12,480\n那么接下来咱们通过一个例子\n\n70\n00:03:12,480 --> 00:03:15,060\n去说明以上的这样一个过程\n\n71\n00:03:15,060 --> 00:03:19,010\n我们把一段提示词给到deep sick\n\n72\n00:03:19,530 --> 00:03:20,530\n他是这么写的\n\n73\n00:03:20,530 --> 00:03:21,750\n你是一个地理教师\n\n74\n00:03:21,750 --> 00:03:23,730\n请根据以下的地理知识点\n\n75\n00:03:23,730 --> 00:03:27,250\n去生成一段图文并茂的教学内容\n\n76\n00:03:27,250 --> 00:03:29,180\n要求一共有四点\n\n77\n00:03:29,180 --> 00:03:32,380\n第一个呢就是以学生能够理解的生活场景\n\n78\n00:03:32,380 --> 00:03:33,360\n比喻开场\n\n79\n00:03:33,360 --> 00:03:35,240\n第二个是将地理知识\n\n80\n00:03:35,240 --> 00:03:38,600\n比如说像五代气候带板块构造等等\n\n81\n00:03:38,600 --> 00:03:41,980\n转化为画面感比较强的描述\n\n82\n00:03:41,980 --> 00:03:46,300\n第三个呢就是建议配图的图像的提示词呃\n\n83\n00:03:46,300 --> 00:03:50,310\n供MAJOURNEY等图像类的AI去进行使用\n\n84\n00:03:50,310 --> 00:03:52,270\n第四个就是用轻松自然\n\n85\n00:03:52,270 --> 00:03:55,990\n带点幽默的这样的语气去写知识点是什么呢\n\n86\n00:03:55,990 --> 00:03:58,360\n是全球气候带的分布\n\n87\n00:03:58,360 --> 00:04:00,920\n那像这个知识点我们是可以替换的啊\n\n88\n00:04:00,920 --> 00:04:03,000\n替换成别的这种知识点好\n\n89\n00:04:03,000 --> 00:04:05,220\n我们一起来看一看像这样一个问题\n\n90\n00:04:05,220 --> 00:04:07,600\ndeep sk怎么给我们解答\n\n91\n00:04:10,700 --> 00:04:13,260\n他写的这个题目是气候带大冒险\n\n92\n00:04:13,260 --> 00:04:14,480\n地球的温度\n\n93\n00:04:14,480 --> 00:04:15,220\n腰带大\n\n94\n00:04:15,220 --> 00:04:19,899\n公开开场比喻想象地球是一个爱臭美的小姐姐\n\n95\n00:04:19,899 --> 00:04:22,240\n围着五条不同颜色的温度腰带\n\n96\n00:04:22,240 --> 00:04:24,599\n有的像火焰一般的热情\n\n97\n00:04:24,599 --> 00:04:25,379\n在吃到\n\n98\n00:04:25,379 --> 00:04:27,499\n有的呢像薄荷糖一般的清爽\n\n99\n00:04:27,499 --> 00:04:28,359\n是温带\n\n100\n00:04:28,359 --> 00:04:30,599\n还有像冰箱里面的冻酸奶\n\n101\n00:04:30,599 --> 00:04:31,210\n吉利\n\n102\n00:04:31,210 --> 00:04:32,490\n今天呢我们来扒一扒\n\n103\n00:04:32,490 --> 00:04:34,470\n这些腰带是怎么影响天气的\n\n104\n00:04:34,470 --> 00:04:38,210\n第一个呢就是呃热带的火辣区是什么样子\n\n105\n00:04:38,210 --> 00:04:39,740\n有一个文字的描述\n\n106\n00:04:39,740 --> 00:04:42,929\n下面呢还有一段这种提示词的描写\n\n107\n00:04:42,929 --> 00:04:46,069\n然后还有温带的经分区哈\n\n108\n00:04:46,069 --> 00:04:47,689\n就是中纬度地区\n\n109\n00:04:47,689 --> 00:04:49,960\n然后下面还有这种提示词\n\n110\n00:04:49,960 --> 00:04:53,159\n哎每一个都是像这样的方式\n\n111\n00:04:53,159 --> 00:04:54,399\n那么像这样的方式\n\n112\n00:04:54,399 --> 00:04:56,859\n当时啊当然它是有呃文字描述\n\n113\n00:04:56,859 --> 00:04:59,019\n那么像这样的提示词的话\n\n114\n00:04:59,019 --> 00:05:00,850\n我们就可以把它复制下来\n\n115\n00:05:00,850 --> 00:05:04,450\n放到像集梦或者是MAD journey啊\n\n116\n00:05:04,450 --> 00:05:07,670\n这样的一个出图的软件里面\n\n117\n00:05:07,670 --> 00:05:11,010\n把它给到这样的出图的AI工具\n\n118\n00:05:11,010 --> 00:05:15,230\n然后再去把它的这个参数都给它设定到位\n\n119\n00:05:15,230 --> 00:05:18,020\n你说呃提示词粘贴到里面来\n\n120\n00:05:18,020 --> 00:05:20,380\n然后呢生图模型给他一个3.0\n\n121\n00:05:20,380 --> 00:05:23,720\n下面这个比例出图的比例16比九\n\n122\n00:05:23,720 --> 00:05:25,440\n然后直接点击生成就可以了啊\n\n123\n00:05:25,440 --> 00:05:26,860\n这个是集梦AI\n\n124\n00:05:26,860 --> 00:05:28,400\n那么点击完以后\n\n125\n00:05:28,400 --> 00:05:32,880\n在下面这个位置它就可以给你一次出四张图\n\n126\n00:05:32,880 --> 00:05:37,420\n描绘的就是刚才我们在DEVSC里面生成的这个\n\n127\n00:05:37,420 --> 00:05:40,250\n哎热带地区的画面途径\n\n128\n00:05:40,250 --> 00:05:41,510\n那么以此类推\n\n129\n00:05:41,510 --> 00:05:46,130\n下面你还可以去生成温带的这种途径等等\n\n130\n00:05:46,130 --> 00:05:47,560\n我们来看一下\n\n131\n00:05:47,560 --> 00:05:50,960\n你看这就是哎吉蒙给到我们的热带啊\n\n132\n00:05:50,960 --> 00:05:52,560\n热带雨林里面的感觉\n\n133\n00:05:52,560 --> 00:05:55,260\n那像这种温带的好\n\n134\n00:05:55,260 --> 00:05:58,220\n把这提示词同样粘贴过来\n\n135\n00:05:58,220 --> 00:05:59,500\n把原来的删掉啊\n\n136\n00:05:59,500 --> 00:06:00,820\n把新的粘过来\n\n137\n00:06:00,820 --> 00:06:02,080\n其他东西都不用变\n\n138\n00:06:02,080 --> 00:06:04,820\n然后直接点击立即生成\n\n139\n00:06:12,860 --> 00:06:14,440\n好你看哎\n\n140\n00:06:14,440 --> 00:06:16,420\n这马上他们的这种植被\n\n141\n00:06:16,420 --> 00:06:20,770\n还有这个整体的这种感觉都是不一样的\n\n142\n00:06:20,770 --> 00:06:22,370\n下面这个是寒带的\n\n143\n00:06:22,370 --> 00:06:24,110\n我们来看一下\n\n144\n00:06:29,680 --> 00:06:32,040\n好再来生成一遍\n\n145\n00:06:42,160 --> 00:06:45,200\nOK你看哎这样的话就是有极光\n\n146\n00:06:45,200 --> 00:06:46,320\n有企鹅啊\n\n147\n00:06:46,320 --> 00:06:47,970\n这就是属于寒带的\n\n148\n00:06:47,970 --> 00:06:49,450\n那么用这种方式呢\n\n149\n00:06:49,450 --> 00:06:51,910\n就可以图文并茂的去\n\n150\n00:06:51,910 --> 00:06:55,459\n让我们的学生去学习地理的知识好\n\n151\n00:06:55,459 --> 00:06:59,039\n那么以上呢就是如何利用AI工具去学习\n\n152\n00:06:59,039 --> 00:07:00,639\n地图知识的方法\n\n153\n00:07:00,639 --> 00:07:02,280\n咱们大家学会了吗\n\n"}]}, "webpage_url": "https://www.bilibili.com/video/BV1D5Gi6QEN7?p=64", "webpage_url_basename": "BV1D5Gi6QEN7", "webpage_url_domain": "bilibili.com", "extractor": "BiliBili", "extractor_key": "BiliBili", "playlist_count": 82, "playlist": "【AI零基础入门】清华大佬终于讲完了AIGC全套教程变现课！含AI广告制作+AI绘画+视频视听语言全流程！全程干货无废话，学完即可副业变现！", "playlist_id": "BV1D5Gi6QEN7", "playlist_title": "【AI零基础入门】清华大佬终于讲完了AIGC全套教程变现课！含AI广告制作+AI绘画+视频视听语言全流程！全程干货无废话，学完即可副业变现！", "playlist_webpage_url": "https://www.bilibili.com/video/BV1D5Gi6QEN7/", "n_entries": 64, "playlist_index": 64, "thumbnails": [{"url": "http://i2.hdslb.com/bfs/archive/ddf2b57576483ae9189affdcd82a8353a0b54e86.jpg", "id": "0"}], "display_id": "BV1D5Gi6QEN7_p64", "fulltitle": "【AI零基础入门】清华大佬终于讲完了AIGC全套教程变现课！含AI广告制作+AI绘画+视频视听语言全流程！全程干货无废话，学完即可副业变现！ p64 【AI视频创作】AI 辅助地理 - 地图知识学习", "duration_string": "7:03", "upload_date": "20260523", "epoch": 1780720782, "format": "1080P 高清+30280 - audio only", "format_id": "30080+30280", "ext": "mp4", "protocol": "https+https", "filesize_approx": 13438560, "tbr": 253.796, "width": 1920, "height": 1080, "resolution": "1920x1080", "fps": 30.0, "dynamic_range": "SDR", "vcodec": "avc1.640033", "vbr": 165.816, "aspect_ratio": 1.78, "acodec": "mp4a.40.2", "abr": 87.98, "_type": "video", "_version": {"version": "2026.03.17", "release_git_head": "04d6974f502bbdfaed72c624344f262e30ad9708", "repository": "yt-dlp/yt-dlp"}}