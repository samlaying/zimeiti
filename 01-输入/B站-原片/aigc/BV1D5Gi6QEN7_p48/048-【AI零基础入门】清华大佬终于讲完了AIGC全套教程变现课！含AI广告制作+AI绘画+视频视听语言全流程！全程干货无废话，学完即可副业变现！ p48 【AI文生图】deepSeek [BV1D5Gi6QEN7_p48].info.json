=1780726983&nbs=1&uipk=5&gen=playurlv3&oi=1733154763&os=akam&og=ali&upsig=206566934ea429d5d4be7ca551320d7a&uparams=e,platform,trid,mid,deadline,nbs,uipk,gen,oi,os,og&hdnts=exp=1780726983~hmac=06222b3d31586b43df899a66dceb9fdc4c25888c3fa6980b245c8f79b9b1d6dd&bvc=vod&nettype=0&bw=122082&lrs=0&build=0&dl=0&f=u_0_0&qn_dyeid=9c1e40225007576c003de62b6a23a0a7&agrr=0&buvid=56CBBADE-6E37-C95A-FAC9-97160BE6D01C13885infoc&orderid=0,2", "ext": "mp4", "fps": 30.0, "width": 1920, "height": 1080, "vcodec": "avc1.640033", "acodec": "none", "dynamic_range": "SDR", "tbr": 121.944, "quality": 80, "format_id": "30080", "format": "1080P 高清", "protocol": "https", "video_ext": "mp4", "audio_ext": "none", "abr": 0, "vbr": 121.944, "resolution": "1920x1080", "aspect_ratio": 1.78, "filesize_approx": 5279397, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/138.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.bilibili.com/video/BV1D5Gi6QEN7?p=48"}}], "duration": 346.349, "subtitles": {"danmaku": [{"ext": "xml", "url": "https://comment.bilibili.com/38553256953.xml"}], "ai-zh": [{"ext": "srt", "data": "1\n00:00:01,160 --> 00:00:02,080\n同学们大家好\n\n2\n00:00:02,080 --> 00:00:03,400\n我是你们的泽老师\n\n3\n00:00:03,400 --> 00:00:05,100\n这堂课我们来学习一下\n\n4\n00:00:05,100 --> 00:00:09,380\n如何利用deep sick去写一篇鲁迅风格的散文\n\n5\n00:00:09,700 --> 00:00:11,420\n你想写一篇有思想\n\n6\n00:00:11,420 --> 00:00:12,140\n有锋芒\n\n7\n00:00:12,140 --> 00:00:13,520\n有血性的文字\n\n8\n00:00:13,520 --> 00:00:16,990\n但是呢却只写出来一个温吞的白水\n\n9\n00:00:16,990 --> 00:00:18,670\n那像这样的问题\n\n10\n00:00:18,670 --> 00:00:21,510\n我们很多人可能都会比较迷茫\n\n11\n00:00:21,510 --> 00:00:24,120\n那很多人呢都想模仿鲁迅\n\n12\n00:00:24,120 --> 00:00:27,960\n都想从笔锋犀利这样的一种感觉去下手\n\n13\n00:00:27,960 --> 00:00:31,140\n结果呢写出来的要么是愤怒空洞\n\n14\n00:00:31,140 --> 00:00:34,670\n要么是想像是一个愤青的日记\n\n15\n00:00:34,990 --> 00:00:37,950\n真正的古训的风格并不只是批判\n\n16\n00:00:37,950 --> 00:00:39,970\n它是一种骨头里的疼痛\n\n17\n00:00:39,970 --> 00:00:41,330\n文字里有分寸\n\n18\n00:00:41,330 --> 00:00:43,650\n冷静中藏刀的一种写法\n\n19\n00:00:43,650 --> 00:00:45,170\n他敢写人血馒头\n\n20\n00:00:45,170 --> 00:00:46,970\n但是从不声嘶力竭\n\n21\n00:00:46,970 --> 00:00:48,130\n他谈希望\n\n22\n00:00:48,130 --> 00:00:51,790\n但也说地狱之门旁未必没有通路\n\n23\n00:00:51,790 --> 00:00:52,930\n他写母亲\n\n24\n00:00:52,930 --> 00:00:54,780\n但也写我是病人\n\n25\n00:00:54,780 --> 00:00:59,020\n这种散文的力量不是靠修辞去进行堆砌的\n\n26\n00:00:59,020 --> 00:01:00,720\n而是靠内里有火\n\n27\n00:01:00,720 --> 00:01:02,200\n外表克制\n\n28\n00:01:02,200 --> 00:01:04,160\n所以想要模仿鲁迅\n\n29\n00:01:04,160 --> 00:01:05,640\n不是模仿情绪\n\n30\n00:01:05,640 --> 00:01:08,360\n而是要模仿他的结构和思想\n\n31\n00:01:08,360 --> 00:01:09,620\n不是愤怒\n\n32\n00:01:09,620 --> 00:01:11,720\n而是看透后的冷静\n\n33\n00:01:11,720 --> 00:01:12,920\n不是去骂\n\n34\n00:01:12,920 --> 00:01:15,520\n而是点到为止的讽刺\n\n35\n00:01:15,520 --> 00:01:19,060\n今天咱们这堂课就是要来做一件挺酷的事\n\n36\n00:01:19,060 --> 00:01:23,030\n就是用AI工具去写一篇像鲁迅那样的散文\n\n37\n00:01:23,030 --> 00:01:24,590\n冷静深刻\n\n38\n00:01:24,590 --> 00:01:27,030\n用语句去咬人\n\n39\n00:01:27,390 --> 00:01:31,730\n那我们首先要来分析一下鲁迅的散文的风格\n\n40\n00:01:31,730 --> 00:01:34,470\n他一共呢是有四个关键词的\n\n41\n00:01:34,470 --> 00:01:36,890\n第一个就是现实的嵌套感\n\n42\n00:01:36,890 --> 00:01:40,820\n也就是非虚构的一种强现实的依托\n\n43\n00:01:40,820 --> 00:01:43,240\n他从不写虚空的情绪\n\n44\n00:01:43,240 --> 00:01:46,720\n而是从街头庙会教室\n\n45\n00:01:46,720 --> 00:01:50,560\n像这样的现实中的物品去进行切入\n\n46\n00:01:50,560 --> 00:01:53,580\n每篇都有具体的一个现实的锚点\n\n47\n00:01:53,580 --> 00:01:57,140\n比如说一个人一件事或者是一句话\n\n48\n00:01:57,140 --> 00:01:59,440\n第二个关键词就是冷面\n\n49\n00:02:01,729 --> 00:02:05,449\n鲁迅常写我不过是什么什么\n\n50\n00:02:05,449 --> 00:02:09,820\n其实是其其实写的是你不过是什么什么\n\n51\n00:02:09,820 --> 00:02:13,329\n经常使用的明明是赞美的一个语调\n\n52\n00:02:13,329 --> 00:02:15,969\n包裹着不动声色的批判\n\n53\n00:02:15,969 --> 00:02:19,480\n是用一种反语和反常识的方式\n\n54\n00:02:19,680 --> 00:02:23,200\n第三个关键关键词呢就是个体切口\n\n55\n00:02:23,200 --> 00:02:25,600\n含有大众的影子\n\n56\n00:02:25,600 --> 00:02:27,560\n常用第一人称我\n\n57\n00:02:27,560 --> 00:02:30,460\n但其实这个我呢从不私人\n\n58\n00:02:30,460 --> 00:02:33,800\n有的时候他写我小时候看戏的经历\n\n59\n00:02:33,800 --> 00:02:35,440\n但事实上你读完以后\n\n60\n00:02:35,440 --> 00:02:38,910\n觉得全中国的孩子可能都是这样被教的\n\n61\n00:02:39,070 --> 00:02:41,210\n第四个关键词就是语言\n\n62\n00:02:41,210 --> 00:02:45,320\n平直语式讲究的是韧和领\n\n63\n00:02:45,320 --> 00:02:48,800\n你很少能见到它用成堆的这种比喻\n\n64\n00:02:48,800 --> 00:02:53,320\n但是呢句式常是有顿挫感和收紧感的\n\n65\n00:02:53,320 --> 00:02:55,860\n形成一种心理上的压迫感\n\n66\n00:02:55,860 --> 00:02:57,280\n多用短句\n\n67\n00:02:57,280 --> 00:03:02,120\n多用盾住加回刀的这样一种结构好\n\n68\n00:03:02,120 --> 00:03:03,080\n那么接下来呢\n\n69\n00:03:03,080 --> 00:03:07,380\n我们通过一个提示词模板去看一下\n\n70\n00:03:07,380 --> 00:03:08,580\n像这样的风格\n\n71\n00:03:08,580 --> 00:03:10,440\n咱们应该怎么写\n\n72\n00:03:10,680 --> 00:03:13,580\n我们把这段提示词给到deep sick\n\n73\n00:03:13,580 --> 00:03:15,530\n可以看到它是这么写的啊\n\n74\n00:03:15,530 --> 00:03:17,670\n请你模仿鲁迅的文风\n\n75\n00:03:17,670 --> 00:03:20,130\n创作一篇1000字以内的散文\n\n76\n00:03:20,130 --> 00:03:21,490\n写法的要求\n\n77\n00:03:21,490 --> 00:03:24,870\n第一个开头需要从一个现实的细节出发\n\n78\n00:03:24,870 --> 00:03:27,030\n比如说像童年的经历啦\n\n79\n00:03:27,030 --> 00:03:28,130\n社会的观察\n\n80\n00:03:28,130 --> 00:03:29,300\n街头的小事\n\n81\n00:03:29,300 --> 00:03:31,240\n然后引出主题\n\n82\n00:03:31,240 --> 00:03:33,600\n第二个使用第一人称视角\n\n83\n00:03:33,600 --> 00:03:37,100\n但是内容的指向性应该具有普遍性\n\n84\n00:03:37,100 --> 00:03:38,610\n不可私人化\n\n85\n00:03:38,610 --> 00:03:41,410\n第三个就是语言风格要冷静克制\n\n86\n00:03:41,410 --> 00:03:42,410\n有压迫感\n\n87\n00:03:42,410 --> 00:03:44,070\n避免情绪的外露\n\n88\n00:03:44,070 --> 00:03:48,360\n第四个多使用反语对比递进\n\n89\n00:03:48,360 --> 00:03:50,980\n还有短句切分等等手法\n\n90\n00:03:50,980 --> 00:03:52,980\n可以看到像这样的需求\n\n91\n00:03:52,980 --> 00:03:56,510\n就是鲁迅写文的这种感觉\n\n92\n00:03:56,510 --> 00:04:00,910\n那写作的主题就是小镇中被吹捧的孝子\n\n93\n00:04:00,910 --> 00:04:04,790\n行为的背后藏着怎样的社会的冷漠与控制\n\n94\n00:04:04,790 --> 00:04:07,050\n那像下面的这个标题\n\n95\n00:04:07,050 --> 00:04:09,910\n我们是可以替换成自己的内容的\n\n96\n00:04:09,910 --> 00:04:13,070\n好我们来看一下像这样的一个主题\n\n97\n00:04:13,070 --> 00:04:15,830\n他写出来是什么样\n\n98\n00:04:18,759 --> 00:04:20,970\n标题是孝子杯\n\n99\n00:04:21,450 --> 00:04:23,910\n街口新立了一座石碑\n\n100\n00:04:23,910 --> 00:04:25,730\n青白颜色\n\n101\n00:04:25,730 --> 00:04:28,670\n上头刻着孝子故里四个大字\n\n102\n00:04:28,670 --> 00:04:30,450\n我初见此悲时\n\n103\n00:04:30,450 --> 00:04:33,390\n正逢镇上老槐树落花\n\n104\n00:04:33,390 --> 00:04:36,270\n细碎的白蕊飘在杯面上\n\n105\n00:04:36,270 --> 00:04:41,049\n倒像是给那给食客的文字敷了层粉\n\n106\n00:04:41,049 --> 00:04:43,509\n碑文记载的是张家的儿子\n\n107\n00:04:43,509 --> 00:04:46,919\n此人每日晨起为母到密契\n\n108\n00:04:46,919 --> 00:04:48,279\n三跪九叩\n\n109\n00:04:48,279 --> 00:04:49,519\n夏日打扇\n\n110\n00:04:49,519 --> 00:04:51,760\n冬日暖被10年不辍\n\n111\n00:04:51,760 --> 00:04:53,500\n镇上人说起\n\n112\n00:04:53,500 --> 00:04:54,980\n莫不交口称赞\n\n113\n00:04:54,980 --> 00:04:57,960\n连县太爷也轻提了孝感\n\n114\n00:04:57,960 --> 00:05:00,490\n孝感动天的匾额\n\n115\n00:05:00,490 --> 00:05:02,610\n我见过那孝子一回\n\n116\n00:05:02,610 --> 00:05:03,930\n40上下的人\n\n117\n00:05:03,930 --> 00:05:06,710\n腰却弯得如同晒干的虾米\n\n118\n00:05:06,710 --> 00:05:08,630\n眼睛总盯着地面\n\n119\n00:05:08,630 --> 00:05:12,200\n仿佛那里写着为人子的章程\n\n120\n00:05:12,200 --> 00:05:14,080\n很有鲁迅的感觉\n\n121\n00:05:14,080 --> 00:05:15,440\n是不是哎\n\n122\n00:05:15,440 --> 00:05:20,030\n所以说呢我们如果想要写某一个人的文风的话\n\n123\n00:05:20,030 --> 00:05:23,270\n首先就要先去分析他的这个文风\n\n124\n00:05:23,270 --> 00:05:24,900\n是一种什么样的特点\n\n125\n00:05:24,900 --> 00:05:26,380\n那么总结以后呢\n\n126\n00:05:29,900 --> 00:05:32,660\n然后再去写你的主题是什么\n\n127\n00:05:32,660 --> 00:05:36,800\n这样的话AI工具就可以模仿他的文风了\n\n128\n00:05:36,800 --> 00:05:37,280\n好\n\n129\n00:05:37,280 --> 00:05:41,300\n那么以上呢就是如何利用AI工具去写一篇\n\n130\n00:05:41,300 --> 00:05:43,260\n鲁迅风格的散文的方法\n\n131\n00:05:43,260 --> 00:05:44,980\n咱们大家学会了吗\n\n"}]}, "webpage_url": "https://www.bilibili.com/video/BV1D5Gi6QEN7?p=48", "webpage_url_basename": "BV1D5Gi6QEN7", "webpage_url_domain": "bilibili.com", "extractor": "BiliBili", "extractor_key": "BiliBili", "playlist_count": 82, "playlist": "【AI零基础入门】清华大佬终于讲完了AIGC全套教程变现课！含AI广告制作+AI绘画+视频视听语言全流程！全程干货无废话，学完即可副业变现！", "playlist_id": "BV1D5Gi6QEN7", "playlist_title": "【AI零基础入门】清华大佬终于讲完了AIGC全套教程变现课！含AI广告制作+AI绘画+视频视听语言全流程！全程干货无废话，学完即可副业变现！", "playlist_webpage_url": "https://www.bilibili.com/video/BV1D5Gi6QEN7/", "n_entries": 64, "playlist_index": 48, "thumbnails": [{"url": "http://i2.hdslb.com/bfs/archive/ddf2b57576483ae9189affdcd82a8353a0b54e86.jpg", "id": "0"}], "display_id": "BV1D5Gi6QEN7_p48", "fulltitle": "【AI零基础入门】清华大佬终于讲完了AIGC全套教程变现课！含AI广告制作+AI绘画+视频视听语言全流程！全程干货无废话，学完即可副业变现！ p48 【AI文生图】deepSeek文风写作-写一篇鲁迅风格的散文", "duration_string": "5:46", "upload_date": "20260523", "epoch": 1780719800, "format": "1080P 高清+30280 - audio only", "format_id": "30080+30280", "ext": "mp4", "protocol": "https+https", "filesize_approx": 9113740, "tbr": 210.51, "width": 1920, "height": 1080, "resolution": "1920x1080", "fps": 30.0, "dynamic_range": "SDR", "vcodec": "avc1.640033", "vbr": 121.944, "aspect_ratio": 1.78, "acodec": "mp4a.40.2", "abr": 88.566, "_type": "video", "_version": {"version": "2026.03.17", "release_git_head": "04d6974f502bbdfaed72c624344f262e30ad9708", "repository": "yt-dlp/yt-dlp"}}