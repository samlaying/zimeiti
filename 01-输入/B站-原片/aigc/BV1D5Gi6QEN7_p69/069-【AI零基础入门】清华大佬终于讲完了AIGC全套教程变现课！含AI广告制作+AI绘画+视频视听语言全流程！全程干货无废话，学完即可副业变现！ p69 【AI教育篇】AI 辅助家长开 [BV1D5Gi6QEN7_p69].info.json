&gen=playurlv3&os=estgcos&og=cos&trid=82f787989b5f44bfbd6641bc4e45b56u&platform=pc&upsig=ffe896ec7132b2781d06c81825be1e4e&uparams=e,oi,deadline,nbs,uipk,mid,gen,os,og,trid,platform&bvc=vod&nettype=0&bw=71626&lrs=0&dl=0&f=u_0_0&qn_dyeid=d7d17ba2a48dd77f00a3fedb6a23a58a&agrr=0&buvid=56CBBADE-6E37-C95A-FAC9-97160BE6D01C13885infoc&build=0&orderid=0,3", "ext": "mp4", "fps": 30.0, "width": 1280, "height": 720, "vcodec": "avc1.640033", "acodec": "none", "dynamic_range": "SDR", "tbr": 71.583, "quality": 64, "format_id": "30064", "format": "720P 准高清", "protocol": "https", "video_ext": "mp4", "audio_ext": "none", "abr": 0, "vbr": 71.583, "resolution": "1280x720", "aspect_ratio": 1.78, "filesize_approx": 2926849, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/138.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.bilibili.com/video/BV1D5Gi6QEN7?p=69"}}, {"url": "https://upos-sz-mirrorcos.bilivideo.com/upgcxcode/05/48/38553454805/38553454805-1-30080.m4s?e=ig8euxZM2rNcNbdlhoNvNC8BqJIzNbfqXBvEqxTEto8BTrNvN0GvT90W5JZMkX_YN0MvXg8gNEV4NC8xNEV4N03eN0B5tZlqNxTEto8BTrNvNeZVuJ10Kj_g2UB02J0mN0B5tZlqNCNEto8BTrNvNC7MTX502C8f2jmMQJ6mqF2fka1mqx6gqj0eN0B599M=&trid=82f787989b5f44bfbd6641bc4e45b56u&deadline=1780728234&os=cosbv&platform=pc&gen=playurlv3&og=cos&nbs=1&uipk=5&mid=3546568672151587&oi=1875881457&upsig=498bbcc9021ead1de8beeff5a6ee79f2&uparams=e,trid,deadline,os,platform,gen,og,nbs,uipk,mid,oi&bvc=vod&nettype=0&bw=133553&lrs=0&qn_dyeid=d7d17ba2a48dd77f00a3fedb6a23a58a&agrr=0&buvid=56CBBADE-6E37-C95A-FAC9-97160BE6D01C13885infoc&build=0&dl=0&f=u_0_0&orderid=0,3", "ext": "mp4", "fps": 30.0, "width": 1920, "height": 1080, "vcodec": "avc1.640033", "acodec": "none", "dynamic_range": "SDR", "tbr": 133.491, "quality": 80, "format_id": "30080", "format": "1080P 高清", "protocol": "https", "video_ext": "mp4", "audio_ext": "none", "abr": 0, "vbr": 133.491, "resolution": "1920x1080", "aspect_ratio": 1.78, "filesize_approx": 5458113, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/138.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.bilibili.com/video/BV1D5Gi6QEN7?p=69"}}], "duration": 327.1, "subtitles": {"danmaku": [{"ext": "xml", "url": "https://comment.bilibili.com/38553454805.xml"}], "ai-zh": [{"ext": "srt", "data": "1\n00:00:00,940 --> 00:00:01,780\n同学们大家好\n\n2\n00:00:01,780 --> 00:00:03,080\n我是你们子文老师\n\n3\n00:00:03,080 --> 00:00:04,700\n这堂课我们来学习一下\n\n4\n00:00:04,700 --> 00:00:09,270\n如何利用AI工具去辅助家长开展心理健康教育\n\n5\n00:00:09,270 --> 00:00:12,390\n先说一个你可能不太敢细想的现实\n\n6\n00:00:12,390 --> 00:00:15,810\n你家的孩子可能正在悄悄的情绪溺水\n\n7\n00:00:15,810 --> 00:00:17,550\n而你却一点没有发现\n\n8\n00:00:17,550 --> 00:00:18,890\n不是你不爱他\n\n9\n00:00:18,890 --> 00:00:21,050\n而是你压根儿不知道看哪里\n\n10\n00:00:21,050 --> 00:00:23,190\n孩子不说不代表他没事儿\n\n11\n00:00:23,190 --> 00:00:24,990\n每天放学回来不想说话\n\n12\n00:00:24,990 --> 00:00:26,070\n动不动就发火\n\n13\n00:00:26,070 --> 00:00:27,090\n不想社交\n\n14\n00:00:27,090 --> 00:00:28,050\n考试前呢\n\n15\n00:00:28,050 --> 00:00:29,840\n晚上不也晚上就睡不着\n\n16\n00:00:29,840 --> 00:00:31,320\n这些都有可能是\n\n17\n00:00:31,320 --> 00:00:34,090\n他的心理健康已经拉响了黄灯了\n\n18\n00:00:34,090 --> 00:00:35,630\n过去你可能会想\n\n19\n00:00:35,630 --> 00:00:36,470\n别焦急\n\n20\n00:00:36,470 --> 00:00:38,570\n这不是正常的这种发育阶段吗\n\n21\n00:00:38,570 --> 00:00:40,110\n我小的时候也是这样\n\n22\n00:00:40,110 --> 00:00:41,300\n长大了就好了\n\n23\n00:00:41,300 --> 00:00:42,460\n但问题来了\n\n24\n00:00:42,460 --> 00:00:46,019\n现在的孩子面对的不是我们那个年代的世界了\n\n25\n00:00:46,019 --> 00:00:47,419\n社交平台的压力\n\n26\n00:00:47,419 --> 00:00:48,399\n升学的竞争\n\n27\n00:00:48,399 --> 00:00:51,739\n父母的期待叠加在一个十几岁的这种脑袋上\n\n28\n00:00:51,739 --> 00:00:53,599\n很多孩子真是扛不住\n\n29\n00:00:53,599 --> 00:00:56,260\n但是呢他又学不会开口去求助\n\n30\n00:00:56,260 --> 00:00:57,540\n那作为咱们家长\n\n31\n00:00:57,540 --> 00:00:59,700\n我们到底应该能做些什么\n\n32\n00:00:59,700 --> 00:01:01,540\n我们又不是心理咨询师\n\n33\n00:01:01,540 --> 00:01:03,420\n又不懂这种测量量表\n\n34\n00:01:03,420 --> 00:01:04,769\n不懂专业语言\n\n35\n00:01:04,769 --> 00:01:07,550\n但是呢我们可以多一个知觉的工具\n\n36\n00:01:07,550 --> 00:01:09,970\n一个识别早期信号的能力\n\n37\n00:01:09,970 --> 00:01:12,449\n就是用AI去帮忙\n\n38\n00:01:12,449 --> 00:01:14,929\nAI不是来教育你怎么做父母的\n\n39\n00:01:14,929 --> 00:01:17,769\n而是让你在日常生活里能够更早的\n\n40\n00:01:17,769 --> 00:01:19,840\n更多维的读懂孩子\n\n41\n00:01:19,840 --> 00:01:22,580\n那么接下来我们用一个非常好用\n\n42\n00:01:22,580 --> 00:01:25,040\n专业而又通用的提示词的模板\n\n43\n00:01:25,040 --> 00:01:27,030\n去进行以下的过程\n\n44\n00:01:27,030 --> 00:01:31,220\n我们把这个提示词的模板复制给deep sick\n\n45\n00:01:31,220 --> 00:01:32,800\n可以看到他是这么写的\n\n46\n00:01:32,800 --> 00:01:35,300\n你是一名专业的心理咨询师\n\n47\n00:01:35,300 --> 00:01:37,740\n请以家长助理的身份协助我们\n\n48\n00:01:37,740 --> 00:01:41,850\n分析以下家庭情境中孩子可能存在的心理状态\n\n49\n00:01:41,850 --> 00:01:44,070\n并且提供这种沟通的建议\n\n50\n00:01:44,070 --> 00:01:47,770\n避免标签化与下互式的表述输出\n\n51\n00:01:47,770 --> 00:01:49,150\n请分成三个部分\n\n52\n00:01:49,150 --> 00:01:51,960\n第一个就是可能的心理信号的解释\n\n53\n00:01:51,960 --> 00:01:53,600\n要保持中立细致\n\n54\n00:01:53,600 --> 00:01:54,680\n非诊断性的\n\n55\n00:01:54,680 --> 00:01:57,900\n第二个是家长可用的沟通的引导语\n\n56\n00:01:57,900 --> 00:02:01,380\n第三个可以推荐的日常亲子互动的方式\n\n57\n00:02:01,380 --> 00:02:03,220\n帮助情绪的舒缓\n\n58\n00:02:03,220 --> 00:02:06,539\n那么下面呢是一个孩子情况的描述啊\n\n59\n00:02:06,539 --> 00:02:09,519\n比如说孩子最近晚上总是翻来覆去睡不着\n\n60\n00:02:09,519 --> 00:02:10,499\n说不想上学\n\n61\n00:02:10,499 --> 00:02:11,819\n吃饭也没有胃口\n\n62\n00:02:12,279 --> 00:02:15,840\n或者是最近中午就下午放学回家也不说话\n\n63\n00:02:15,840 --> 00:02:16,580\n也不吃饭\n\n64\n00:02:16,580 --> 00:02:17,600\n问他什么事呢\n\n65\n00:02:17,600 --> 00:02:18,520\n他也是沉默\n\n66\n00:02:18,520 --> 00:02:19,800\n或者是冷冷的\n\n67\n00:02:19,800 --> 00:02:20,460\n就回一句\n\n68\n00:02:20,460 --> 00:02:20,960\n烦死了\n\n69\n00:02:20,960 --> 00:02:21,670\n别问了\n\n70\n00:02:21,670 --> 00:02:23,470\n但以前他不是这样啊\n\n71\n00:02:23,470 --> 00:02:23,910\n就等等\n\n72\n00:02:23,910 --> 00:02:25,150\n像这样的情况描述\n\n73\n00:02:25,150 --> 00:02:26,649\n你给它写上去\n\n74\n00:02:26,649 --> 00:02:27,449\n写上完序\n\n75\n00:02:27,449 --> 00:02:28,849\n完事以后在这里面啊\n\n76\n00:02:28,849 --> 00:02:32,049\n这个如咱们就不用写了\n\n77\n00:02:33,520 --> 00:02:36,200\n把前面的都给它删掉\n\n78\n00:02:37,370 --> 00:02:41,250\n好这样的话呢我们就可以直接发送了\n\n79\n00:02:47,720 --> 00:02:50,600\n这样的话他就可以给你生成\n\n80\n00:02:50,600 --> 00:02:52,800\n第一个可能的心理信号的解析\n\n81\n00:02:52,800 --> 00:02:55,300\n一个呢是情绪压力或者焦虑\n\n82\n00:02:55,300 --> 00:02:57,940\n孩子可能是因为学习学业的压力\n\n83\n00:02:57,940 --> 00:03:00,240\n像社交关系或者环境的变化\n\n84\n00:03:00,240 --> 00:03:02,300\n比如说像这个班级调整啊\n\n85\n00:03:02,300 --> 00:03:03,040\n考试啊\n\n86\n00:03:03,040 --> 00:03:03,980\n感到不安\n\n87\n00:03:03,980 --> 00:03:05,680\n导致入睡困难\n\n88\n00:03:05,680 --> 00:03:06,690\n食欲下降\n\n89\n00:03:06,690 --> 00:03:08,770\n第二个呢就是安全感的缺失\n\n90\n00:03:08,770 --> 00:03:10,130\n夜间难以入睡\n\n91\n00:03:10,130 --> 00:03:14,050\n可能反映出独处或者某些情境的隐性的担忧\n\n92\n00:03:14,050 --> 00:03:17,440\n比如说怕黑或者怕做噩梦而不想上学\n\n93\n00:03:17,440 --> 00:03:20,060\n可能是逃避压力源的一个信号\n\n94\n00:03:20,060 --> 00:03:23,120\n第三个呢就是身体或者精神状态的一个变化\n\n95\n00:03:23,120 --> 00:03:25,460\n睡眠和食欲的问题有可能是生理因素\n\n96\n00:03:25,460 --> 00:03:26,520\n比如说生长阶段\n\n97\n00:03:26,520 --> 00:03:29,500\n他有轻微的不适或者作息紊乱等等有关\n\n98\n00:03:29,500 --> 00:03:32,110\n需要结合其他的这种表现去观察\n\n99\n00:03:32,110 --> 00:03:34,950\n当然要注意避免定义为像厌学啊\n\n100\n00:03:34,950 --> 00:03:35,650\n焦虑症啊\n\n101\n00:03:35,650 --> 00:03:37,690\n是需要持续一段时间\n\n102\n00:03:37,690 --> 00:03:39,570\n具体事件进一步了解的\n\n103\n00:03:39,570 --> 00:03:42,170\n那么下面呢这是上面一个是解析啊\n\n104\n00:03:42,170 --> 00:03:45,340\n下面是一个家长可用的引导沟通语\n\n105\n00:03:45,340 --> 00:03:47,280\n可以是开放式的提问\n\n106\n00:03:47,280 --> 00:03:49,200\n就你最近睡觉的时候有点不安\n\n107\n00:03:49,200 --> 00:03:53,110\n你愿意跟我说说是什么让你觉得难以入睡吗\n\n108\n00:03:53,110 --> 00:03:54,910\n或者是你提到不想上学\n\n109\n00:03:54,910 --> 00:03:56,550\n是学校里面发生什么了\n\n110\n00:03:56,550 --> 00:03:58,870\n还是有什么事让你觉得有压力对吧\n\n111\n00:03:58,870 --> 00:04:00,730\n还有就是共情和接纳嗯\n\n112\n00:04:00,730 --> 00:04:03,190\n你可以说有的时候睡不着或者不想吃饭\n\n113\n00:04:03,190 --> 00:04:04,530\n确实挺让人难受的\n\n114\n00:04:04,530 --> 00:04:06,050\n我小时候也有这种阶段\n\n115\n00:04:06,050 --> 00:04:08,079\n需要我陪你一起想想办法吗\n\n116\n00:04:08,079 --> 00:04:09,879\n但是在这里面这种问法啊\n\n117\n00:04:09,879 --> 00:04:11,380\n咱们大家可不要说\n\n118\n00:04:11,380 --> 00:04:14,180\n我完全照着他照本宣科去这么念\n\n119\n00:04:14,180 --> 00:04:15,200\n因为有的时候呢\n\n120\n00:04:15,200 --> 00:04:18,200\n他这里面这个话讲的还是有点书面用语\n\n121\n00:04:18,200 --> 00:04:21,980\n我们大家要用更加自然的生活化的语气\n\n122\n00:04:21,980 --> 00:04:23,500\n去跟孩子沟通\n\n123\n00:04:23,500 --> 00:04:25,900\n还有像你现在的感受很重要\n\n124\n00:04:25,900 --> 00:04:26,740\n我们可以慢慢聊\n\n125\n00:04:26,740 --> 00:04:27,820\n不着急啊\n\n126\n00:04:27,820 --> 00:04:29,630\n避免施压和否定\n\n127\n00:04:29,630 --> 00:04:30,770\n这一点很重要\n\n128\n00:04:30,770 --> 00:04:32,730\n因为我们现在中国式家长\n\n129\n00:04:32,730 --> 00:04:34,870\n就有一种这样的惯性的模式\n\n130\n00:04:34,870 --> 00:04:38,130\n都是用否定或者是打压的方式跟孩子沟通\n\n131\n00:04:38,130 --> 00:04:39,590\n这其实是很不好的\n\n132\n00:04:39,590 --> 00:04:42,790\n所以呢你可以说嗯你你千万不要说\n\n133\n00:04:42,790 --> 00:04:44,030\n就是你就是想偷懒\n\n134\n00:04:44,030 --> 00:04:44,730\n不想上学\n\n135\n00:04:44,730 --> 00:04:46,320\n好像这样的话哦\n\n136\n00:04:46,320 --> 00:04:49,480\n或者你可以改为就是上学的时候确实会很累\n\n137\n00:04:49,480 --> 00:04:52,040\n你觉得哪一部分最让你提不起精神对吧\n\n138\n00:04:52,040 --> 00:04:53,380\n像这样的一个话的话\n\n139\n00:04:53,380 --> 00:04:55,370\n就更好沟通下去了\n\n140\n00:04:55,370 --> 00:04:57,570\n那么下面还会有一些可以推荐的\n\n141\n00:04:57,570 --> 00:04:59,570\n日常的亲子互动方式\n\n142\n00:04:59,570 --> 00:05:01,990\n比如说建立舒缓的睡前仪式啊\n\n143\n00:05:01,990 --> 00:05:04,810\n通过非语言活动去疏导情绪对吧\n\n144\n00:05:04,810 --> 00:05:06,430\n调节生活的节奏等等\n\n145\n00:05:06,430 --> 00:05:09,390\n我相信通过像这样的AI工具\n\n146\n00:05:09,390 --> 00:05:12,150\n给我们大家提供这样一个帮助\n\n147\n00:05:12,150 --> 00:05:13,090\n建议的话\n\n148\n00:05:13,090 --> 00:05:16,690\n那可以让我们更好的和孩子去建立沟通\n\n149\n00:05:16,690 --> 00:05:19,510\n可以改善他们的心理健康好\n\n150\n00:05:19,510 --> 00:05:23,030\n那么以上呢就是如何利用AI工具去辅助家长\n\n151\n00:05:23,030 --> 00:05:25,070\n开展心理健康教育的方法\n\n152\n00:05:25,070 --> 00:05:26,680\n咱们大家学会了吗\n\n"}]}, "webpage_url": "https://www.bilibili.com/video/BV1D5Gi6QEN7?p=69", "webpage_url_basename": "BV1D5Gi6QEN7", "webpage_url_domain": "bilibili.com", "extractor": "BiliBili", "extractor_key": "BiliBili", "playlist_count": 82, "playlist": "【AI零基础入门】清华大佬终于讲完了AIGC全套教程变现课！含AI广告制作+AI绘画+视频视听语言全流程！全程干货无废话，学完即可副业变现！", "playlist_id": "BV1D5Gi6QEN7", "playlist_title": "【AI零基础入门】清华大佬终于讲完了AIGC全套教程变现课！含AI广告制作+AI绘画+视频视听语言全流程！全程干货无废话，学完即可副业变现！", "playlist_webpage_url": "https://www.bilibili.com/video/BV1D5Gi6QEN7/", "n_entries": 64, "playlist_index": 69, "thumbnails": [{"url": "http://i2.hdslb.com/bfs/archive/ddf2b57576483ae9189affdcd82a8353a0b54e86.jpg", "id": "0"}], "display_id": "BV1D5Gi6QEN7_p69", "fulltitle": "【AI零基础入门】清华大佬终于讲完了AIGC全套教程变现课！含AI广告制作+AI绘画+视频视听语言全流程！全程干货无废话，学完即可副业变现！ p69 【AI教育篇】AI 辅助家长开展心理健康教育", "duration_string": "5:27", "upload_date": "20260523", "epoch": 1780721043, "format": "1080P 高清+30280 - audio only", "format_id": "30080+30280", "ext": "mp4", "protocol": "https+https", "filesize_approx": 9012586, "tbr": 220.42400000000004, "width": 1920, "height": 1080, "resolution": "1920x1080", "fps": 30.0, "dynamic_range": "SDR", "vcodec": "avc1.640033", "vbr": 133.491, "aspect_ratio": 1.78, "acodec": "mp4a.40.2", "abr": 86.933, "_type": "video", "_version": {"version": "2026.03.17", "release_git_head": "04d6974f502bbdfaed72c624344f262e30ad9708", "repository": "yt-dlp/yt-dlp"}}