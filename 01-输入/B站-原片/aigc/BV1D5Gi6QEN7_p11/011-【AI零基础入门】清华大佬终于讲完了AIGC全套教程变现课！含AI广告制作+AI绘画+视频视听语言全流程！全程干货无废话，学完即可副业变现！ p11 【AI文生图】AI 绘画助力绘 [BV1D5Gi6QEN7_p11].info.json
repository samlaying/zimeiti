width": 1920, "height": 1080, "vcodec": "avc1.640033", "acodec": "none", "dynamic_range": "SDR", "tbr": 380.692, "quality": 80, "format_id": "30080", "format": "1080P 高清", "protocol": "https", "video_ext": "mp4", "audio_ext": "none", "abr": 0, "vbr": 380.692, "resolution": "1920x1080", "aspect_ratio": 1.78, "filesize_approx": 21857145, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/141.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.bilibili.com/video/BV1D5Gi6QEN7?p=11"}}], "duration": 459.314, "subtitles": {"danmaku": [{"ext": "xml", "url": "https://comment.bilibili.com/38552799172.xml"}], "ai-zh": [{"ext": "srt", "data": "1\n00:00:00,940 --> 00:00:01,860\n同学们大家好\n\n2\n00:00:01,860 --> 00:00:03,180\n我是你们的子文老师\n\n3\n00:00:03,180 --> 00:00:05,280\n那么这一堂课我们来学习一下\n\n4\n00:00:05,280 --> 00:00:09,680\n如何利用AI工具去绘制一个旅游纪念的明信片\n\n5\n00:00:09,680 --> 00:00:11,300\n的图片呃\n\n6\n00:00:11,300 --> 00:00:13,080\n如果你是一个旅游景区\n\n7\n00:00:13,080 --> 00:00:15,400\n提供创意服务的一个设计师\n\n8\n00:00:15,400 --> 00:00:18,160\n那么大理的旅游局委托你设计一系列\n\n9\n00:00:18,160 --> 00:00:21,640\n能够代表大理旅游特色的这样一个纪念明信片\n\n10\n00:00:21,640 --> 00:00:23,900\n既要体现大理的自然风光\n\n11\n00:00:23,900 --> 00:00:26,350\n又要融入白族的文化元素\n\n12\n00:00:26,350 --> 00:00:27,070\n吸引游\n\n13\n00:00:27,070 --> 00:00:28,510\n吸引游客去购买\n\n14\n00:00:28,510 --> 00:00:29,750\n并且寄送给亲友\n\n15\n00:00:29,750 --> 00:00:31,570\n这个时候你要怎么办呢\n\n16\n00:00:31,570 --> 00:00:34,510\n那么首先我们先利用deep sc这个工具\n\n17\n00:00:34,510 --> 00:00:37,400\n给我们出一组MJ的提示词\n\n18\n00:00:37,400 --> 00:00:41,120\n我们把一些个基本的信息提供给他\n\n19\n00:00:45,140 --> 00:00:45,780\n好\n\n20\n00:00:45,780 --> 00:00:47,590\n首先的话你就写\n\n21\n00:00:47,590 --> 00:00:52,010\n为我们提供一组关于大理特色旅游景点的图片\n\n22\n00:00:52,010 --> 00:00:54,889\nMJ的提示词去做明信片的印刷\n\n23\n00:00:54,889 --> 00:00:57,790\n用那目标景点的一些信息\n\n24\n00:00:57,790 --> 00:00:59,710\n其中呢有大理古城\n\n25\n00:00:59,710 --> 00:01:01,110\n有洱海苍山\n\n26\n00:01:01,110 --> 00:01:02,550\n还有白族的元素\n\n27\n00:01:02,550 --> 00:01:04,390\n那么下面还有设计需求\n\n28\n00:01:04,390 --> 00:01:06,270\n就是明信片的尺寸\n\n29\n00:01:06,270 --> 00:01:08,210\n他的比例是三比二的\n\n30\n00:01:08,210 --> 00:01:11,170\n风格的要求是要结合水彩艺术风格\n\n31\n00:01:11,170 --> 00:01:13,670\n突出大理的诗意和宁静\n\n32\n00:01:13,670 --> 00:01:16,230\n目标受众是国内外的游客\n\n33\n00:01:16,230 --> 00:01:19,930\n还有就是喜欢文艺小清新风格的一些个年轻人\n\n34\n00:01:19,930 --> 00:01:22,930\n那么把这一套要求给到TIPSICK以后\n\n35\n00:01:22,930 --> 00:01:25,250\n然后我们点击下发送\n\n36\n00:01:26,540 --> 00:01:27,360\n网络一查\n\n37\n00:01:27,360 --> 00:01:29,900\n我们就直接点击下重新生成\n\n38\n00:01:34,140 --> 00:01:38,320\n好这样的话它就可以给我们这个提示词了\n\n39\n00:01:38,320 --> 00:01:41,700\n首先第一个是关于大理古城的\n\n40\n00:01:43,480 --> 00:01:45,040\n那在这里面的话呢\n\n41\n00:01:45,040 --> 00:01:46,640\n下面是有这个中文翻译啊\n\n42\n00:01:46,640 --> 00:01:47,720\n我们可以简单看一下\n\n43\n00:01:47,720 --> 00:01:48,320\n待会儿\n\n44\n00:01:48,320 --> 00:01:50,240\n然后下面是有洱海的\n\n45\n00:01:50,240 --> 00:01:52,080\n苍山的\n\n46\n00:01:56,440 --> 00:01:58,440\n还有一些关于白族文化的\n\n47\n00:01:59,560 --> 00:02:03,020\n这完全是按照我们刚才的这个要求啊\n\n48\n00:02:03,020 --> 00:02:05,120\n去给我们生成的结果\n\n49\n00:02:06,540 --> 00:02:09,139\n好那么我们来看一下啊\n\n50\n00:02:09,139 --> 00:02:09,979\n简单看一下啊\n\n51\n00:02:09,979 --> 00:02:11,500\n首先第一个关于大理古城呢\n\n52\n00:02:11,500 --> 00:02:13,830\n就是金色夕阳下的大理古镇\n\n53\n00:02:13,830 --> 00:02:15,970\n然后传统的白色的建筑\n\n54\n00:02:15,970 --> 00:02:18,340\n弧形屋顶和错综复杂的雕刻\n\n55\n00:02:18,340 --> 00:02:22,020\n标志性的五花塔在温暖的灯光下闪耀等等啊\n\n56\n00:02:22,020 --> 00:02:25,660\n那么最后它的画面的比例是三比二的啊\n\n57\n00:02:25,660 --> 00:02:29,100\n风格这个风格回头我们还要自己去写一下\n\n58\n00:02:29,100 --> 00:02:31,490\n因为他的这个呃style啊\n\n59\n00:02:31,490 --> 00:02:32,090\nstyle的话\n\n60\n00:02:32,090 --> 00:02:34,970\n我们需要给他自己写一下它的数值好\n\n61\n00:02:34,970 --> 00:02:37,310\n那么我们来看一看这组提示词\n\n62\n00:02:37,310 --> 00:02:38,970\n最后出现的结果是什么\n\n63\n00:02:38,970 --> 00:02:41,210\nCTRLC复制一下\n\n64\n00:02:41,390 --> 00:02:45,290\n我们在这里面给它一个斜杠\n\n65\n00:02:45,290 --> 00:02:47,310\n选择一下MAD journey\n\n66\n00:02:47,310 --> 00:02:48,350\nCTRLV粘贴\n\n67\n00:02:48,350 --> 00:02:51,210\n那么我们要把最后的这个style呃\n\n68\n00:02:51,210 --> 00:02:54,290\nS值给他一个300吧\n\n69\n00:02:55,420 --> 00:02:57,660\n好然后回车确定一下\n\n70\n00:02:57,660 --> 00:02:58,940\n交互失败没关系啊\n\n71\n00:02:58,940 --> 00:03:01,060\n我们向上箭头点一下\n\n72\n00:03:01,060 --> 00:03:02,940\n然后再回车\n\n73\n00:03:11,480 --> 00:03:13,120\n好我们来看一下哈\n\n74\n00:03:13,120 --> 00:03:17,810\n那么这一套一共是四张图已经出来了是吧\n\n75\n00:03:17,810 --> 00:03:21,900\n那么它里面的这个画面显得非常的有艺术气息\n\n76\n00:03:21,900 --> 00:03:25,460\n呃而且他这种阳光明媚呃\n\n77\n00:03:25,460 --> 00:03:29,320\n在照就是照射在这种古街古镇上的这种感觉\n\n78\n00:03:29,320 --> 00:03:32,200\n还有下面灿烂的这种春花是吧\n\n79\n00:03:32,200 --> 00:03:33,680\n哎非常的漂亮啊\n\n80\n00:03:33,680 --> 00:03:36,420\n那么这个的话呢就是关于大理古镇的\n\n81\n00:03:36,420 --> 00:03:39,880\n然后接下来第二个苍山的\n\n82\n00:03:41,760 --> 00:03:45,560\n同样他这个给的stylize的值是600\n\n83\n00:03:47,120 --> 00:03:50,100\n我们待会儿要看一看这个参数不能太大\n\n84\n00:03:50,100 --> 00:03:51,880\n不能太大了啊\n\n85\n00:03:52,290 --> 00:03:54,530\n啧啧好呃\n\n86\n00:03:54,530 --> 00:03:56,370\n三比二可以\n\n87\n00:03:56,370 --> 00:03:59,170\n我们暂时先看一看600的效果是怎么样\n\n88\n00:03:59,170 --> 00:04:02,110\n有的时候我们这个风格值要是太大了的话\n\n89\n00:04:02,110 --> 00:04:04,370\n可能会反而不好\n\n90\n00:04:07,200 --> 00:04:09,080\n我们重新再来\n\n91\n00:04:13,360 --> 00:04:15,880\n好呃这里面写了苍山呢\n\n92\n00:04:15,880 --> 00:04:17,720\n一共是19座山峰\n\n93\n00:04:17,720 --> 00:04:21,100\n然后有水墨风格的渐变浮云松树\n\n94\n00:04:21,100 --> 00:04:23,040\n还有寺庙\n\n95\n00:04:23,209 --> 00:04:27,529\n然后还要有这个中国山水画与精致的水彩画\n\n96\n00:04:27,529 --> 00:04:29,389\n相遇结合到一起哇\n\n97\n00:04:29,389 --> 00:04:31,049\n非常漂亮\n\n98\n00:04:31,790 --> 00:04:33,170\n我们等待一下啊\n\n99\n00:04:33,170 --> 00:04:35,390\n它还没有完全生成\n\n100\n00:04:40,920 --> 00:04:42,760\n好我们来看一下是吧\n\n101\n00:04:42,760 --> 00:04:44,560\n哎非常有这种感觉哈\n\n102\n00:04:45,680 --> 00:04:47,080\n那在这四章里面\n\n103\n00:04:47,080 --> 00:04:50,379\n我们当然是需要选择一个呃比较满意的\n\n104\n00:04:50,379 --> 00:04:52,379\n然后呢把它进行放大就可以了\n\n105\n00:04:52,379 --> 00:04:53,559\n想要放大的话呢\n\n106\n00:04:53,559 --> 00:04:55,510\n比如说啊我们想要第三张\n\n107\n00:04:55,510 --> 00:04:56,350\n第三章的话\n\n108\n00:04:56,350 --> 00:04:57,730\n那你就点击下U3\n\n109\n00:04:57,730 --> 00:04:59,350\n如果你想选第一张的话\n\n110\n00:04:59,350 --> 00:05:00,150\n就点U1\n\n111\n00:05:00,150 --> 00:05:01,289\n其他以此类推\n\n112\n00:05:01,289 --> 00:05:02,989\n那么我们点击一下U3\n\n113\n00:05:02,989 --> 00:05:06,009\n这样的话我就可以把单独一张图进行放大\n\n114\n00:05:06,009 --> 00:05:07,569\n再点一次\n\n115\n00:05:11,120 --> 00:05:12,880\n好你看这样的话\n\n116\n00:05:12,880 --> 00:05:14,760\n第三张图就出来了对吧\n\n117\n00:05:14,760 --> 00:05:18,150\n哎这样的话呢咱们下载以后直接印刷就行\n\n118\n00:05:18,150 --> 00:05:21,270\n这张图的这个大小基本上是够用的啊\n\n119\n00:05:21,270 --> 00:05:23,210\n我们印刷应该是够用的好\n\n120\n00:05:23,210 --> 00:05:24,830\n这是我们第二个啊\n\n121\n00:05:24,830 --> 00:05:25,770\n苍山的\n\n122\n00:05:25,770 --> 00:05:29,270\n那么如果我们要是想把他的这个600\n\n123\n00:05:29,270 --> 00:05:31,170\n这个分隔值600\n\n124\n00:05:31,170 --> 00:05:32,930\n想要小一点也是可以的\n\n125\n00:05:32,930 --> 00:05:34,890\n我们试一试啊\n\n126\n00:05:38,900 --> 00:05:42,620\n把这个600改成200试试\n\n127\n00:05:43,500 --> 00:05:47,390\n那么他的这个呃艺术效果\n\n128\n00:05:47,390 --> 00:05:51,030\n就是附加的这种艺术效果会稍微少一点\n\n129\n00:05:51,030 --> 00:05:53,590\n会更贴近于真实\n\n130\n00:05:54,140 --> 00:05:56,060\n当然这里面没有优劣之分\n\n131\n00:05:56,060 --> 00:05:59,300\n完全是看我们自己的选择\n\n132\n00:06:10,740 --> 00:06:15,540\n好这是我们刚才看到的200的这种感觉\n\n133\n00:06:15,540 --> 00:06:19,050\n你看和刚才600的感觉呢稍微有点不同对吧\n\n134\n00:06:19,050 --> 00:06:22,090\n但是它整体的风格和导向是一样的\n\n135\n00:06:22,090 --> 00:06:24,590\n那这是我们看到的呃\n\n136\n00:06:24,590 --> 00:06:25,290\n苍山的啊\n\n137\n00:06:25,290 --> 00:06:28,090\n我们再来看一个白族文化的\n\n138\n00:06:29,440 --> 00:06:31,640\n同样这个style值的话\n\n139\n00:06:31,640 --> 00:06:33,440\n我们需要改一下\n\n140\n00:06:37,780 --> 00:06:43,260\nOK把它的值改一个300吧\n\n141\n00:06:48,680 --> 00:06:52,900\n那么它呢是白族文化拼贴在阳光下悬挂的\n\n142\n00:06:52,900 --> 00:06:54,780\n这个扎染的面料\n\n143\n00:06:54,780 --> 00:06:56,580\n然后灰瓦的屋顶\n\n144\n00:06:56,580 --> 00:06:58,360\n传统的白墙的房屋\n\n145\n00:06:58,360 --> 00:07:01,760\n还有穿着绣花衣服的呃妇女\n\n146\n00:07:01,760 --> 00:07:03,840\n还有呢杜鹃花等等啊\n\n147\n00:07:03,840 --> 00:07:08,440\n这都是呃关于白族的这种民族文化的感觉\n\n148\n00:07:11,220 --> 00:07:14,220\nOK好我们来看一下是吧\n\n149\n00:07:14,220 --> 00:07:17,980\n这样的话呢就是古镇里面的啊这样的一个场景\n\n150\n00:07:17,980 --> 00:07:19,890\n有这种蜡染的呃\n\n151\n00:07:19,890 --> 00:07:20,890\n蓝色的染布啊\n\n152\n00:07:20,890 --> 00:07:22,450\n还有女孩儿啊\n\n153\n00:07:22,450 --> 00:07:23,640\n就这种感觉\n\n154\n00:07:23,640 --> 00:07:26,840\n所以呢这就是如何利用deep sc\n\n155\n00:07:26,840 --> 00:07:28,000\n还有MAD journey\n\n156\n00:07:28,000 --> 00:07:29,150\n这两个工具\n\n157\n00:07:29,150 --> 00:07:33,530\n去给我们做这种旅游特色明信片的画面的\n\n158\n00:07:33,530 --> 00:07:34,310\n这种方法\n\n159\n00:07:34,310 --> 00:07:36,080\n咱们大家学会了吗\n\n"}]}, "webpage_url": "https://www.bilibili.com/video/BV1D5Gi6QEN7?p=11", "webpage_url_basename": "BV1D5Gi6QEN7", "webpage_url_domain": "bilibili.com", "extractor": "BiliBili", "extractor_key": "BiliBili", "playlist_count": 82, "playlist": "【AI零基础入门】清华大佬终于讲完了AIGC全套教程变现课！含AI广告制作+AI绘画+视频视听语言全流程！全程干货无废话，学完即可副业变现！", "playlist_id": "BV1D5Gi6QEN7", "playlist_title": "【AI零基础入门】清华大佬终于讲完了AIGC全套教程变现课！含AI广告制作+AI绘画+视频视听语言全流程！全程干货无废话，学完即可副业变现！", "playlist_webpage_url": "https://www.bilibili.com/video/BV1D5Gi6QEN7/", "n_entries": 82, "playlist_index": 11, "thumbnails": [{"url": "http://i2.hdslb.com/bfs/archive/ddf2b57576483ae9189affdcd82a8353a0b54e86.jpg", "id": "0"}], "display_id": "BV1D5Gi6QEN7_p11", "fulltitle": "【AI零基础入门】清华大佬终于讲完了AIGC全套教程变现课！含AI广告制作+AI绘画+视频视听语言全流程！全程干货无废话，学完即可副业变现！ p11 【AI文生图】AI 绘画助力绘制旅游纪念明信片", "duration_string": "7:39", "upload_date": "20260523", "epoch": 1780709532, "format": "1080P 高清+30280 - audio only", "format_id": "30080+30280", "ext": "mp4", "protocol": "https+https", "filesize_approx": 27449235, "tbr": 478.091, "width": 1920, "height": 1080, "resolution": "1920x1080", "fps": 30.0, "dynamic_range": "SDR", "vcodec": "avc1.640033", "vbr": 38