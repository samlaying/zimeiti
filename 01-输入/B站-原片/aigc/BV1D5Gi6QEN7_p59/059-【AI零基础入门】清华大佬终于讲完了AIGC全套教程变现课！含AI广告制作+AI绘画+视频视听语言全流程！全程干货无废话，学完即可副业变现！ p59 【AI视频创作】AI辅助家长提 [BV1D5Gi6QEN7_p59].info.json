deo_ext": "mp4", "audio_ext": "none", "abr": 0, "vbr": 145.62, "resolution": "1920x1080", "aspect_ratio": 1.78, "filesize_approx": 7118051, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/138.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.bilibili.com/video/BV1D5Gi6QEN7?p=59"}}], "duration": 391.048, "subtitles": {"danmaku": [{"ext": "xml", "url": "https://comment.bilibili.com/38553453809.xml"}], "ai-zh": [{"ext": "srt", "data": "1\n00:00:01,260 --> 00:00:02,220\n同学们大家好\n\n2\n00:00:02,220 --> 00:00:03,500\n我是你们泽老师\n\n3\n00:00:03,500 --> 00:00:05,450\n这堂课我们来学习一下\n\n4\n00:00:05,450 --> 00:00:08,350\n如何利用AI工具去辅助家长\n\n5\n00:00:08,350 --> 00:00:10,670\n提升孩子的英语成绩\n\n6\n00:00:10,670 --> 00:00:12,410\n你有没有这样的时刻\n\n7\n00:00:12,410 --> 00:00:14,710\n晚上九点你刚下班回家\n\n8\n00:00:14,710 --> 00:00:16,850\n孩子坐在书桌前写作业\n\n9\n00:00:16,850 --> 00:00:17,910\n一脸苦相对\n\n10\n00:00:17,910 --> 00:00:20,450\n你说妈妈这个单词我背不下来\n\n11\n00:00:20,450 --> 00:00:21,530\n你心里一急\n\n12\n00:00:21,530 --> 00:00:22,590\n一边拼读\n\n13\n00:00:22,590 --> 00:00:24,410\n一边又想找视频单词\n\n14\n00:00:24,410 --> 00:00:24,830\n卡片\n\n15\n00:00:24,830 --> 00:00:25,560\n练习集\n\n16\n00:00:25,560 --> 00:00:26,680\n练习题等等\n\n17\n00:00:26,680 --> 00:00:27,840\n但是到了最后呢\n\n18\n00:00:27,840 --> 00:00:28,960\n孩子一边打呵气\n\n19\n00:00:28,960 --> 00:00:30,290\n你一边叹气\n\n20\n00:00:30,290 --> 00:00:32,630\n我们不是不想教孩子学英语\n\n21\n00:00:32,630 --> 00:00:34,690\n而是被困在了不会教\n\n22\n00:00:34,690 --> 00:00:35,470\n没有时间\n\n23\n00:00:35,470 --> 00:00:37,239\n没有方法这里面了\n\n24\n00:00:37,239 --> 00:00:38,379\n可是你知道吗\n\n25\n00:00:38,379 --> 00:00:40,399\n现在越来越多的聪明的家长\n\n26\n00:00:40,399 --> 00:00:42,779\n已经开始用AI去搞定这个问题了\n\n27\n00:00:42,779 --> 00:00:44,079\n他不是取代你\n\n28\n00:00:44,079 --> 00:00:46,819\n而是做你育儿路上的英语助教\n\n29\n00:00:46,870 --> 00:00:50,930\n我们现在用AI怎么去帮助家长\n\n30\n00:00:50,930 --> 00:00:52,990\n提升孩子的英语成绩呢\n\n31\n00:00:52,990 --> 00:00:56,310\n其实我们这里面一共有三个最难搞的环节\n\n32\n00:00:56,310 --> 00:00:58,350\n第一个就是单词记不住\n\n33\n00:00:58,350 --> 00:01:00,790\n那你就可以用AI去帮你\n\n34\n00:01:00,790 --> 00:01:03,350\n量身定制一个复习的节奏\n\n35\n00:01:03,350 --> 00:01:07,690\n比如说用这个DEMSK去做词义加联想\n\n36\n00:01:07,690 --> 00:01:11,430\n图像加测试题这样的一个一站式的输出\n\n37\n00:01:11,430 --> 00:01:14,970\n你还能设置一些措辞的自动反复的测试\n\n38\n00:01:14,970 --> 00:01:18,320\n就像你自己本人私人的这种错题本儿\n\n39\n00:01:18,320 --> 00:01:20,540\n第二个呢就是作文不会写\n\n40\n00:01:20,540 --> 00:01:25,620\n可以用AI工具去帮你逐句的拆解润色和提升\n\n41\n00:01:25,620 --> 00:01:27,260\n给一个作文题目\n\n42\n00:01:27,260 --> 00:01:30,260\n那么AI就能教孩子你这个结构怎么搭\n\n43\n00:01:30,260 --> 00:01:31,440\n句子怎么写\n\n44\n00:01:31,440 --> 00:01:33,110\n词汇如何丰富\n\n45\n00:01:33,110 --> 00:01:35,510\n那家长呢你只需要陪伴就可以了\n\n46\n00:01:35,510 --> 00:01:36,270\n一起修改\n\n47\n00:01:36,270 --> 00:01:37,270\n你不需要焦虑\n\n48\n00:01:37,270 --> 00:01:38,530\n也不需要干着急\n\n49\n00:01:38,530 --> 00:01:41,000\n还有呢就是学习没有兴趣\n\n50\n00:01:41,000 --> 00:01:43,920\n这个时候AI就可以给孩子去生成\n\n51\n00:01:43,920 --> 00:01:47,430\n一个兴趣主题的英语的学习材料\n\n52\n00:01:47,430 --> 00:01:51,390\n那么用AI去教英语的这个底层逻辑是什么呢\n\n53\n00:01:51,390 --> 00:01:55,740\n其实就是用输入加上输出加上纠错\n\n54\n00:01:55,740 --> 00:01:58,320\n去替代那种死记硬背\n\n55\n00:01:58,320 --> 00:02:02,170\n让孩子在这种互动中自然地去学习语言\n\n56\n00:02:02,170 --> 00:02:03,330\n而你家长呢\n\n57\n00:02:03,330 --> 00:02:06,090\n其实你这个角色就变成了一个陪伴者\n\n58\n00:02:06,090 --> 00:02:07,050\n引导者\n\n59\n00:02:07,050 --> 00:02:09,899\n而不再是一个知识的搬运工了\n\n60\n00:02:09,899 --> 00:02:13,599\n那么我们通过几段这种提示词的模板\n\n61\n00:02:13,599 --> 00:02:18,140\n来分别看一下像这样的适用场景应该怎么做\n\n62\n00:02:18,460 --> 00:02:22,740\n比如说我们现在想要做口语对练听力练习\n\n63\n00:02:22,740 --> 00:02:25,020\n还有就是家庭的英语会话\n\n64\n00:02:25,020 --> 00:02:27,730\n这个时候我们可以这样做\n\n65\n00:02:29,060 --> 00:02:32,120\n把这段提示词给到deep sick\n\n66\n00:02:32,120 --> 00:02:33,680\n那么在这里面写的是\n\n67\n00:02:33,680 --> 00:02:37,580\n请为小学生设计一个英语的单词学习卡片\n\n68\n00:02:37,580 --> 00:02:39,410\n目标词是蝴蝶\n\n69\n00:02:39,410 --> 00:02:41,230\n那么包含以下的内容\n\n70\n00:02:41,230 --> 00:02:43,010\n第一个是中文的示意\n\n71\n00:02:43,010 --> 00:02:45,640\n第二个是联想图像的描述\n\n72\n00:02:45,640 --> 00:02:49,810\n还有就是要符合年龄段的一个英文的例句\n\n73\n00:02:49,810 --> 00:02:53,850\n选择选择题的形式的词义测试要复正确\n\n74\n00:02:53,850 --> 00:02:55,310\n答案风格要活泼\n\n75\n00:02:55,310 --> 00:02:57,290\n那么适合8~10岁的孩子\n\n76\n00:02:57,290 --> 00:02:58,480\n要鼓励表达\n\n77\n00:02:58,480 --> 00:03:00,200\n那像这样一段提示词\n\n78\n00:03:00,200 --> 00:03:02,600\n当然像目标词是什么\n\n79\n00:03:02,600 --> 00:03:04,940\n我们是可以自己去替换的好\n\n80\n00:03:04,940 --> 00:03:07,650\n那么当你点击发送以后\n\n81\n00:03:07,650 --> 00:03:10,490\n他就可以给你去进行出题了\n\n82\n00:03:18,460 --> 00:03:21,420\n你看这样的单词学习卡就出来了啊\n\n83\n00:03:21,420 --> 00:03:23,340\n第一个中文诗意蝴蝶对吧\n\n84\n00:03:23,340 --> 00:03:25,910\n像花园里会飞的彩色的小精灵\n\n85\n00:03:25,910 --> 00:03:28,290\n联想的图像的描述等等啊\n\n86\n00:03:28,290 --> 00:03:30,290\n然后英文的例句是什么\n\n87\n00:03:30,290 --> 00:03:32,230\n词义的小测验是什么\n\n88\n00:03:32,230 --> 00:03:35,200\n然后最后告诉你标准的答案是什么\n\n89\n00:03:35,200 --> 00:03:36,860\n是啊非常的生动啊\n\n90\n00:03:36,860 --> 00:03:38,370\n这样的一个过程\n\n91\n00:03:38,370 --> 00:03:41,410\n那我们只要把一些想要的这个词\n\n92\n00:03:41,410 --> 00:03:43,110\n在这里面去进行替换\n\n93\n00:03:43,110 --> 00:03:45,450\n是不是下面的这种学习卡啊\n\n94\n00:03:45,450 --> 00:03:47,750\n就自动就可以给你生成了好\n\n95\n00:03:47,750 --> 00:03:48,990\n这是第一种情况啊\n\n96\n00:03:48,990 --> 00:03:51,570\n适用场景是呃口语对练\n\n97\n00:03:51,570 --> 00:03:54,430\n那么第二个场景就是作文的辅导\n\n98\n00:03:54,430 --> 00:03:55,770\n错句的纠正\n\n99\n00:03:55,770 --> 00:03:57,950\n还有就是词汇的提升\n\n100\n00:03:57,950 --> 00:04:01,065\n我们可以再给他一段提示词\n\n101\n00:04:04,760 --> 00:04:06,040\n好可以写\n\n102\n00:04:06,040 --> 00:04:09,780\n以下是一个4年级学生写英语作文的草稿\n\n103\n00:04:09,780 --> 00:04:11,500\n请逐句进行修改\n\n104\n00:04:11,500 --> 00:04:15,420\n然后呢改写再解释每一句的优化的逻辑\n\n105\n00:04:15,420 --> 00:04:16,740\n语言风格要亲切\n\n106\n00:04:16,740 --> 00:04:20,870\n鼓励作文题目原文还有输出的要求等等等等\n\n107\n00:04:20,870 --> 00:04:23,870\n然后我们再去点击发送\n\n108\n00:04:26,540 --> 00:04:31,950\n好你看他就会把这种改后的文章给你写出来\n\n109\n00:04:31,950 --> 00:04:33,190\n原文是什么\n\n110\n00:04:33,190 --> 00:04:34,990\n改写是什么啊\n\n111\n00:04:34,990 --> 00:04:37,870\n然后修改的原因是什么\n\n112\n00:04:39,160 --> 00:04:41,680\n好一个修改完事的完整作文\n\n113\n00:04:41,680 --> 00:04:44,430\n以及写作的小建议是什么\n\n114\n00:04:44,430 --> 00:04:45,070\n是啊\n\n115\n00:04:45,070 --> 00:04:49,120\n所以呢用AI工具就是一个非常好的英语老师\n\n116\n00:04:49,120 --> 00:04:52,240\n那另外还有一个就是场景啊\n\n117\n00:04:52,240 --> 00:04:54,320\n还有一个就是沉浸式的输入\n\n118\n00:04:54,320 --> 00:04:57,250\n去培养阅读兴趣和词汇量\n\n119\n00:04:57,250 --> 00:04:58,470\n那我们来看一看\n\n120\n00:04:58,470 --> 00:05:02,700\n像这样的一个提示词应该怎么写好\n\n121\n00:05:02,700 --> 00:05:06,200\n请你为一个十岁的男孩去定制一篇英语的阅读\n\n122\n00:05:07,140 --> 00:05:09,480\n主题是他最喜欢的恐龙\n\n123\n00:05:09,480 --> 00:05:12,060\n那当然这又是我们可以替换的内容\n\n124\n00:05:12,060 --> 00:05:14,900\n难度要控制在小学的高年级\n\n125\n00:05:14,900 --> 00:05:18,240\n要求故事形式150个词的左右\n\n126\n00:05:18,240 --> 00:05:20,720\n附带中文注释词汇十个\n\n127\n00:05:20,720 --> 00:05:23,669\n最后给出三个阅读理解的选择题\n\n128\n00:05:23,669 --> 00:05:25,529\n加入一些趣味的细节\n\n129\n00:05:25,529 --> 00:05:27,869\n如恐龙爱吃披萨啊\n\n130\n00:05:27,869 --> 00:05:29,550\n让孩子更有参与感\n\n131\n00:05:29,550 --> 00:05:31,110\n那这样的段提示词\n\n132\n00:05:31,110 --> 00:05:34,850\n当然下面的这些我们都是可以去修改的啊\n\n133\n00:05:34,850 --> 00:05:39,440\n替换成自己想要的内容好我们再去进行下传送\n\n134\n00:05:55,520 --> 00:05:58,480\n好你看这样的话呢\n\n135\n00:05:58,480 --> 00:06:01,350\n它就会生成一个这种英文的文章\n\n136\n00:06:01,350 --> 00:06:02,510\n上面有英文\n\n137\n00:06:02,510 --> 00:06:04,770\n下面会有一些其他的翻译\n\n138\n00:06:04,770 --> 00:06:09,600\n包括像它这里面插入了这种中文的词语啊\n\n139\n00:06:09,880 --> 00:06:13,120\n好然后下面会有带中文的注释\n\n140\n00:06:13,120 --> 00:06:15,659\n一些个生词都是什么含义\n\n141\n00:06:15,659 --> 00:06:16,419\n对吧\n\n142\n00:06:16,419 --> 00:06:20,119\n哎那以上呢就是一种非常好的方式\n\n143\n00:06:20,119 --> 00:06:25,170\n帮助家长帮助孩子对英语及建立兴趣\n\n144\n00:06:25,170 --> 00:06:27,710\n并且提高英语的成绩的方法\n\n145\n00:06:27,710 --> 00:06:29,580\n咱们大家学会了吗\n\n"}]}, "webpage_url": "https://www.bilibili.com/video/BV1D5Gi6QEN7?p=59", "webpage_url_basename": "BV1D5Gi6QEN7", "webpage_url_domain": "bilibili.com", "extractor": "BiliBili", "extractor_key": "BiliBili", "playlist_count": 82, "playlist": "【AI零基础入门】清华大佬终于讲完了AIGC全套教程变现课！含AI广告制作+AI绘画+视频视听语言全流程！全程干货无废话，学完即可副业变现！", "playlist_id": "BV1D5Gi6QEN7", "playlist_title": "【AI零基础入门】清华大佬终于讲完了AIGC全套教程变现课！含AI广告制作+AI绘画+视频视听语言全流程！全程干货无废话，学完即可副业变现！", "playlist_webpage_url": "https://www.bilibili.com/video/BV1D5Gi6QEN7/", "n_entries": 64, "playlist_index": 59, "thumbnails": [{"url": "http://i2.hdslb.com/bfs/archive/ddf2b57576483ae9189affdcd82a8353a0b54e86.jpg", "id": "0"}], "display_id": "BV1D5Gi6QEN7_p59", "fulltitle": "【AI零基础入门】清华大佬终于讲完了AIGC全套教程变现课！含AI广告制作+AI绘画+视频视听语言全流程！全程干货无废话，学完即可副业变现！ p59 【AI视频创作】AI辅助家长提升孩子英语成绩", "duration_string": "6:31", "upload_date": "20260523", "epoch": 1780720516, "format": "1080P 高清+30280 - audio only", "format_id": "30080+30280", "ext": "mp4", "protocol": "https+https", "filesize_approx": 11393867, "tbr": 233.094, "width": 1920, "height": 1080, "resolution": "1920x1080", "fps": 30.0, "dynamic_range": "SDR", "vcodec": "avc1.640033", "vbr": 145.62, "aspect_ratio": 1.78, "acodec": "mp4a.40.2", "abr": 87.474, "_type": "video", "_version": {"version": "2026.03.17", "release_git_head": "04d6974f502bbdfaed72c624344f262e30ad9708", "repository": "yt-dlp/yt-dlp"}}