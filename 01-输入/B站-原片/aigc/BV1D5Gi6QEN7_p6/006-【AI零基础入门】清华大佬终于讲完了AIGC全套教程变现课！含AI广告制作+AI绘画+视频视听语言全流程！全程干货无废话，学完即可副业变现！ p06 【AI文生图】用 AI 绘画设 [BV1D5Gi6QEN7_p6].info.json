s&deadline=1780716408&nbs=1&oi=1875881457&platform=pc&mid=3546568672151587&upsig=03b0b3e8386d05654dbf131dbeb752d5&uparams=e,os,trid,uipk,gen,og,deadline,nbs,oi,platform,mid&bvc=vod&nettype=0&bw=159458&lrs=0&dl=0&f=u_0_0&qn_dyeid=469152f17a2a3ef10003efb96a237758&agrr=1&buvid=56CBBADE-6E37-C95A-FAC9-97160BE6D01C13885infoc&build=0&orderid=0,3", "ext": "mp4", "fps": 30.0, "width": 1280, "height": 720, "vcodec": "avc1.640033", "acodec": "none", "dynamic_range": "SDR", "tbr": 159.231, "quality": 64, "format_id": "30064", "format": "720P 准高清", "protocol": "https", "video_ext": "mp4", "audio_ext": "none", "abr": 0, "vbr": 159.231, "resolution": "1280x720", "aspect_ratio": 1.78, "filesize_approx": 7154806, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/141.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.bilibili.com/video/BV1D5Gi6QEN7?p=6"}}, {"url": "https://upos-sz-mirrorzos.bilivideo.com/upgcxcode/44/54/38552735444/38552735444-1-30080.m4s?e=ig8euxZM2rNcNbdlhoNvNC8BqJIzNbfqXBvEqxTEto8BTrNvN0GvT90W5JZMkX_YN0MvXg8gNEV4NC8xNEV4N03eN0B5tZlqNxTEto8BTrNvNeZVuJ10Kj_g2UB02J0mN0B5tZlqNCNEto8BTrNvNC7MTX502C8f2jmMQJ6mqF2fka1mqx6gqj0eN0B599M=&gen=playurlv3&os=zosbv&nbs=1&oi=1875881457&trid=7479e45dbb05450f8a6cab0820a6028u&deadline=1780716408&og=hw&platform=pc&mid=3546568672151587&uipk=5&upsig=5f927a31cc44de26e0de4443cefca674&uparams=e,gen,os,nbs,oi,trid,deadline,og,platform,mid,uipk&bvc=vod&nettype=0&bw=331452&lrs=0&build=0&dl=0&f=u_0_0&qn_dyeid=469152f17a2a3ef10003efb96a237758&agrr=1&buvid=56CBBADE-6E37-C95A-FAC9-97160BE6D01C13885infoc&orderid=0,3", "ext": "mp4", "fps": 30.0, "width": 1920, "height": 1080, "vcodec": "avc1.640033", "acodec": "none", "dynamic_range": "SDR", "tbr": 331.002, "quality": 80, "format_id": "30080", "format": "1080P 高清", "protocol": "https", "video_ext": "mp4", "audio_ext": "none", "abr": 0, "vbr": 331.002, "resolution": "1920x1080", "aspect_ratio": 1.78, "filesize_approx": 14873078, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/141.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.bilibili.com/video/BV1D5Gi6QEN7?p=6"}}], "duration": 359.468, "subtitles": {"danmaku": [{"ext": "xml", "url": "https://comment.bilibili.com/38552735444.xml"}], "ai-zh": [{"ext": "srt", "data": "1\n00:00:01,500 --> 00:00:02,380\n同学们大家好\n\n2\n00:00:02,380 --> 00:00:03,760\n我是你们的子文老师\n\n3\n00:00:03,760 --> 00:00:05,780\n那么这一堂课我们来学习一下\n\n4\n00:00:05,780 --> 00:00:08,140\n如何利用AI工具去绘制一幅\n\n5\n00:00:08,140 --> 00:00:10,640\n独一无二的家居的装饰画\n\n6\n00:00:10,640 --> 00:00:11,120\n呃\n\n7\n00:00:11,120 --> 00:00:13,520\n如果你现在想要为自己家的客厅\n\n8\n00:00:13,520 --> 00:00:15,280\n去挂一幅装饰画\n\n9\n00:00:15,280 --> 00:00:19,070\n那如果你喜欢的是北欧的森林湖泊的景观\n\n10\n00:00:19,070 --> 00:00:21,590\n并且呢希望在日常生活中能够\n\n11\n00:00:21,590 --> 00:00:23,470\n感受到大自然的气息\n\n12\n00:00:23,470 --> 00:00:27,410\n并且不希不希望这个画面是过于写实和传统的\n\n13\n00:00:27,410 --> 00:00:30,990\n想要让它呢能够有现代水彩和东方水墨画\n\n14\n00:00:30,990 --> 00:00:32,659\n这种结合的一种风格\n\n15\n00:00:32,659 --> 00:00:34,800\n这个时候你需要怎么办呢\n\n16\n00:00:34,800 --> 00:00:37,980\n首先的话我们可以在TIMSC里去\n\n17\n00:00:37,980 --> 00:00:41,090\n让他给我们出一组绘画的提示词\n\n18\n00:00:41,090 --> 00:00:43,870\n那么我们在这里需要给到他\n\n19\n00:00:43,870 --> 00:00:46,590\n我们的要求好\n\n20\n00:00:46,590 --> 00:00:49,650\n我们把这个要求给他复制过来呃\n\n21\n00:00:49,650 --> 00:00:51,590\n首先呢你要告诉他给\n\n22\n00:00:51,590 --> 00:00:53,970\n请请给我写一组MJ的提示词\n\n23\n00:00:53,970 --> 00:00:55,890\n那么MJ呢就是MAD journey啊\n\n24\n00:00:55,890 --> 00:00:57,240\n这个绘画工具\n\n25\n00:00:57,240 --> 00:01:00,760\n希望画面是由北欧的森林和湖泊的景观\n\n26\n00:01:00,760 --> 00:01:03,420\n能够感受到大自然的宁静的力量\n\n27\n00:01:03,420 --> 00:01:07,120\n由现代的水彩与传统的东方水墨画去相结合\n\n28\n00:01:07,120 --> 00:01:09,440\n画面不要过于写实或者传统\n\n29\n00:01:09,440 --> 00:01:11,880\n那么这个要求给到deep sick以后\n\n30\n00:01:11,880 --> 00:01:14,230\n让他去给我们写这个提示词\n\n31\n00:01:14,230 --> 00:01:17,960\n这个过程相对来说还是呃比较简单的\n\n32\n00:01:17,960 --> 00:01:19,340\n如果遇到了网络异常\n\n33\n00:01:19,340 --> 00:01:22,880\n你就直接点击一下重新生成就可以了\n\n34\n00:01:38,340 --> 00:01:39,940\n好我们来看一下\n\n35\n00:01:39,940 --> 00:01:42,680\n那么他得到的这一段提示词\n\n36\n00:01:42,680 --> 00:01:44,020\n上面的这一段啊\n\n37\n00:01:44,020 --> 00:01:44,740\n提示词\n\n38\n00:01:44,740 --> 00:01:49,210\n那可以看到他写的是暮色时分宁静的北欧湖泊\n\n39\n00:01:50,730 --> 00:01:53,210\n薄雾从清澈的水中缓缓升起\n\n40\n00:01:53,210 --> 00:01:56,400\n可以看到它整个这个词写的还是呃呃\n\n41\n00:01:56,400 --> 00:01:57,900\n非常的优美的哈\n\n42\n00:01:57,900 --> 00:02:00,920\n而且呢他写了像蓝颜色和珍珠\n\n43\n00:02:00,920 --> 00:02:02,780\n灰色调的柔和的扩散\n\n44\n00:02:02,780 --> 00:02:04,850\n还有手工纸的微妙的纹理\n\n45\n00:02:04,850 --> 00:02:07,810\n还有极简主义的构图和不对称性等等\n\n46\n00:02:07,810 --> 00:02:11,620\n那我们来看一看它具体的效果是什么样\n\n47\n00:02:12,760 --> 00:02:16,520\n我们把上面的这段英文CTRLC复制一下\n\n48\n00:02:17,080 --> 00:02:21,270\n当我们的discord社区的MAD journey的这个呃\n\n49\n00:02:21,270 --> 00:02:22,110\n服务器里面\n\n50\n00:02:22,110 --> 00:02:24,330\n然后我们打一个斜杠\n\n51\n00:02:24,330 --> 00:02:27,170\n在这里面选择一下MAD journey的机器人\n\n52\n00:02:27,170 --> 00:02:28,010\nCTRLV粘贴\n\n53\n00:02:28,010 --> 00:02:29,060\n把它粘过来\n\n54\n00:02:29,060 --> 00:02:29,660\n看一看\n\n55\n00:02:29,660 --> 00:02:32,520\n后面这个参数是16比九的可以\n\n56\n00:02:32,520 --> 00:02:36,680\n然后呢它的这个风格化是600V6的版本\n\n57\n00:02:36,680 --> 00:02:37,340\n这些都行\n\n58\n00:02:37,340 --> 00:02:39,960\n然后我们回车确定一下\n\n59\n00:02:50,620 --> 00:02:51,820\n好我们看到啊\n\n60\n00:02:51,820 --> 00:02:53,260\n他一共是给了我们四\n\n61\n00:02:53,260 --> 00:02:55,620\n一共给了我们四张画面\n\n62\n00:02:55,620 --> 00:02:59,230\n那么这四张画面我们是可以任意去选择一个的\n\n63\n00:02:59,230 --> 00:03:00,830\n等待它加载完毕啊\n\n64\n00:03:00,830 --> 00:03:03,630\n他现在还没有完全加载下来\n\n65\n00:03:04,980 --> 00:03:06,860\n好现在已经完全清晰了\n\n66\n00:03:06,860 --> 00:03:08,300\n你看是不是完全符合\n\n67\n00:03:08,300 --> 00:03:10,540\n刚才我们说到的那个内容啊\n\n68\n00:03:10,540 --> 00:03:12,580\n哎森林湖泊还有远山\n\n69\n00:03:12,580 --> 00:03:16,160\n但是呢它是水彩加水墨画的这种风格的啊\n\n70\n00:03:16,160 --> 00:03:19,920\n整个就是仙气飘飘渺这种感觉是吧\n\n71\n00:03:19,920 --> 00:03:21,280\n非常有氛围感啊\n\n72\n00:03:21,280 --> 00:03:23,760\n那如果有一张图是我们想要的\n\n73\n00:03:23,760 --> 00:03:25,520\n比如说我觉得第四张啊\n\n74\n00:03:25,520 --> 00:03:27,480\n这个画面色彩什么都很不错\n\n75\n00:03:27,480 --> 00:03:30,250\n那我想把它进行下载怎么办呢\n\n76\n00:03:30,250 --> 00:03:32,310\n首先就是点击一下U4\n\n77\n00:03:32,310 --> 00:03:35,730\n这个U4指的就是单独放大第四章的意思\n\n78\n00:03:35,730 --> 00:03:36,740\n点击它一下\n\n79\n00:03:36,740 --> 00:03:40,240\n这个时候我们第四张图就可以单独放大了\n\n80\n00:03:40,240 --> 00:03:42,159\n然后你把它点大\n\n81\n00:03:42,159 --> 00:03:45,179\n看一看里面有什么呃不好的地方没有\n\n82\n00:03:45,179 --> 00:03:46,019\n如果没有的话\n\n83\n00:03:46,019 --> 00:03:47,010\n直接点击右键\n\n84\n00:03:47,010 --> 00:03:48,750\n点击一下图片存储为\n\n85\n00:03:48,750 --> 00:03:51,150\n那么这张图我们就可以下载下来\n\n86\n00:03:51,150 --> 00:03:54,290\n并且把它制作成一个装饰画就可以了\n\n87\n00:03:54,290 --> 00:03:58,690\n那么这个呢是我们从这个deep deep sc里面啊得到的\n\n88\n00:03:58,690 --> 00:04:00,890\n直接得到的这样的一个提示词\n\n89\n00:04:00,890 --> 00:04:03,690\n当然如果我们要是想自己去写提示词\n\n90\n00:04:03,690 --> 00:04:06,760\n也完全可以在这里给大家一段\n\n91\n00:04:06,760 --> 00:04:08,380\n我们自己写的提示词\n\n92\n00:04:08,380 --> 00:04:11,970\n可以看一下效果好\n\n93\n00:04:11,970 --> 00:04:15,750\n还是在迪斯科的社区里面\n\n94\n00:04:15,750 --> 00:04:18,570\n重新选择mana journey的机器人\n\n95\n00:04:18,570 --> 00:04:20,450\n然后给它粘贴过来\n\n96\n00:04:20,450 --> 00:04:21,370\n回车确定\n\n97\n00:04:21,370 --> 00:04:24,080\n我们来看一下这段提示词是怎么写的\n\n98\n00:04:24,080 --> 00:04:27,200\n这是一幅极简主义的抽象风景画\n\n99\n00:04:27,200 --> 00:04:30,840\n描绘的是黎明时分的北欧的森林\n\n100\n00:04:33,660 --> 00:04:35,140\n好然后还有什么呢\n\n101\n00:04:35,140 --> 00:04:39,170\n朦胧的气氛受亚洲水墨画的启发的细腻笔触\n\n102\n00:04:39,170 --> 00:04:40,110\n蓝色和绿色\n\n103\n00:04:40,110 --> 00:04:43,000\n柔和的渐变与温暖的光线等等啊\n\n104\n00:04:43,000 --> 00:04:45,560\n那我们可以看到它出来的这个效果\n\n105\n00:04:47,360 --> 00:04:49,800\n异曲同工的这种感觉啊\n\n106\n00:04:50,550 --> 00:04:52,110\n好我们稍微等一会儿啊\n\n107\n00:04:52,110 --> 00:04:53,950\n让它加载进来\n\n108\n00:05:00,660 --> 00:05:02,900\n好我们给它放大看一下\n\n109\n00:05:02,900 --> 00:05:06,420\n是不是也是基本是符合我们刚才所说到的啊\n\n110\n00:05:06,420 --> 00:05:07,350\n那几个要求\n\n111\n00:05:07,350 --> 00:05:08,030\n当然啦\n\n112\n00:05:08,030 --> 00:05:09,690\n那像这样的一幅画面\n\n113\n00:05:09,690 --> 00:05:12,639\n如果你要是觉得并不是特别理想的话\n\n114\n00:05:12,639 --> 00:05:16,840\n你也可以直接点击下面这个循环这个小箭头\n\n115\n00:05:16,840 --> 00:05:17,760\n点它的话呢\n\n116\n00:05:17,760 --> 00:05:20,950\n就是用同一套提示词直接点击提交啊\n\n117\n00:05:20,950 --> 00:05:25,550\n用同一套提示词再去给你生成四个画面\n\n118\n00:05:25,550 --> 00:05:28,760\n让你去有一个挑选\n\n119\n00:05:29,440 --> 00:05:31,960\n我们要知道像这样的AI工具的话\n\n120\n00:05:31,960 --> 00:05:33,840\n他们都是有一定的随机性的\n\n121\n00:05:33,840 --> 00:05:35,520\n你同一套提示词的话\n\n122\n00:05:35,520 --> 00:05:37,420\n它可以生成不同的画面\n\n123\n00:05:37,420 --> 00:05:40,100\n虽然他们都是能够满足你这个要求的啊\n\n124\n00:05:40,100 --> 00:05:43,740\n但是呢它里面肯定还会有一些个不一样的地方\n\n125\n00:05:44,060 --> 00:05:46,600\n这样的话我们就可以哎\n\n126\n00:05:46,600 --> 00:05:50,270\n在其中选择我们最满意的那张就可以了\n\n127\n00:05:50,270 --> 00:05:54,830\n那以上以上呢就是我们如何利用AI工具去得到\n\n128\n00:05:54,830 --> 00:05:56,430\n一幅家具的装饰画\n\n129\n00:05:56,430 --> 00:05:58,040\n咱们大家学会了吗\n\n"}]}, "webpage_url": "https://www.bilibili.com/video/BV1D5Gi6QEN7?p=6", "webpage_url_basename": "BV1D5Gi6QEN7", "webpage_url_domain": "bilibili.com", "extractor": "BiliBili", "extractor_key": "BiliBili", "playlist_count": 82, "playlist": "【AI零基础入门】清华大佬终于讲完了AIGC全套教程变现课！含AI广告制作+AI绘画+视频视听语言全流程！全程干货无废话，学完即可副业变现！", "playlist_id": "BV1D5Gi6QEN7", "playlist_title": "【AI零基础入门】清华大佬终于讲完了AIGC全套教程变现课！含AI广告制作+AI绘画+视频视听语言全流程！全程干货无废话，学完即可副业变现！", "playlist_webpage_url": "https://www.bilibili.com/video/BV1D5Gi6QEN7/", "n_entries": 82, "playlist_index": 6, "thumbnails": [{"url": "http://i2.hdslb.com/bfs/archive/ddf2b57576483ae9189affdcd82a8353a0b54e86.jpg", "id": "0"}], "display_id": "BV1D5Gi6QEN7_p6", "fulltitle": "【AI零基础入门】清华大佬终于讲完了AIGC全套教程变