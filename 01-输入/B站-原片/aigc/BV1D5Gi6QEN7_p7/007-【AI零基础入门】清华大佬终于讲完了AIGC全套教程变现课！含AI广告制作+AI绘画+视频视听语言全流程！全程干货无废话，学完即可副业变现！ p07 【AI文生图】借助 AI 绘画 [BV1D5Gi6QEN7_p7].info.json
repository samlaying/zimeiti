": 1920, "height": 1080, "vcodec": "avc1.640033", "acodec": "none", "dynamic_range": "SDR", "tbr": 430.914, "quality": 80, "format_id": "30080", "format": "1080P 高清", "protocol": "https", "video_ext": "mp4", "audio_ext": "none", "abr": 0, "vbr": 430.914, "resolution": "1920x1080", "aspect_ratio": 1.78, "filesize_approx": 41278975, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/141.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.bilibili.com/video/BV1D5Gi6QEN7?p=7"}}], "duration": 766.352, "subtitles": {"danmaku": [{"ext": "xml", "url": "https://comment.bilibili.com/38552797263.xml"}], "ai-zh": [{"ext": "srt", "data": "1\n00:00:00,920 --> 00:00:01,840\n同学们大家好\n\n2\n00:00:01,840 --> 00:00:03,240\n我是你们的子文老师\n\n3\n00:00:03,240 --> 00:00:05,300\n那么这一堂课我们来学习一下\n\n4\n00:00:05,300 --> 00:00:10,140\n如何借助AI工具去绘制一个儿童睡前故事的插\n\n5\n00:00:10,140 --> 00:00:11,309\n画的画面\n\n6\n00:00:11,309 --> 00:00:11,869\n呃\n\n7\n00:00:11,869 --> 00:00:14,809\n我们现在有一个原创的儿童故事\n\n8\n00:00:14,809 --> 00:00:17,759\n我们可以看一下他的故事的梗概\n\n9\n00:00:17,759 --> 00:00:19,399\n那么在这里面的话呢\n\n10\n00:00:19,399 --> 00:00:20,939\n有一个概要写的是\n\n11\n00:00:20,939 --> 00:00:23,519\n莉莉是一个喜欢冒险的六岁的小女孩\n\n12\n00:00:23,519 --> 00:00:26,900\n她最好的朋友是一只名叫泰迪的小熊玩偶\n\n13\n00:00:26,900 --> 00:00:28,540\n每天晚上睡觉以前\n\n14\n00:00:28,540 --> 00:00:29,900\n丽丽都会抱着泰迪\n\n15\n00:00:29,900 --> 00:00:31,830\n幻想着他们一起冒险的故事\n\n16\n00:00:31,830 --> 00:00:32,750\n这天晚上\n\n17\n00:00:32,750 --> 00:00:35,830\n莉莉和泰迪梦见自己来到了一片神奇的森林\n\n18\n00:00:35,830 --> 00:00:37,710\n森林里有会说话的动物\n\n19\n00:00:37,710 --> 00:00:40,930\n闪闪发光的蘑菇和一棵巨大的悬树\n\n20\n00:00:40,930 --> 00:00:42,210\n在这个森林里\n\n21\n00:00:42,210 --> 00:00:44,970\n泰迪和莉莉经历了各种奇遇\n\n22\n00:00:44,970 --> 00:00:47,310\n帮助森林里的小动物解决问题\n\n23\n00:00:47,310 --> 00:00:48,989\n最终找到了许愿树\n\n24\n00:00:48,989 --> 00:00:50,729\n树上结满了星星果实\n\n25\n00:00:50,729 --> 00:00:53,300\n每一颗都能实现一个美好的梦想\n\n26\n00:00:53,300 --> 00:00:54,520\n那么在这里\n\n27\n00:00:54,520 --> 00:00:57,790\n我们把这个故事的概要给它分成了五个场景\n\n28\n00:00:57,790 --> 00:01:00,570\n第一个呢是莉莉和泰迪进入了梦境森林\n\n29\n00:01:00,570 --> 00:01:04,069\n第二个是与森林的小红小小动物们进行互动\n\n30\n00:01:04,069 --> 00:01:07,490\n第三个是发现了闪闪发光的蘑菇花园\n\n31\n00:01:07,490 --> 00:01:09,490\n第四个呢是寻找许愿树\n\n32\n00:01:09,490 --> 00:01:12,479\n第五个是回到床上醒来的丽丽和泰迪\n\n33\n00:01:12,479 --> 00:01:15,139\n那我们可以看到一共是五幅画面\n\n34\n00:01:15,139 --> 00:01:17,940\n我们对这五幅画面呢去进行描述\n\n35\n00:01:17,940 --> 00:01:20,240\n那并且呢用这个MAD journey\n\n36\n00:01:20,240 --> 00:01:22,750\n这个AI工具去给它出画面\n\n37\n00:01:22,750 --> 00:01:25,270\n在这里面我们需要注意的一个问题\n\n38\n00:01:25,270 --> 00:01:27,230\n就是那莉莉和泰迪熊\n\n39\n00:01:27,230 --> 00:01:29,580\n这是两个呃角色的形象\n\n40\n00:01:29,580 --> 00:01:30,980\n那么这个角色形象呢\n\n41\n00:01:30,980 --> 00:01:33,600\n我们是需要通过提示词去给他\n\n42\n00:01:33,600 --> 00:01:35,800\n保持角色的一致性的好\n\n43\n00:01:35,800 --> 00:01:39,200\n那么我们来看一看相关的提示词是怎么写的\n\n44\n00:01:39,640 --> 00:01:41,880\n首先第一个场景就是\n\n45\n00:01:41,880 --> 00:01:43,720\n丽丽和泰迪进入了梦境森林\n\n46\n00:01:43,720 --> 00:01:48,100\n我们把这个提示词呢呃可以先放到翻译软件里\n\n47\n00:01:48,100 --> 00:01:49,940\n给大家看一下它是怎么写的\n\n48\n00:01:49,940 --> 00:01:52,190\n首先一个就是神奇\n\n49\n00:01:52,190 --> 00:01:55,399\n一个神奇的梦幻的森林的入口\n\n50\n00:01:55,399 --> 00:01:59,399\n然后呢一个六岁的棕棕色短发的女孩穿着睡衣\n\n51\n00:01:59,399 --> 00:02:00,650\n抱着她的泰迪熊\n\n52\n00:02:00,650 --> 00:02:05,030\n那我们可以看到这里面描写的是六岁棕色短发\n\n53\n00:02:05,030 --> 00:02:06,510\n一个女孩对吧\n\n54\n00:02:06,510 --> 00:02:09,630\n那么这就是对他人物角色的一个描述\n\n55\n00:02:09,630 --> 00:02:11,670\n那你后期所有的这个画面上\n\n56\n00:02:11,670 --> 00:02:14,050\n都应该有同样的这个角色描述\n\n57\n00:02:14,050 --> 00:02:17,210\n这样的话他角色的一致性就可以保持\n\n58\n00:02:17,210 --> 00:02:18,810\n那还有其他的啊\n\n59\n00:02:18,810 --> 00:02:21,410\n这就是关于整个画面的一个幻想\n\n60\n00:02:21,410 --> 00:02:23,610\n你可以想他有柔和的月光\n\n61\n00:02:23,610 --> 00:02:25,610\n有发光蘑菇的小鹿对吧\n\n62\n00:02:25,610 --> 00:02:27,530\n有梦幻般的氛围等等啊\n\n63\n00:02:27,530 --> 00:02:29,330\n童话书的这种风格\n\n64\n00:02:29,330 --> 00:02:33,030\n最后呢还会有一些个呃质量词的一些个描述\n\n65\n00:02:33,030 --> 00:02:37,400\n那么我们把这一段提示词发送到MAD jy里\n\n66\n00:02:37,400 --> 00:02:41,240\n我们可以看一下他给我们一个什么样的结果\n\n67\n00:02:44,940 --> 00:02:47,960\n在这里我们在对话框上输入一个斜杠\n\n68\n00:02:47,960 --> 00:02:50,630\n然后呢去选择一下MAD journey\n\n69\n00:02:50,630 --> 00:02:52,810\n然后再给它进行粘贴\n\n70\n00:02:52,810 --> 00:02:53,990\n粘贴过来以后呢\n\n71\n00:02:53,990 --> 00:02:57,260\n再摁摁一下回车去给它进行确定\n\n72\n00:02:57,260 --> 00:02:59,460\n这回我们就等待他给我们返\n\n73\n00:02:59,460 --> 00:03:01,660\n返回一个结果就可以了\n\n74\n00:03:03,260 --> 00:03:04,980\n有这个程序位未响应\n\n75\n00:03:04,980 --> 00:03:05,720\n没有关系啊\n\n76\n00:03:05,720 --> 00:03:07,380\n摁一下向上箭头\n\n77\n00:03:07,380 --> 00:03:09,800\n把我们刚才输入的这段提示词\n\n78\n00:03:09,800 --> 00:03:12,920\n就可以重新出现在这个输入栏里\n\n79\n00:03:12,920 --> 00:03:15,280\n然后我们再去点一下回车\n\n80\n00:03:19,700 --> 00:03:21,820\n好我们可以看到啊\n\n81\n00:03:21,820 --> 00:03:24,290\n现在出现的一共是四幅画面\n\n82\n00:03:24,290 --> 00:03:25,770\n在这四幅画面里面呢\n\n83\n00:03:25,770 --> 00:03:27,130\n我们需要选择一幅\n\n84\n00:03:27,130 --> 00:03:27,810\n在这里\n\n85\n00:03:27,810 --> 00:03:30,690\n我们觉得第一幅就相对来说是比\n\n86\n00:03:30,690 --> 00:03:31,830\n较符合我们的要求的\n\n87\n00:03:31,830 --> 00:03:34,350\n她是能够看到一个棕色短发的小女孩\n\n88\n00:03:34,350 --> 00:03:35,910\n怀里抱了一个泰迪熊\n\n89\n00:03:35,910 --> 00:03:38,410\n那旁边的话呢有这种荧光蘑菇\n\n90\n00:03:38,410 --> 00:03:39,150\n还有小路\n\n91\n00:03:39,150 --> 00:03:40,170\n还有森林\n\n92\n00:03:40,170 --> 00:03:42,830\n这是我们能看到这个人物形象的\n\n93\n00:03:42,830 --> 00:03:44,330\n而其他三幅的话呢\n\n94\n00:03:44,330 --> 00:03:45,530\n虽然画面也挺漂亮\n\n95\n00:03:45,530 --> 00:03:48,260\n但是呢他这个人物形象是一个背影\n\n96\n00:03:48,260 --> 00:03:50,560\n当然不代表这个背影就完全不能用\n\n97\n00:03:50,560 --> 00:03:53,860\n我们可以把它当成一个过渡的画面是可以的哈\n\n98\n00:03:53,860 --> 00:03:56,340\n所以我们想要其中一幅画面的时候呢\n\n99\n00:03:56,340 --> 00:04:00,790\n就直接点击U1U1就是代表我想要第一幅画\n\n100\n00:04:00,790 --> 00:04:05,360\n可以单独的去把它进行放大好\n\n101\n00:04:05,360 --> 00:04:07,240\n这样的话第一幅就可以放大了\n\n102\n00:04:07,240 --> 00:04:08,660\n但是你要想要第二幅\n\n103\n00:04:08,660 --> 00:04:09,960\n你就直接点击U2\n\n104\n00:04:09,960 --> 00:04:13,990\n这样的话呢第二幅就可以在下面进行放大\n\n105\n00:04:15,060 --> 00:04:16,140\n如果有交互失败\n\n106\n00:04:16,140 --> 00:04:16,740\n没关系啊\n\n107\n00:04:16,740 --> 00:04:18,579\n再重新点一次\n\n108\n00:04:19,660 --> 00:04:21,100\n好你看这样的话\n\n109\n00:04:21,100 --> 00:04:23,160\n第二幅就已经放大了对吧\n\n110\n00:04:23,160 --> 00:04:25,080\n那再想要把它下载的话呢\n\n111\n00:04:25,080 --> 00:04:26,380\n点击一下这幅图\n\n112\n00:04:26,380 --> 00:04:29,240\n右键给它一个图片另存为就OK了啊\n\n113\n00:04:29,330 --> 00:04:31,190\n这是我们得到的第一张\n\n114\n00:04:31,190 --> 00:04:37,120\n那么第二个场景我们来看一下第二个场景呢\n\n115\n00:04:37,120 --> 00:04:38,560\n提示词复制一下\n\n116\n00:04:38,560 --> 00:04:44,240\n她是呢呃小女孩与一些个小动物去进行互动\n\n117\n00:04:44,750 --> 00:04:47,050\n同样我们去选择一下MAD journey\n\n118\n00:04:47,050 --> 00:04:49,170\n然后CTRLV粘贴在这里\n\n119\n00:04:49,170 --> 00:04:51,430\n直接摁一下回车确定\n\n120\n00:04:58,020 --> 00:05:01,140\n那么在这个提示词里我看一下\n\n121\n00:05:01,140 --> 00:05:03,860\n没有规定他的这个画幅\n\n122\n00:05:03,860 --> 00:05:07,220\n这个画幅我们是需要让它和上一幅画面是完\n\n123\n00:05:07,220 --> 00:05:08,080\n全一样的\n\n124\n00:05:08,080 --> 00:05:10,360\n那么待会我们可以看一下他这个画幅\n\n125\n00:05:10,360 --> 00:05:11,260\n如果不对的话\n\n126\n00:05:11,260 --> 00:05:14,760\n我们再把这个画幅参数给它重新输入一遍\n\n127\n00:05:14,760 --> 00:05:17,990\n再重新生成好\n\n128\n00:05:17,990 --> 00:05:18,750\n我们可以看到\n\n129\n00:05:18,750 --> 00:05:19,889\n你看是吧\n\n130\n00:05:19,889 --> 00:05:20,609\n就出来了\n\n131\n00:05:20,609 --> 00:05:22,369\n仍然是四组图片啊\n\n132\n00:05:22,369 --> 00:05:24,909\n那么这四组图片里面分别是小兔子\n\n133\n00:05:24,909 --> 00:05:25,809\n狐狸对吧\n\n134\n00:05:25,809 --> 00:05:27,310\n还有其他的一些小动物\n\n135\n00:05:27,310 --> 00:05:31,110\n那在一个大蘑菇伞下去进行互动喝茶\n\n136\n00:05:31,110 --> 00:05:31,550\n哎\n\n137\n00:05:31,550 --> 00:05:34,330\n非常好的这样的一种氛围感啊\n\n138\n00:05:34,330 --> 00:05:36,070\n那么同样这个小女孩\n\n139\n00:05:36,070 --> 00:05:39,310\n她的特征还是棕色短发是吧\n\n140\n00:05:39,310 --> 00:05:43,130\n哎那在这里我们可以看到他的画面的话呢\n\n141\n00:05:43,130 --> 00:05:44,010\n是一比