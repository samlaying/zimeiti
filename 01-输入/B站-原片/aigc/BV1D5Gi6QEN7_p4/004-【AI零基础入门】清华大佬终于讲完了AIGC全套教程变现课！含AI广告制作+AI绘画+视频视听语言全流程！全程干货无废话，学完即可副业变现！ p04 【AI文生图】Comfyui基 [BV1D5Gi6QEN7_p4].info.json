3546568672151587&gen=playurlv3&oi=771429739&deadline=1780716287&nbs=1&os=bcache&upsig=ac066cfeb8b86e956ebd0c8a5438f68c&uparams=e,og,uipk,platform,trid,mid,gen,oi,deadline,nbs,os&cdnid=70002&bvc=vod&nettype=0&bw=414465&lrs=0&agrr=1&buvid=56CBBADE-6E37-C95A-FAC9-97160BE6D01C13885infoc&build=0&dl=0&f=u_0_0&qn_dyeid=5e667c590aea0d6c009c20aa6a2376df&np=151339102&orderid=0,3", "ext": "mp4", "fps": 30.0, "width": 1920, "height": 1080, "vcodec": "avc1.640033", "acodec": "none", "dynamic_range": "SDR", "tbr": 414.321, "quality": 80, "format_id": "30080", "format": "1080P 高清", "protocol": "https", "video_ext": "mp4", "audio_ext": "none", "abr": 0, "vbr": 414.321, "resolution": "1920x1080", "aspect_ratio": 1.78, "filesize_approx": 28856784, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/141.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.bilibili.com/video/BV1D5Gi6QEN7?p=4"}}, {"url": "https://cn-bj-fx-01-01.bilivideo.com/upgcxcode/74/36/38552733674/38552733674-1-100026.m4s?e=ig8euxZM2rNcNbdlhoNvNC8BqJIzNbfqXBvEqxTEto8BTrNvN0GvT90W5JZMkX_YN0MvXg8gNEV4NC8xNEV4N03eN0B5tZlqNxTEto8BTrNvNeZVuJ10Kj_g2UB02J0mN0B5tZlqNCNEto8BTrNvNC7MTX502C8f2jmMQJ6mqF2fka1mqx6gqj0eN0B599M=&mid=3546568672151587&og=hw&oi=771429739&trid=0000390b91f240f24a9cbfa424b92b1abfcu&deadline=1780716287&gen=playurlv3&os=bcache&nbs=1&uipk=5&platform=pc&upsig=01a10ee45fd34f68979efde028588dba&uparams=e,mid,og,oi,trid,deadline,gen,os,nbs,uipk,platform&cdnid=70001&bvc=vod&nettype=0&bw=282123&lrs=0&dl=0&f=u_0_0&qn_dyeid=5e667c590aea0d6c009c20aa6a2376df&np=151339102&agrr=1&buvid=56CBBADE-6E37-C95A-FAC9-97160BE6D01C13885infoc&build=0&orderid=0,3", "ext": "mp4", "fps": 30.0, "width": 1920, "height": 1080, "vcodec": "av01.0.00M.10.0.110.01.01.01.0", "acodec": "none", "dynamic_range": "SDR", "tbr": 282.004, "quality": 80, "format_id": "100026", "format": "1080P 高清", "protocol": "https", "video_ext": "mp4", "audio_ext": "none", "abr": 0, "vbr": 282.004, "resolution": "1920x1080", "aspect_ratio": 1.78, "filesize_approx": 19641120, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/141.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.bilibili.com/video/BV1D5Gi6QEN7?p=4"}}], "duration": 557.187, "subtitles": {"danmaku": [{"ext": "xml", "url": "https://comment.bilibili.com/38552733674.xml"}], "ai-zh": [{"ext": "srt", "data": "1\n00:00:00,980 --> 00:00:01,860\n同学们大家好\n\n2\n00:00:01,860 --> 00:00:03,180\n我是你们的子文老师\n\n3\n00:00:03,180 --> 00:00:07,230\n这堂课我们来学习一些复杂工作流的操作\n\n4\n00:00:07,230 --> 00:00:10,270\n那么在这里面呢是包含两个部分\n\n5\n00:00:10,270 --> 00:00:13,440\n第一个部分是如何添加LAURA的节点\n\n6\n00:00:13,440 --> 00:00:16,960\n还有一个部分是如何添加control net的节点\n\n7\n00:00:16,960 --> 00:00:20,030\n我们首先来看一下添加LAURA\n\n8\n00:00:20,030 --> 00:00:21,590\n那么添加LAURA的话呢\n\n9\n00:00:21,590 --> 00:00:24,939\n首先是需要加载一个LAURA的加载器\n\n10\n00:00:24,939 --> 00:00:26,939\n那么像这样的一个加载器\n\n11\n00:00:26,939 --> 00:00:28,039\n我们应该如何添加\n\n12\n00:00:28,039 --> 00:00:30,520\n一起来看一下好\n\n13\n00:00:30,520 --> 00:00:31,840\n那在这里面的话\n\n14\n00:00:31,840 --> 00:00:34,560\n我们在空白的地方点击鼠标右键\n\n15\n00:00:34,560 --> 00:00:36,459\n然后选择添加节点\n\n16\n00:00:36,459 --> 00:00:38,639\n在这里面选择一下加载器\n\n17\n00:00:38,639 --> 00:00:41,310\n那其中呢就有一个LAURA加载器\n\n18\n00:00:41,310 --> 00:00:43,110\n我们把它点开以后\n\n19\n00:00:43,110 --> 00:00:46,680\n在这里就可以直接去选择它的参数了\n\n20\n00:00:46,680 --> 00:00:49,300\n首先上面这有一个LAURA的名称\n\n21\n00:00:49,300 --> 00:00:51,960\n那么在这里我们可以去选择一个\n\n22\n00:00:51,960 --> 00:00:53,489\n想要的这种效果\n\n23\n00:00:53,489 --> 00:00:57,049\n比如说我们在这个收藏里面\n\n24\n00:01:10,760 --> 00:01:12,280\n它有的时候不显示\n\n25\n00:01:12,280 --> 00:01:15,160\n那么我们直接去搜一下吧\n\n26\n00:01:22,080 --> 00:01:24,440\n选择一个二次元\n\n27\n00:01:24,440 --> 00:01:29,120\n然后在这里面选择一个1.5的模型\n\n28\n00:01:52,280 --> 00:01:54,240\n点击一下筛选\n\n29\n00:01:54,240 --> 00:01:57,479\n然后1.5OK\n\n30\n00:01:57,479 --> 00:02:02,439\n在这里面找一个效果比较好一点的\n\n31\n00:02:09,720 --> 00:02:11,240\n好就这个吧\n\n32\n00:02:11,240 --> 00:02:13,460\n然后点击一下立即使用\n\n33\n00:02:13,460 --> 00:02:16,720\n这样的话呢他就把这个模型挂载进来了\n\n34\n00:02:16,720 --> 00:02:19,080\n下面的话还有一个模型强度\n\n35\n00:02:19,080 --> 00:02:22,540\n就是我们所说的这个LAURA的权重\n\n36\n00:02:22,540 --> 00:02:23,900\n这个LOL的权重呢\n\n37\n00:02:23,900 --> 00:02:26,540\n我们一开始可以稍微给他调的低一点\n\n38\n00:02:26,540 --> 00:02:27,600\n一个0.8\n\n39\n00:02:27,600 --> 00:02:29,390\nOK好\n\n40\n00:02:29,390 --> 00:02:33,530\n这是我们把它的呃这个LAWA的节点呢打开了\n\n41\n00:02:33,530 --> 00:02:37,329\n并且呢把里面的一些个参数已经调进调进来了\n\n42\n00:02:37,329 --> 00:02:40,769\n接下来就是把它怎么整合到我们整个工作流里\n\n43\n00:02:40,769 --> 00:02:42,169\n想要整合到工作流\n\n44\n00:02:42,169 --> 00:02:45,079\n就是要去看前边的这两个节点\n\n45\n00:02:45,079 --> 00:02:46,239\n一个是模型\n\n46\n00:02:46,239 --> 00:02:47,359\n一个是clip\n\n47\n00:02:47,359 --> 00:02:48,079\n所以说呢\n\n48\n00:02:48,079 --> 00:02:53,290\n我们首先是可以把前边的这个模型给它\n\n49\n00:02:53,610 --> 00:02:55,930\n直接加载过来放到这儿\n\n50\n00:02:55,930 --> 00:03:00,180\n然后下面它这个原来大模型的这个节点上\n\n51\n00:03:00,180 --> 00:03:03,710\n还有一个线是连到了这边\n\n52\n00:03:03,710 --> 00:03:05,950\n连到了这个K采样器上\n\n53\n00:03:05,950 --> 00:03:10,080\n我们可以把这个K采样器的直接给它拽下来\n\n54\n00:03:10,080 --> 00:03:12,140\n先让模型连模型\n\n55\n00:03:12,140 --> 00:03:15,989\n这边这个模型再去连到采样器好\n\n56\n00:03:15,989 --> 00:03:18,549\n然后接下来呢是clip clip的话\n\n57\n00:03:18,549 --> 00:03:21,289\n这里面是可以直接把它摘过来\n\n58\n00:03:21,289 --> 00:03:22,869\n连到这边这个clip\n\n59\n00:03:22,869 --> 00:03:25,750\n然后把出口的这个CLICLIP\n\n60\n00:03:25,750 --> 00:03:29,110\n连到我们的正向提示词\n\n61\n00:03:29,110 --> 00:03:31,790\n再连一个连到负向提示词\n\n62\n00:03:31,790 --> 00:03:32,790\n这样一来的话\n\n63\n00:03:32,790 --> 00:03:35,910\n我们这个LAURA的节点就串联好了\n\n64\n00:03:35,910 --> 00:03:36,950\n我们可以看一下啊\n\n65\n00:03:36,950 --> 00:03:38,670\n这个连线是怎么连的\n\n66\n00:03:38,670 --> 00:03:43,960\n模型连模型clip连clip在出口的这个位置\n\n67\n00:03:43,960 --> 00:03:45,320\n出口的这个位置\n\n68\n00:03:45,320 --> 00:03:46,820\n那么同样是clip\n\n69\n00:03:46,820 --> 00:03:50,380\n然后把它分别连到正反提示词上\n\n70\n00:03:50,380 --> 00:03:52,260\n这样的话我们就可以了啊\n\n71\n00:03:52,260 --> 00:03:55,160\n这边这个模型的出口连到K采样器上\n\n72\n00:03:55,160 --> 00:03:56,120\n这就可以了\n\n73\n00:03:56,120 --> 00:03:58,480\n那么我们一个LOA是这么加\n\n74\n00:03:58,480 --> 00:04:00,420\n如果你是多个LOA的话\n\n75\n00:04:00,420 --> 00:04:02,640\n也是一样的串联方法\n\n76\n00:04:02,640 --> 00:04:06,580\n比如说我再把它alt键复制一个新的出来\n\n77\n00:04:06,580 --> 00:04:09,940\n那么这回这个模型就可以连到这好\n\n78\n00:04:09,940 --> 00:04:11,160\n然后这边摘下来\n\n79\n00:04:11,160 --> 00:04:14,380\n不要把这个模型呢哎摘到这个地方\n\n80\n00:04:14,380 --> 00:04:17,790\nclip也是把它连到这儿来\n\n81\n00:04:17,790 --> 00:04:21,329\n然后这边去连正向提示词\n\n82\n00:04:21,329 --> 00:04:23,450\n再去连负向提示词\n\n83\n00:04:23,450 --> 00:04:27,170\n这样的话就是两个LAURA串联在一起\n\n84\n00:04:27,170 --> 00:04:30,260\n所以这就是我们LAURA的加法\n\n85\n00:04:30,260 --> 00:04:32,760\n当然呃我们加完完事以后\n\n86\n00:04:32,760 --> 00:04:34,460\n还可以去点击一下运行\n\n87\n00:04:34,460 --> 00:04:35,320\n我这是两个\n\n88\n00:04:35,320 --> 00:04:36,860\n我第二个呢可以给它删掉\n\n89\n00:04:36,860 --> 00:04:38,020\n不要它好\n\n90\n00:04:38,020 --> 00:04:40,090\n这样的话就可以又重新连上\n\n91\n00:04:40,090 --> 00:04:43,650\n但是我们可以再去给它进行一下点击运行\n\n92\n00:04:43,650 --> 00:04:47,830\n它就可以把我们刚才加的LAURA的这个效果\n\n93\n00:04:48,150 --> 00:04:51,930\n在最终的这个效果上给它体现出来好\n\n94\n00:04:51,930 --> 00:04:52,830\n那么以上呢\n\n95\n00:04:52,830 --> 00:04:56,590\n就是我们如何去加载一个LAURA的节点\n\n96\n00:04:56,590 --> 00:05:00,000\n接下来说如果是control net的话\n\n97\n00:05:00,000 --> 00:05:02,180\n我们应该如何添加好\n\n98\n00:05:02,180 --> 00:05:05,830\n我们回到PPT里看一下\n\n99\n00:05:06,310 --> 00:05:08,810\n如果想要添加一个TONNET的话\n\n100\n00:05:08,810 --> 00:05:11,770\n它是需要添加以下几个节点的\n\n101\n00:05:11,770 --> 00:05:14,400\n首先呢我们就需要有一个图像\n\n102\n00:05:14,400 --> 00:05:17,800\n这个图像如果要是体现在外部UI里\n\n103\n00:05:17,800 --> 00:05:18,740\n它是什么样呢\n\n104\n00:05:18,740 --> 00:05:19,960\n我们一起来看一下啊\n\n105\n00:05:19,960 --> 00:05:22,210\n对比一下web ui\n\n106\n00:05:22,690 --> 00:05:24,290\n那么在web ui里\n\n107\n00:05:25,330 --> 00:05:28,460\n我们下面这个是control net的插件\n\n108\n00:05:28,460 --> 00:05:30,620\n当我把Ctrl net展开以后\n\n109\n00:05:30,620 --> 00:05:32,660\n你会发现这个位置会有一个\n\n110\n00:05:32,660 --> 00:05:34,320\n让你上传图片的地方\n\n111\n00:05:34,320 --> 00:05:38,890\n那么它呢其实对应到我们康复UI的工作流的话\n\n112\n00:05:38,890 --> 00:05:43,290\n就相当于我们把PPT打开\n\n113\n00:05:43,290 --> 00:05:46,450\n就相当于我们这个加载图像\n\n114\n00:05:46,450 --> 00:05:51,190\n然后下面还有一个就是TANI的预处理器\n\n115\n00:05:51,190 --> 00:05:57,190\n这个预处理器就相当于我们web ui里这个地方\n\n116\n00:05:57,190 --> 00:06:00,570\n你是需要选择一下canny这个选项的\n\n117\n00:06:00,570 --> 00:06:05,200\n他呢就相当于刚才我们看到的这个节点\n\n118\n00:06:05,200 --> 00:06:09,440\n然后还有一个就是叫做control net的加载器\n\n119\n00:06:09,440 --> 00:06:13,070\n这个加载器其实就是我们control net的模型\n\n120\n00:06:13,070 --> 00:06:14,570\n我们来一起看一下\n\n121\n00:06:14,570 --> 00:06:17,870\n其实就是相对应的web ui里\n\n122\n00:06:17,870 --> 00:06:22,730\ncontrol net can i这个啊这个选项它的一个模型\n\n123\n00:06:22,730 --> 00:06:26,310\n那么另外还有一个就是它底下的一些个参数\n\n124\n00:06:26,310 --> 00:06:28,290\n比如说像控制权重啊\n\n125\n00:06:28,290 --> 00:06:29,490\n还有起始步数\n\n126\n00:06:29,490 --> 00:06:30,850\n完结步数等等啊\n\n127\n00:06:30,850 --> 00:06:34,490\n这些个参数对应的节点是哪些呢\n\n128\n00:06:34,490 --> 00:06:37,550\n就是下面的这个叫做control net应用啊\n\n129\n00:06:37,550 --> 00:06:39,860\n有个旧版高级这样一个节点\n\n130\n00:06:39,860 --> 00:06:42,760\n在这个节点里就可以看到它的什么强度\n\n131\n00:06:42,760 --> 00:06:44,700\n开始时间结束时间\n\n132\n00:06:44,700 --> 00:06:47,620\n所以我们想添加一个Ctrl net的话\n\n133\n00:06:47,620 --> 00:06:52,749\n就需要1234啊\n\n134\n00:06:52,749 --> 00:06:57,289\n这么四个节点去组成一个control net的功能好\n\n135\n00:06:57,289 --> 00:06:59,869\n那么我们一起来添加一下\n\n136\n00:07:02,400 --> 00:07:04,240\n找到刚才的这个工作流\n\n137\n00:07:04,240 --> 00:07:07,990\n那首先我们要把这个加载图像啊给到他\n\n138\n00:07:07,990 --> 00:07:10,870\n那么加载图像就同一个这个节点\n\n139\n00:07:10,870 --> 00:07:12,190\n我们是可以直接复制的\n\n140\n00:07:12,190 --> 00:07:14,140\n好把它复制一个过来\n\n141\n00:07:14,140 --> 00:07:17,080\n然后接下来呢我们要把第二个啊\n\n142\n00:07:17,080 --> 00:07:20,470\n这个TIMI的预处理器打开\n\n143\n00:07:20,470 --> 00:07:22,990\n那么这个预处理器的话是这样的\n\n144\n00:07:22,990 --> 00:07:25,810\n在空白处点击右键添加节点\n\n145\n00:07:25,810 --> 00:07:30,330\n然后在下面这个二级菜单里向下滚动\n\n146\n00:07:36,740 --> 00:07:40,549\n好这里面有一个control net的预处理器\n\n147\n00:07:40,549 --> 00:07:41,809\n点击它以后\n\n148\n00:07:41,809 --> 00:07:43,489\n再下级菜单里\n\n149\n00:07:43,489 --> 00:07:47,149\n这些才是我们真正的这个Ctrl net里面的\n\n150\n00:07:47,149 --> 00:07:49,030\n一些分类的选项\n\n151\n00:07:49,030 --> 00:07:51,650\n比如说如果我们想要规定一下\n\n152\n00:07:51,650 --> 00:07:54,130\n这个人物形象的外轮廓的线条\n\n153\n00:07:54,130 --> 00:07:57,210\n那你就可以在线条下边去选择\n\n154\n00:07:57,210 --> 00:07:58,360\n比如说candy\n\n155\n00:07:58,360 --> 00:07:59,840\n那么点击它以后\n\n156\n00:07:59,840 --> 00:08:02,800\n我们KY的这个哎预处理器就出来了\n\n157\n00:08:02,800 --> 00:08:04,980\n但是如果你想要其他的也可以\n\n158\n00:08:04,980 --> 00:08:05,960\n我们可以看一下\n\n159\n00:08:05,960 --> 00:08:11,680\n在添加节点下面去找Ctrl net的预处理器好\n\n160\n00:08:11,680 --> 00:08:14,880\n然后像它比如第一个这有个面部与姿态对吧\n\n161\n00:08:14,880 --> 00:08:15,960\n那么点开以后呢\n\n162\n00:08:15,960 --> 00:08:20,020\n他下去菜单里就会有我们经常会用到的open pose啊\n\n163\n00:08:20,020 --> 00:08:22,120\n姿态的预处理器等等\n\n164\n00:08:22,120 --> 00:08:22,740\n好\n\n165\n00:08:22,740 --> 00:08:25,620\n那么这是我们把他的预处理器调出来\n\n166\n00:08:25,620 --> 00:08:30,030\n然后接下来下一个下一个是什么呢\n\n167\n00:08:30,030 --> 00:08:32,000\n就是control net的加载器\n\n168\n00:08:32,000 --> 00:08:35,059\n那control net的加载器既然叫加载器\n\n169\n00:08:35,059 --> 00:08:38,700\n我们肯定是在空白处右键添加节点\n\n170\n00:08:38,700 --> 00:08:40,110\n上面有加载器\n\n171\n00:08:40,110 --> 00:08:42,110\n把加载器点开以后\n\n172\n00:08:42,110 --> 00:08:45,170\n在这里面我们是有Ctrl net加载器的\n\n173\n00:08:45,170 --> 00:08:46,370\n好点它一下\n\n174\n00:08:46,370 --> 00:08:48,890\n这样的话呢加载器就出来了\n\n175\n00:08:48,890 --> 00:08:51,150\n那最后还有一个啊节点\n\n176\n00:08:51,150 --> 00:08:53,120\n就是它里面的这些个参数\n\n177\n00:08:53,120 --> 00:08:54,360\n参数节点的话\n\n178\n00:08:54,360 --> 00:08:57,880\n我们直接在加载器右侧的出口的这个节点\n\n179\n00:08:57,880 --> 00:08:59,390\n拽出一根线\n\n180\n00:08:59,390 --> 00:09:01,810\n然后松手以后下拉菜单\n\n181\n00:09:01,810 --> 00:09:04,960\n这里面选择Ctrl net应用就返高级\n\n182\n00:09:04,960 --> 00:09:08,860\n这样的话就直接出来他下级的这个参数了\n\n183\n00:09:08,860 --> 00:09:11,300\n那我们四个节点出来以后\n\n184\n00:09:11,300 --> 00:09:13,100\n接下来就是连线\n\n185\n00:09:13,100 --> 00:09:17,080\n我们先把这个control net本身四个线条给它连上\n\n"}]}, "webpage_url": "https://www.bilibili.com/video/BV1D5Gi6QEN7?p=4", "webpage_url_basename": "BV1D5Gi6QEN7", "webpage_url_domain": "bilibili.com", "extractor": "BiliBili", "extractor_key": "BiliBili", "playlist_count": 82, "playlist": "【AI零基础入门】清华大佬终于讲完了AIGC全套教程变现课！含AI广告制作+AI绘画+视频视听语言全流程！全程干货无废话，学完即可副业变现！", "playlist_id": "BV1D5Gi6QEN7", "playlist_title": "【AI零基础入门】清华大佬终于讲完了AIGC全套教程变现课！含AI广告制作+AI绘画+视频视听语言全流程！全程干货无废话，学完即可副业变现！", "playlist_webpage_url": "https://www.bilibili.com/video/BV1D5Gi6QEN7/", "n_entries": 82, "playlist_index": 4, "thumbnails": [{"url": "http://i2.hdslb.com/bfs/archive/ddf2b57576483ae9189affdcd82a8353a0b54e86.jpg", "id": "0"}], "display_id": "BV1D5Gi6QEN7_p4", "fulltitle": "【AI零基础入门】清华大佬终于讲完了AIGC全套教程变现课！含AI广告制作+AI绘画+视频视听语言全流程！全程干货无废话，学完即可副业变现！ p04 【AI文生图】Comfyui基础操作（三）", "duration_string": "9:17", "upload_date": "20260523", "epoch": 1780709096, "format": "1080P 高清+30280 - audio only", "format_id": "100026+30280", "ext": "mp4", "protocol": "https+https", "filesize_approx": 25677683, "tbr": 368.67600000000004, "width": 1920, "height": 1080, "resolution": "1920x1080", "fps": 30.0, "dynamic_range": "SDR", "vcodec": "av01.0.00M.10.0.110.01.01.01.0", "vbr": 282.004, "aspect_ratio": 1.78, "acodec": "mp4a.40.2", "abr": 86.672, "_type": "video", "_version": {"version": "2026.03.17", "release_git_head": "04d6974f502bbdfaed72c624344f262e30ad9708", "repository": "yt-dlp/yt-dlp"}}