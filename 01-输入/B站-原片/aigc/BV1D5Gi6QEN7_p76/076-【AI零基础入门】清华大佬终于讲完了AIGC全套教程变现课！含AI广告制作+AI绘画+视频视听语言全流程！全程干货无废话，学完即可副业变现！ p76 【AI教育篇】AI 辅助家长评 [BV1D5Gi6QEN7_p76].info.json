latform=pc&og=hw&mid=3546568672151587&deadline=1780728587&gen=playurlv3&os=estgcos&upsig=b82ee9c7a78c343de00d37d18bdca277&uparams=e,nbs,oi,trid,uipk,platform,og,mid,deadline,gen,os&bvc=vod&nettype=0&bw=74312&lrs=0&build=0&dl=0&f=u_0_0&qn_dyeid=23bd5ef75ce80ff300148b7a6a23a6eb&agrr=0&buvid=56CBBADE-6E37-C95A-FAC9-97160BE6D01C13885infoc&orderid=0,3", "ext": "mp4", "fps": 30.0, "width": 1280, "height": 720, "vcodec": "avc1.640033", "acodec": "none", "dynamic_range": "SDR", "tbr": 74.02, "quality": 64, "format_id": "30064", "format": "720P 准高清", "protocol": "https", "video_ext": "mp4", "audio_ext": "none", "abr": 0, "vbr": 74.02, "resolution": "1280x720", "aspect_ratio": 1.78, "filesize_approx": 2451782, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/138.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.bilibili.com/video/BV1D5Gi6QEN7?p=76"}}, {"url": "https://upos-sz-estgcos.bilivideo.com/upgcxcode/16/52/38553455216/38553455216-1-30080.m4s?e=ig8euxZM2rNcNbdlhoNvNC8BqJIzNbfqXBvEqxTEto8BTrNvN0GvT90W5JZMkX_YN0MvXg8gNEV4NC8xNEV4N03eN0B5tZlqNxTEto8BTrNvNeZVuJ10Kj_g2UB02J0mN0B5tZlqNCNEto8BTrNvNC7MTX502C8f2jmMQJ6mqF2fka1mqx6gqj0eN0B599M=&uipk=5&deadline=1780728587&oi=1875881457&gen=playurlv3&og=cos&platform=pc&mid=3546568672151587&nbs=1&trid=80319024d7d14e978cf1f296434a5b4u&os=estgcos&upsig=5d3ce00643bf681878e058026c1ba26b&uparams=e,uipk,deadline,oi,gen,og,platform,mid,nbs,trid,os&bvc=vod&nettype=0&bw=141050&lrs=0&qn_dyeid=23bd5ef75ce80ff300148b7a6a23a6eb&agrr=0&buvid=56CBBADE-6E37-C95A-FAC9-97160BE6D01C13885infoc&build=0&dl=0&f=u_0_0&orderid=0,3", "ext": "mp4", "fps": 30.0, "width": 1920, "height": 1080, "vcodec": "avc1.640033", "acodec": "none", "dynamic_range": "SDR", "tbr": 140.515, "quality": 80, "format_id": "30080", "format": "1080P 高清", "protocol": "https", "video_ext": "mp4", "audio_ext": "none", "abr": 0, "vbr": 140.515, "resolution": "1920x1080", "aspect_ratio": 1.78, "filesize_approx": 4654313, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/138.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.bilibili.com/video/BV1D5Gi6QEN7?p=76"}}], "duration": 264.986, "subtitles": {"danmaku": [{"ext": "xml", "url": "https://comment.bilibili.com/38553455216.xml"}], "ai-zh": [{"ext": "srt", "data": "1\n00:00:01,260 --> 00:00:02,100\n同学们大家好\n\n2\n00:00:02,100 --> 00:00:03,440\n我是你们的子文老师\n\n3\n00:00:03,440 --> 00:00:05,140\n这堂课我们来学习一下\n\n4\n00:00:09,740 --> 00:00:13,000\n有一句话你可能听过就是孩子的成长\n\n5\n00:00:13,000 --> 00:00:14,980\n父母看得见却摸不清\n\n6\n00:00:14,980 --> 00:00:16,450\n这句话不假\n\n7\n00:00:16,450 --> 00:00:18,390\n作业交了考试考了\n\n8\n00:00:18,390 --> 00:00:19,860\n老师也说还不错\n\n9\n00:00:19,860 --> 00:00:21,840\n可是到底学的扎不扎实\n\n10\n00:00:21,840 --> 00:00:23,420\n哪个知识点理解了\n\n11\n00:00:23,420 --> 00:00:25,380\n哪个地方还总是犯糊涂\n\n12\n00:00:25,380 --> 00:00:28,590\n你作为家长是不是也常常心里没有底\n\n13\n00:00:28,590 --> 00:00:30,820\n有的时候我们陪孩子写作业\n\n14\n00:00:30,820 --> 00:00:32,820\n解的都快要比她还要焦虑\n\n15\n00:00:32,820 --> 00:00:35,660\n有的时候呢孩子明明上了课做了题\n\n16\n00:00:35,660 --> 00:00:37,660\n但是成绩呢却原地踏步\n\n17\n00:00:37,660 --> 00:00:38,750\n像卡了bug\n\n18\n00:00:38,750 --> 00:00:40,150\n我们该怎么办呢\n\n19\n00:00:40,150 --> 00:00:43,570\n这个时候就别只盯着这个成绩单了\n\n20\n00:00:43,570 --> 00:00:46,060\n该上场的其实就是AI\n\n21\n00:00:46,060 --> 00:00:48,720\n我们不是拿AI来替孩子学习\n\n22\n00:00:48,720 --> 00:00:52,480\n而是要让AI辅助我们家长来进行判断\n\n23\n00:00:54,060 --> 00:00:55,950\n哪里是在走神学习\n\n24\n00:00:55,950 --> 00:00:57,970\n哪里是在假装理解\n\n25\n00:00:57,970 --> 00:00:59,890\n哪里是只学的皮毛\n\n26\n00:00:59,890 --> 00:01:02,530\n而哪里是真正的内化吸收了\n\n27\n00:01:02,530 --> 00:01:05,670\n这就像给我们家长配了一双透视眼\n\n28\n00:01:05,670 --> 00:01:07,830\n不是靠感觉去拍脑袋\n\n29\n00:01:07,830 --> 00:01:12,490\n而是呢靠数学逻辑加认知图谱去辅助判断\n\n30\n00:01:12,490 --> 00:01:15,210\n孩子到底到底哪一步出了问题\n\n31\n00:01:15,210 --> 00:01:17,190\n下一步该往哪里走\n\n32\n00:01:17,190 --> 00:01:18,510\n那么在这里面呢\n\n33\n00:01:18,510 --> 00:01:21,560\n我们通过一个提示词模板\n\n34\n00:01:21,560 --> 00:01:24,280\n去评估以上的这些个内容\n\n35\n00:01:24,280 --> 00:01:28,100\n我们来看一看这个提示词是怎么写的\n\n36\n00:01:29,720 --> 00:01:34,080\n好可以看到他写的是你是一位教育认知分析师\n\n37\n00:01:37,680 --> 00:01:39,480\n做出分析和判断\n\n38\n00:01:39,480 --> 00:01:41,919\n那接下来就是输入材料\n\n39\n00:01:41,919 --> 00:01:44,119\n孩子写的语文阅读答案\n\n40\n00:01:44,119 --> 00:01:47,340\n这段话主要讲的是小猫小狗的感情很好\n\n41\n00:01:47,340 --> 00:01:48,260\n阅读原文\n\n42\n00:01:48,260 --> 00:01:51,720\n其实讲的是人和小动物之间的情感建立\n\n43\n00:01:51,720 --> 00:01:54,309\n那么请完成以下的任务\n\n44\n00:01:54,309 --> 00:01:57,609\n一是帮我判断孩子对其中的知识点\n\n45\n00:01:57,609 --> 00:01:58,889\n是否掌握扎实\n\n46\n00:01:58,889 --> 00:01:59,789\n请说明理由\n\n47\n00:01:59,789 --> 00:02:01,090\n不要只下结论\n\n48\n00:02:01,090 --> 00:02:04,450\n第二呢就是指出容易出错的知识盲点\n\n49\n00:02:04,450 --> 00:02:07,020\n并且推测可能的认识误区\n\n50\n00:02:07,020 --> 00:02:09,340\n第三个是提出一到两个\n\n51\n00:02:09,340 --> 00:02:11,720\n具体有效的家庭练习的建议\n\n52\n00:02:11,720 --> 00:02:12,540\n尽量口语化\n\n53\n00:02:12,540 --> 00:02:14,790\n孩子能理解输出的时候\n\n54\n00:02:14,790 --> 00:02:17,600\n请保持语言的自然简洁\n\n55\n00:02:17,600 --> 00:02:19,580\n适合父母阅读使用\n\n56\n00:02:19,580 --> 00:02:22,280\n不要出现技术技术术语\n\n57\n00:02:22,280 --> 00:02:25,750\n也不要有AI的AI枪支词汇好\n\n58\n00:02:25,750 --> 00:02:27,790\n那么像这样的一个模板的话\n\n59\n00:02:27,790 --> 00:02:31,060\n当然里面的一些个内容我们是可以替换的\n\n60\n00:02:33,180 --> 00:02:35,120\n还有像书的材料是什么\n\n61\n00:02:35,120 --> 00:02:39,080\n这些都是可以根据我们实际情况去进行替换好\n\n62\n00:02:39,080 --> 00:02:40,240\n那么我们来看一下\n\n63\n00:02:40,240 --> 00:02:42,760\n他会给我们一个什么样的答案\n\n64\n00:02:48,300 --> 00:02:51,590\n好可以看到他写的是知识点掌握的情况\n\n65\n00:02:51,590 --> 00:02:55,270\n那他的分析是孩子能够抓住感情这个关键词\n\n66\n00:02:55,270 --> 00:02:58,320\n那说明他注意到了文章的情感主题\n\n67\n00:02:58,320 --> 00:03:02,120\n但是呢把人和动物理解为了小猫和小狗\n\n68\n00:03:02,120 --> 00:03:04,269\n可能就是阅读的不够仔细\n\n69\n00:03:04,269 --> 00:03:07,509\n或者被具体的小动物的例子给带偏了\n\n70\n00:03:07,509 --> 00:03:11,840\n整体上呢它是对概括主要内容还不太熟悉\n\n71\n00:03:11,840 --> 00:03:13,800\n容易漏掉重点\n\n72\n00:03:13,800 --> 00:03:16,500\n下面容易出错的知识的盲点\n\n73\n00:03:16,500 --> 00:03:18,350\n第一个呢是混淆角色\n\n74\n00:03:18,350 --> 00:03:21,210\n孩子可能是更关注具体的动物形象\n\n75\n00:03:21,210 --> 00:03:22,670\n比如说小猫小狗的互动\n\n76\n00:03:22,670 --> 00:03:26,130\n而忽略了人才是故事的主要角色\n\n77\n00:03:26,130 --> 00:03:28,350\n下面的是过度的简化嗯\n\n78\n00:03:28,350 --> 00:03:31,350\n把喜欢把内容概括成自己熟悉的场景\n\n79\n00:03:31,350 --> 00:03:32,790\n比如说动物之间的感情\n\n80\n00:03:32,790 --> 00:03:34,190\n这是他比较熟悉的\n\n81\n00:03:34,190 --> 00:03:37,070\n但是呢没有注意到更深层次的含义\n\n82\n00:03:37,070 --> 00:03:38,850\n就是人和动物的关系\n\n83\n00:03:38,850 --> 00:03:41,090\n下面就是家庭练习的建议啊\n\n84\n00:03:41,090 --> 00:03:42,870\n谁在故事里面是最重要的\n\n85\n00:03:42,870 --> 00:03:45,210\n游戏是什么样的过程\n\n86\n00:03:45,210 --> 00:03:47,340\n下面换主角的小练习\n\n87\n00:03:47,340 --> 00:03:49,300\n如果原文讲人和小狗\n\n88\n00:03:49,300 --> 00:03:51,460\n那么这个时候让孩子试改\n\n89\n00:03:51,460 --> 00:03:53,560\n试着改成小猫和小狗的故事\n\n90\n00:03:53,560 --> 00:03:55,340\n再问他意思还一样吗\n\n91\n00:03:55,340 --> 00:03:57,860\n最后呢还会有一个小的提醒\n\n92\n00:03:57,860 --> 00:04:02,200\n那么用这样的一个一个提示提示词结构\n\n93\n00:04:02,200 --> 00:04:05,460\n我们就可以生成一个非常科学严谨\n\n94\n00:04:05,460 --> 00:04:09,040\n而且呢能够落地实践的这样一个练习的建\n\n95\n00:04:09,040 --> 00:04:09,880\n议分析\n\n96\n00:04:09,880 --> 00:04:13,780\n帮助我们大家去和孩子进一步的去学\n\n97\n00:04:13,780 --> 00:04:15,970\n学习和理解好\n\n98\n00:04:15,970 --> 00:04:20,010\n那么以上呢就是如何利用AI工具去帮助大家\n\n99\n00:04:22,070 --> 00:04:23,840\n咱们大家学会了吗\n\n"}]}, "webpage_url": "https://www.bilibili.com/video/BV1D5Gi6QEN7?p=76", "webpage_url_basename": "BV1D5Gi6QEN7", "webpage_url_domain": "bilibili.com", "extractor": "BiliBili", "extractor_key": "BiliBili", "playlist_count": 82, "playlist": "【AI零基础入门】清华大佬终于讲完了AIGC全套教程变现课！含AI广告制作+AI绘画+视频视听语言全流程！全程干货无废话，学完即可副业变现！", "playlist_id": "BV1D5Gi6QEN7", "playlist_title": "【