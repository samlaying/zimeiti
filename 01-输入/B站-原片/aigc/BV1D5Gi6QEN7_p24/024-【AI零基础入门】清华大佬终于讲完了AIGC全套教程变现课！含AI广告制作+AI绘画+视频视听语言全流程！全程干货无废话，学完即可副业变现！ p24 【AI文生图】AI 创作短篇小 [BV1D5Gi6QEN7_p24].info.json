playurlv3&og=ali&nbs=1&uipk=5&mid=3546568672151587&os=akam&upsig=d07f9a648231c38a306ae991b703cdb6&uparams=e,trid,deadline,oi,platform,gen,og,nbs,uipk,mid,os&hdnts=exp=1780724883~hmac=af01c0479d4cdcdc00a0c3630b333a9cb2a045f189a91e2f6e3a84eccadd774f&bvc=vod&nettype=0&bw=247750&lrs=0&qn_dyeid=22d6bacc3472e6d1007f7c206a239873&agrr=0&buvid=56CBBADE-6E37-C95A-FAC9-97160BE6D01C13885infoc&build=0&dl=0&f=u_0_0&orderid=0,2", "ext": "mp4", "fps": 30.0, "width": 1920, "height": 1080, "vcodec": "avc1.640033", "acodec": "none", "dynamic_range": "SDR", "tbr": 247.265, "quality": 80, "format_id": "30080", "format": "1080P 高清", "protocol": "https", "video_ext": "mp4", "audio_ext": "none", "abr": 0, "vbr": 247.265, "resolution": "1920x1080", "aspect_ratio": 1.78, "filesize_approx": 8794505, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/138.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.bilibili.com/video/BV1D5Gi6QEN7?p=24"}}], "duration": 284.537, "subtitles": {"danmaku": [{"ext": "xml", "url": "https://comment.bilibili.com/38552994186.xml"}], "ai-zh": [{"ext": "srt", "data": "1\n00:00:00,820 --> 00:00:01,860\n同学们大家好\n\n2\n00:00:01,860 --> 00:00:03,040\n我是你们的子文老师\n\n3\n00:00:03,040 --> 00:00:05,040\n那么这堂课我们来学习一下\n\n4\n00:00:05,040 --> 00:00:08,530\n如何利用AI工具去创作短篇小说\n\n5\n00:00:08,530 --> 00:00:11,070\n如果呢你是一个小说的作者\n\n6\n00:00:11,070 --> 00:00:13,650\n正在创作一篇短篇的科幻故事\n\n7\n00:00:13,650 --> 00:00:15,770\n但是遇到了一个创作瓶颈\n\n8\n00:00:15,770 --> 00:00:18,830\n也就是说你已经拟拟定了一个基本的设定\n\n9\n00:00:18,830 --> 00:00:20,490\n比如说是在未来世界中\n\n10\n00:00:20,490 --> 00:00:22,150\n人类与AI共存\n\n11\n00:00:22,150 --> 00:00:25,210\n但是呢在故事情节和角色塑造上\n\n12\n00:00:25,210 --> 00:00:26,930\n遇到了一定一定的困难\n\n13\n00:00:26,930 --> 00:00:30,549\n那你现在呢希望利用大圆模型去帮助你\n\n14\n00:00:30,549 --> 00:00:32,389\n去突破这个思维的曲线\n\n15\n00:00:32,389 --> 00:00:34,109\n生成一个新的创业方向\n\n16\n00:00:34,109 --> 00:00:35,970\n这个时候你应该怎么办呢\n\n17\n00:00:35,970 --> 00:00:38,650\n那么在这里面我们可以利用DPSK\n\n18\n00:00:38,650 --> 00:00:40,530\n把相关的提示词给到它\n\n19\n00:00:40,530 --> 00:00:42,250\n我们来看一下\n\n20\n00:00:45,460 --> 00:00:48,170\n好我们看一下这个提示词是怎么写的\n\n21\n00:00:48,170 --> 00:00:49,610\n我正在创作一部\n\n22\n00:00:52,690 --> 00:00:55,629\n主题是人类与AI的共生关系\n\n23\n00:00:55,629 --> 00:00:59,229\n请帮我构思一个3000~5000字的一个故事框架\n\n24\n00:00:59,229 --> 00:01:01,469\n那么下面是它的背景设定啊\n\n25\n00:01:01,469 --> 00:01:04,019\n这个故事发生在二零呃\n\n26\n00:01:05,770 --> 00:01:08,970\n然后人工智能已经获得了有限的法律地位\n\n27\n00:01:08,970 --> 00:01:12,240\n主角是一个30岁的人类神经科学家\n\n28\n00:01:12,240 --> 00:01:15,000\n那么下面有一个呃希望啊\n\n29\n00:01:15,000 --> 00:01:16,120\n就1234点\n\n30\n00:01:16,120 --> 00:01:19,440\n他故事包含人际关系的深度的探讨\n\n31\n00:01:19,440 --> 00:01:21,509\n有一个意想不到的转折\n\n32\n00:01:21,509 --> 00:01:23,649\n结局要留有思考的空间\n\n33\n00:01:23,649 --> 00:01:27,569\n整体风格偏向哲学思维和非纯动作哈\n\n34\n00:01:27,569 --> 00:01:32,300\n这是我们这一个呃作者他自己的一个风格导向\n\n35\n00:01:32,300 --> 00:01:35,770\n或者他自己的一个大的故事脉络的一个把控\n\n36\n00:01:35,770 --> 00:01:38,890\n然后下面的话呢需要让他出一个故事大纲\n\n37\n00:01:38,890 --> 00:01:39,170\n要\n\n38\n00:01:39,170 --> 00:01:40,410\n包括开端发展\n\n39\n00:01:40,410 --> 00:01:41,660\n高潮和结局\n\n40\n00:01:41,660 --> 00:01:44,140\n然后给出一个关键的场景描述\n\n41\n00:01:44,140 --> 00:01:45,460\n和主要的人物设定\n\n42\n00:01:45,460 --> 00:01:48,400\n也可以提供一个两个三个可能创业方向\n\n43\n00:01:48,400 --> 00:01:50,110\n供作者选择\n\n44\n00:01:50,110 --> 00:01:51,970\n所以以上的这个提示词\n\n45\n00:01:51,970 --> 00:01:54,830\n它整个的这个结构咱们大家都是可以学的\n\n46\n00:01:54,830 --> 00:01:57,760\n如果你想要创作其他类型的小说的话\n\n47\n00:01:57,760 --> 00:02:00,580\n除了里面的一些个背景故事设定以外\n\n48\n00:02:00,580 --> 00:02:02,580\n那么你自己希望是什么\n\n49\n00:02:02,580 --> 00:02:03,980\n你也可以给到他对吧\n\n50\n00:02:03,980 --> 00:02:07,800\n那么下面的这个其实我们是可以照搬的啊\n\n51\n00:02:07,800 --> 00:02:10,360\n好我们把这个联网搜索先给它关掉啊\n\n52\n00:02:10,360 --> 00:02:13,120\n当然如果你想点深度思考也是可以的\n\n53\n00:02:13,120 --> 00:02:15,960\n但是呢我们为了这个速度要快一点啊\n\n54\n00:02:15,960 --> 00:02:19,200\n所以我暂时先不点这个深深度思考好\n\n55\n00:02:19,200 --> 00:02:20,840\n那么我们点击一下发送\n\n56\n00:02:20,840 --> 00:02:24,640\n看一看deep sk给我们一个什么样的故事\n\n57\n00:02:26,200 --> 00:02:27,120\n有网络异常\n\n58\n00:02:27,120 --> 00:02:28,260\n我们点击一下\n\n59\n00:02:28,260 --> 00:02:30,040\n重新生成\n\n60\n00:02:43,620 --> 00:02:45,420\n好他已经开始生成了\n\n61\n00:02:45,420 --> 00:02:48,410\n第一个是共生纪元故事大纲呃\n\n62\n00:02:48,410 --> 00:02:51,670\n开端是一个镜像诊断神经科学家\n\n63\n00:02:51,670 --> 00:02:54,310\n这是应这个作者要求的哈\n\n64\n00:02:54,310 --> 00:02:56,930\n然后他有故事背景的铺垫\n\n65\n00:02:56,930 --> 00:03:02,510\n冲突的引入发展高潮结局\n\n66\n00:03:03,370 --> 00:03:06,610\n那还有关键场景的描述\n\n67\n00:03:07,860 --> 00:03:10,200\n这个DVC这个工具呃\n\n68\n00:03:10,200 --> 00:03:11,720\n他的一个非常大的优势\n\n69\n00:03:11,720 --> 00:03:13,780\n就是他对于编故事这件事\n\n70\n00:03:13,780 --> 00:03:16,860\n对于人文方面的东西他是非常擅长的\n\n71\n00:03:16,860 --> 00:03:18,840\n我们如果要是对与他对话\n\n72\n00:03:18,840 --> 00:03:20,220\n给他一个角色设定\n\n73\n00:03:20,220 --> 00:03:22,410\n或者是让他写小说啊\n\n74\n00:03:22,410 --> 00:03:23,810\n或者让他写一篇文章\n\n75\n00:03:23,810 --> 00:03:25,510\n他都非常非常的擅长\n\n76\n00:03:25,510 --> 00:03:29,170\n而且他对于中文的理解是非常好的啊\n\n77\n00:03:29,170 --> 00:03:34,590\n好这是他给到的一个小说的整体的导向\n\n78\n00:03:34,590 --> 00:03:35,370\n我们可以看到啊\n\n79\n00:03:35,370 --> 00:03:36,570\n这是开端对吧\n\n80\n00:03:36,570 --> 00:03:38,270\n哎然后有一个发展\n\n81\n00:03:38,270 --> 00:03:40,430\n双向感染异常扩散\n\n82\n00:03:40,430 --> 00:03:42,480\n秘密调查身份疑云\n\n83\n00:03:42,480 --> 00:03:44,200\n咱们看那个大纲的话\n\n84\n00:03:44,200 --> 00:03:47,800\n我们都会觉得嗯这是一篇很有意思的小说对吧\n\n85\n00:03:47,800 --> 00:03:49,770\n哎高潮还有结局啊\n\n86\n00:03:49,770 --> 00:03:51,010\n关键场景的描述\n\n87\n00:03:51,010 --> 00:03:55,150\n全息的诊疗室数据坟场记忆深渊啊\n\n88\n00:03:55,150 --> 00:03:57,350\n然后下面有角色的设定\n\n89\n00:03:57,350 --> 00:04:01,890\n林夏这是刚才的那个医生莫比乌斯\n\n90\n00:04:01,890 --> 00:04:03,850\n然后陈部长啊\n\n91\n00:04:03,850 --> 00:04:05,910\n创意的方向嗯\n\n92\n00:04:05,910 --> 00:04:09,540\n缸中之脑反向进化哲思的锚点\n\n93\n00:04:09,540 --> 00:04:12,420\n当AI成为人类心里的镜子\n\n94\n00:04:12,420 --> 00:04:15,710\n镜中的影像是否比本体更真实\n\n95\n00:04:15,710 --> 00:04:19,630\n法律定义的人格与神经科学家定义的意识\n\n96\n00:04:19,630 --> 00:04:20,649\n之间的鸿沟\n\n97\n00:04:20,649 --> 00:04:24,790\n集体记忆对于个体身份的侵蚀性塑造啊\n\n98\n00:04:24,790 --> 00:04:26,430\n非常的啊\n\n99\n00:04:26,430 --> 00:04:29,570\n引人引人深思的一种就是意识哈\n\n100\n00:04:29,570 --> 00:04:33,560\n所以呢以上就是一个非常好的利用呃\n\n101\n00:04:33,560 --> 00:04:34,720\n人工智能是吧\n\n102\n00:04:34,720 --> 00:04:39,020\n利用这个AI啊去给我们创作短篇小说的方法\n\n103\n00:04:39,020 --> 00:04:41,420\n那么以上大家学会了吗\n\n"}]}, "webpage_url": "https://www.bilibili.com/video/BV1D5Gi6QEN7?p=24", "webpage_url_basename": "BV1D5Gi6QEN7", "webpage_url_domain": "bilibili.com", "extractor": "BiliBili", "extractor_key": "BiliBili", "playlist_count": 82, "playlist": "【AI零基础入门】清华大佬终于讲完了AIGC全套教程变现课！含AI广告制作+AI绘画+视频视听语言全流程！全程干货无废话，学完即可副业变现！", "playlist_id": "BV1D5Gi6QEN7", "playlist_title": "【AI零基础入门】清华大佬终于讲完了AIGC全套教程变现课！含AI广告制作+AI绘画+视频视听语言全流程！全程干货无废话，学完即可副业变现！", "playlist_webpage_url": "https://www.bilibili.com/video/BV1D5Gi6QEN7/", "n_entries": 64, "playlist_index": 24, "thumbnails": [{"url": "http://i2.hdslb.com/bfs/archive/ddf2b57576483ae9189affdcd82a8353a0b54e86.jpg", "id": "0"}], "display_id": "BV1D5Gi6QEN7_p24", "fulltitle": "【AI零基础入门】清华大佬终于讲完了AIGC全套教程变现课！含AI广告制作+AI绘画+视频视听语言全流程！全程干货无废话，学完即可副业变现！ p24 【AI文生图】AI 创作短篇小说", "duration_string": "4:44", "upload_date": "20260523", "epoch": 1780717697, "format": "1080P 高清+30280 - audio only", "format_id": "30080+30280", "ext": "mp4", "protocol": "https+https", "filesize_approx": 12091079, "tbr": 339.951, "width": 1920, "height": 1080, "resolution": "1920x1080", "fps": 30.0, "dynamic_range": "SDR", "vcodec": "avc1.640033", "vbr": 247.265, "aspect_ratio": 1.78, "acodec": "mp4a.40.2", "abr": 92.686, "_type": "video", "_version": {"version": "2026.03.17", "release_git_head": "04d6974f502bbdfaed72c624344f262e30ad9708", "repository": "yt-dlp/yt-dlp"}}