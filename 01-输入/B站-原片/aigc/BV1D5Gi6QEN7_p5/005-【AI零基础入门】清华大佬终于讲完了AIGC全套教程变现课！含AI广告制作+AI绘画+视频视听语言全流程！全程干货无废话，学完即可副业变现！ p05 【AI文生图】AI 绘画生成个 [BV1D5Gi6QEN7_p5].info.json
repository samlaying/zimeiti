&nbs=1&gen=playurlv3&og=hw&trid=00007151878a67734921b0836e22118e7ccu&uipk=5&upsig=b7d5f0fcd34381f9ca534b2a96784fa0&uparams=e,oi,platform,mid,os,deadline,nbs,gen,og,trid,uipk&cdnid=70001&bvc=vod&nettype=0&bw=311904&lrs=0&build=0&dl=0&f=u_0_0&qn_dyeid=bae6292850da56ec0009eb636a23771e&np=151339102&agrr=1&buvid=56CBBADE-6E37-C95A-FAC9-97160BE6D01C13885infoc&orderid=0,3", "ext": "mp4", "fps": 30.0, "width": 1920, "height": 1080, "vcodec": "avc1.640033", "acodec": "none", "dynamic_range": "SDR", "tbr": 311.851, "quality": 80, "format_id": "30080", "format": "1080P 高清", "protocol": "https", "video_ext": "mp4", "audio_ext": "none", "abr": 0, "vbr": 311.851, "resolution": "1920x1080", "aspect_ratio": 1.78, "filesize_approx": 12125351, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/141.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.bilibili.com/video/BV1D5Gi6QEN7?p=5"}}, {"url": "https://cn-bj-fx-01-01.bilivideo.com/upgcxcode/94/45/38552734594/38552734594-1-100026.m4s?e=ig8euxZM2rNcNbdlhoNvNC8BqJIzNbfqXBvEqxTEto8BTrNvN0GvT90W5JZMkX_YN0MvXg8gNEV4NC8xNEV4N03eN0B5tZlqNxTEto8BTrNvNeZVuJ10Kj_g2UB02J0mN0B5tZlqNCNEto8BTrNvNC7MTX502C8f2jmMQJ6mqF2fka1mqx6gqj0eN0B599M=&nbs=1&oi=771429739&mid=3546568672151587&gen=playurlv3&deadline=1780716350&uipk=5&platform=pc&os=bcache&og=cos&trid=00007151878a67734921b0836e22118e7ccu&upsig=49e5352e788faae96610f44afda30087&uparams=e,nbs,oi,mid,gen,deadline,uipk,platform,os,og,trid&cdnid=70001&bvc=vod&nettype=0&bw=225878&lrs=0&build=0&dl=0&f=u_0_0&qn_dyeid=bae6292850da56ec0009eb636a23771e&np=151339102&agrr=1&buvid=56CBBADE-6E37-C95A-FAC9-97160BE6D01C13885infoc&orderid=0,3", "ext": "mp4", "fps": 30.0, "width": 1920, "height": 1080, "vcodec": "av01.0.00M.10.0.110.01.01.01.0", "acodec": "none", "dynamic_range": "SDR", "tbr": 225.807, "quality": 80, "format_id": "100026", "format": "1080P 高清", "protocol": "https", "video_ext": "mp4", "audio_ext": "none", "abr": 0, "vbr": 225.807, "resolution": "1920x1080", "aspect_ratio": 1.78, "filesize_approx": 8779799, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/141.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.bilibili.com/video/BV1D5Gi6QEN7?p=5"}}], "duration": 311.055, "subtitles": {"danmaku": [{"ext": "xml", "url": "https://comment.bilibili.com/38552734594.xml"}], "ai-zh": [{"ext": "srt", "data": "1\n00:00:00,620 --> 00:00:01,700\n同学们大家好\n\n2\n00:00:01,700 --> 00:00:02,940\n我是你们的子文老师\n\n3\n00:00:02,940 --> 00:00:05,100\n那么这堂课呢我们来学习一下\n\n4\n00:00:05,100 --> 00:00:09,260\n如何利用AI工具去生成一个个性化的手机壁纸\n\n5\n00:00:09,260 --> 00:00:11,700\n假如你刚从巴厘岛度假回来\n\n6\n00:00:11,700 --> 00:00:14,100\n那么想要一张能够唤起美好回忆\n\n7\n00:00:14,100 --> 00:00:16,560\n又符合个人审美的一个手机壁纸\n\n8\n00:00:16,560 --> 00:00:18,710\n那么这个时候你应该怎么办呢\n\n9\n00:00:18,710 --> 00:00:21,870\n首先我们可以利用一下deep sc这个工具\n\n10\n00:00:21,870 --> 00:00:23,930\n那么把我们的要求发送给他\n\n11\n00:00:23,930 --> 00:00:27,190\n让他来给我们生成一段提示词\n\n12\n00:00:28,480 --> 00:00:31,729\n好我们来看一下这段要求\n\n13\n00:00:31,729 --> 00:00:34,729\n近期我们是去过巴厘岛海滩度假\n\n14\n00:00:34,729 --> 00:00:37,700\n喜欢的日落时分的一个宁静的氛围\n\n15\n00:00:37,700 --> 00:00:40,300\n偏好是极简主义的设计风格\n\n16\n00:00:40,300 --> 00:00:42,830\n喜欢的是蓝色和金色的这样一个配色\n\n17\n00:00:42,830 --> 00:00:46,010\n那么希望壁纸能够融入一些巴厘岛的特色元素\n\n18\n00:00:46,010 --> 00:00:48,370\n比如说传统的建筑风格等等\n\n19\n00:00:48,370 --> 00:00:50,890\n那要告诉他你的手机型号哈\n\n20\n00:00:50,890 --> 00:00:57,100\n那接下接下来呢我们可以让他去加加上一句话\n\n21\n00:01:00,440 --> 00:01:01,520\n给我出\n\n22\n00:01:03,760 --> 00:01:11,740\n一套用于MJ出图的提示词\n\n23\n00:01:12,060 --> 00:01:15,220\n那么MJ呢就是我们以前曾经提到过的\n\n24\n00:01:15,220 --> 00:01:16,060\nMAD journey啊\n\n25\n00:01:16,060 --> 00:01:17,780\n这个呃AI工具\n\n26\n00:01:17,780 --> 00:01:22,100\n那么它呢出一些个图片类的是非常漂亮的好\n\n27\n00:01:22,100 --> 00:01:25,300\n那么接下来我们来发送一下\n\n28\n00:01:30,580 --> 00:01:34,200\n这个时候呢他就开始给我们出现结果了\n\n29\n00:01:34,200 --> 00:01:35,860\n那如果遇到了网络异常\n\n30\n00:01:35,860 --> 00:01:36,420\n没关系\n\n31\n00:01:36,420 --> 00:01:38,820\n我们点击一下重新生成\n\n32\n00:02:02,280 --> 00:02:06,300\n好这回他就开始给我们生成一些个提示词\n\n33\n00:02:06,300 --> 00:02:08,380\n上面的话呢是英文的部分\n\n34\n00:02:08,380 --> 00:02:10,008\n这是我们可以直接利用的\n\n35\n00:02:10,008 --> 00:02:12,289\n下面的话那是一些中文的翻译\n\n36\n00:02:12,289 --> 00:02:14,569\n我们可以进行参考\n\n37\n00:02:15,570 --> 00:02:16,990\n在这些提示词中\n\n38\n00:02:16,990 --> 00:02:21,130\n我们要知道它并不是每一个都是合适的啊\n\n39\n00:02:21,130 --> 00:02:23,290\n我们是需要自己去修改\n\n40\n00:02:23,290 --> 00:02:25,770\n然后呢或者是多刷几遍\n\n41\n00:02:25,770 --> 00:02:28,590\n看一看哪个是最理想的好\n\n42\n00:02:28,590 --> 00:02:31,350\n那么我们先试验一个呃\n\n43\n00:02:31,350 --> 00:02:34,280\n第一个极简主义的日落剪影版\n\n44\n00:02:34,280 --> 00:02:36,000\n那么在这里面要注意哈\n\n45\n00:02:36,000 --> 00:02:37,960\n它里面有一些个内容是不对的\n\n46\n00:02:37,960 --> 00:02:40,700\n你比如说像这个AR19比九的这个\n\n47\n00:02:40,700 --> 00:02:43,240\n那我们是需要给它调整一下这个比例\n\n48\n00:02:43,240 --> 00:02:44,940\n就是它的画幅的比例\n\n49\n00:02:44,940 --> 00:02:46,480\nCTRLC复制\n\n50\n00:02:46,480 --> 00:02:49,960\n然后来到我们的这个哎MAD journey里\n\n51\n00:02:49,960 --> 00:02:52,220\n这是discord社区里面的MAD journey啊\n\n52\n00:02:52,220 --> 00:02:55,760\n我们先在输入栏里输入一个斜杠\n\n53\n00:02:55,760 --> 00:02:58,900\n然后去选择一下MAD journey的这个机器人\n\n54\n00:02:58,900 --> 00:03:00,300\n然后CTRLV粘贴\n\n55\n00:03:00,300 --> 00:03:03,709\n那么在这里我们需要把杠杠AAR\n\n56\n00:03:03,709 --> 00:03:08,129\n后面的这个参数是指的我们画面的画幅比例\n\n57\n00:03:08,129 --> 00:03:09,749\n我们可以把这个画画\n\n58\n00:03:09,749 --> 00:03:13,610\n画幅比例给它变成九比16\n\n59\n00:03:15,120 --> 00:03:17,520\n好也就是说它是一个竖版图\n\n60\n00:03:17,520 --> 00:03:21,390\n那么回车确定这样的话呢\n\n61\n00:03:21,390 --> 00:03:24,190\n我们就可以等着他给我们出一个第一幅\n\n62\n00:03:24,190 --> 00:03:25,350\n就是第一幅图了\n\n63\n00:03:25,350 --> 00:03:28,480\n那剩下的这几个我们也可以去实验一下\n\n64\n00:03:28,480 --> 00:03:31,560\n第二个就是水彩风格的\n\n65\n00:03:32,920 --> 00:03:34,320\nCTRLC复制\n\n66\n00:03:34,320 --> 00:03:36,640\n还是到这里面来一个斜杠\n\n67\n00:03:36,640 --> 00:03:38,850\n选择一下MAJOURNEY的机器人\n\n68\n00:03:38,850 --> 00:03:40,070\n然后给他\n\n69\n00:03:40,070 --> 00:03:46,140\n并且再重新改变一下九比16\n\n70\n00:03:46,140 --> 00:03:48,580\n注意你的输入法一定都得是英文的啊\n\n71\n00:03:48,580 --> 00:03:49,940\n英文状态下才可以\n\n72\n00:03:49,940 --> 00:03:51,580\n然后回车确定\n\n73\n00:03:51,580 --> 00:03:54,200\n我们可以看到上面的这个已经出来了\n\n74\n00:03:54,200 --> 00:03:55,510\n你看是吧\n\n75\n00:03:55,510 --> 00:03:57,190\n就是非常简约的哈\n\n76\n00:03:57,190 --> 00:03:59,190\n日落时分的这种剪影\n\n77\n00:03:59,190 --> 00:04:03,440\n给人感觉很宁静的这种艺术类的享受啊\n\n78\n00:04:03,440 --> 00:04:06,480\n那如果你想想要其中的某一个的话\n\n79\n00:04:06,480 --> 00:04:09,580\n那你就点击像U1就代表着第一张\n\n80\n00:04:09,580 --> 00:04:10,900\nU2代表第二张\n\n81\n00:04:10,900 --> 00:04:11,850\n以此类推\n\n82\n00:04:11,850 --> 00:04:12,990\n你想要谁\n\n83\n00:04:12,990 --> 00:04:14,930\n你就直接点击U1U2\n\n84\n00:04:14,930 --> 00:04:17,490\n那么单独的这一小张就可以放大了\n\n85\n00:04:17,490 --> 00:04:19,589\n比如说我选择U400\n\n86\n00:04:19,589 --> 00:04:20,790\n那我就点击U4\n\n87\n00:04:20,790 --> 00:04:23,300\n这个时候等待一会儿\n\n88\n00:04:23,300 --> 00:04:24,340\n你看这样的话\n\n89\n00:04:24,340 --> 00:04:26,660\nU4就单独去进行放大\n\n90\n00:04:26,660 --> 00:04:28,870\n这个U4啊就单独进行放大\n\n91\n00:04:28,870 --> 00:04:30,510\n那么下面的这个的话呢\n\n92\n00:04:30,510 --> 00:04:33,490\n就是我们第二组提示词出来的结果\n\n93\n00:04:33,490 --> 00:04:36,740\n一看它就是水彩的这种哈晕染的这种风格\n\n94\n00:04:36,740 --> 00:04:40,020\n那么这四张你也同样可以挑选一个啊\n\n95\n00:04:40,020 --> 00:04:42,060\n比如说第三章我觉得挺好\n\n96\n00:04:42,060 --> 00:04:43,750\n那么我就点击U3\n\n97\n00:04:43,750 --> 00:04:46,350\n这样的话它就会自己单独放大\n\n98\n00:04:46,350 --> 00:04:47,270\n以此类推\n\n99\n00:04:47,270 --> 00:04:51,020\n我们可以根据deep sick给我们的这些提示词\n\n100\n00:04:51,020 --> 00:04:53,600\n去选择想要的这种结果\n\n101\n00:04:53,600 --> 00:04:55,400\n那么当你选中了一个以后\n\n102\n00:04:55,400 --> 00:04:57,540\n把它点点点到现在这么大\n\n103\n00:04:57,540 --> 00:05:00,720\n然后右键给它进行图片的存储为\n\n104\n00:05:00,720 --> 00:05:02,760\n就可以把它进行下载了\n\n105\n00:05:02,760 --> 00:05:03,240\n好\n\n106\n00:05:03,240 --> 00:05:06,520\n那以上呢就是如何利用AI工具去生成\n\n107\n00:05:06,520 --> 00:05:08,040\n个性化的手机壁纸\n\n108\n00:05:08,040 --> 00:05:09,700\n咱们大家学会了吗\n\n"}]}, "webpage_url": "https://www.bilibili.com/video/BV1D5Gi6QEN7?p=5", "webpage_url_basename": "BV1D5Gi6QEN7", "webpage_url_domain": "bilibili.com", "extractor": "BiliBili", "extractor_key": "BiliBili", "playlist_count": 82, "playlist": "【AI零基础入门】清华大佬终于讲完了AIGC全套教程变现课！含AI广告制作+AI绘画+视频视听语言全流程！全程干货无废话，学完即可副业变现！", "playlist_id": "BV1D5Gi6QEN7", "playlist_title": "【AI零基础入门】清华大佬终于讲完了AIGC全套教程变现课！含AI广告制作+AI绘画+视频视听语言全流程！全程干货无废话，学完即可副业变现！", "playlist_webpage_url": "https://www.bilibili.com/video/BV1D5Gi6QEN7/", "n_entries": 82, "playlist_index": 5, "thumbnails": [{"url": "http://i2.hdslb.com/bfs/archive/ddf2b57576483ae9189affdcd82a8353a0b54e86.jpg", "id": "0"}], "display_id": "BV1D5Gi6QEN7_p5", "fulltitle": "【AI零基础入门】清华大佬终于讲完了AIGC全套教程变现课！含AI广告制作+AI绘画+视频视听语言全流程！全程干货无废话，学完即可副业变现！ p05 【AI文生图】AI 绘画生成个性化手机壁纸", "duration_string": "5:11", "upload_date": "20260523", "epoch": 1780709159, "format": "1080P 高清+30280 - audio only", "format_id": "100026+30280", "ext": "mp4", "protocol": "https+https", "filesize_approx": 12517708, "tbr": 321.942, "width": 1920, "height": 1080, "resolution": "1920x1080", "fps": 30.0, "dynamic_range": "SDR", "vcodec": "av01.0.00M.10.0.110.01.01.01.0", "vbr": 225.807, "aspect_ratio": 1.78, "acodec": "mp4a.40.2", "abr": 96.135, "_type": "video", "_version": {"version": "2026.03.17", "release_git_head": "04d6974f502bbdfaed72c624344f262e30ad9708", "repository": "yt-dlp/yt-dlp"}}