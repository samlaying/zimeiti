form=pc&trid=00007c431ea1763b4aafb93770f250ceaecu&og=cos&oi=771429739&gen=playurlv3&upsig=4f53ed8e95543e4716eb81177d48c83e&uparams=e,os,mid,nbs,deadline,uipk,platform,trid,og,oi,gen&cdnid=70002&bvc=vod&nettype=0&bw=336128&lrs=0&buvid=56CBBADE-6E37-C95A-FAC9-97160BE6D01C13885infoc&build=0&dl=0&f=u_0_0&qn_dyeid=9f7d6025573736100025bc896a23768d&np=151339102&agrr=1&orderid=0,3", "ext": "mp4", "fps": 30.0, "width": 1920, "height": 1080, "vcodec": "avc1.640033", "acodec": "none", "dynamic_range": "SDR", "tbr": 335.955, "quality": 80, "format_id": "30080", "format": "1080P 高清", "protocol": "https", "video_ext": "mp4", "audio_ext": "none", "abr": 0, "vbr": 335.955, "resolution": "1920x1080", "aspect_ratio": 1.78, "filesize_approx": 39661587, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/141.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.bilibili.com/video/BV1D5Gi6QEN7?p=2"}}, {"url": "https://cn-bj-fx-01-02.bilivideo.com/upgcxcode/84/94/38552669484/38552669484-1-100026.m4s?e=ig8euxZM2rNcNbdlhoNvNC8BqJIzNbfqXBvEqxTEto8BTrNvN0GvT90W5JZMkX_YN0MvXg8gNEV4NC8xNEV4N03eN0B5tZlqNxTEto8BTrNvNeZVuJ10Kj_g2UB02J0mN0B5tZlqNCNEto8BTrNvNC7MTX502C8f2jmMQJ6mqF2fka1mqx6gqj0eN0B599M=&deadline=1780716205&uipk=5&platform=pc&mid=3546568672151587&nbs=1&gen=playurlv3&os=bcache&trid=00007c431ea1763b4aafb93770f250ceaecu&oi=771429739&og=ali&upsig=009f4c30e2f75bcf649fd4b13cb6f835&uparams=e,deadline,uipk,platform,mid,nbs,gen,os,trid,oi,og&cdnid=70002&bvc=vod&nettype=0&bw=249623&lrs=0&agrr=1&buvid=56CBBADE-6E37-C95A-FAC9-97160BE6D01C13885infoc&build=0&dl=0&f=u_0_0&qn_dyeid=9f7d6025573736100025bc896a23768d&np=151339102&orderid=0,3", "ext": "mp4", "fps": 30.0, "width": 1920, "height": 1080, "vcodec": "av01.0.00M.10.0.110.01.01.01.0", "acodec": "none", "dynamic_range": "SDR", "tbr": 249.48, "quality": 80, "format_id": "100026", "format": "1080P 高清", "protocol": "https", "video_ext": "mp4", "audio_ext": "none", "abr": 0, "vbr": 249.48, "resolution": "1920x1080", "aspect_ratio": 1.78, "filesize_approx": 29452673, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/141.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.bilibili.com/video/BV1D5Gi6QEN7?p=2"}}], "duration": 944.45, "subtitles": {"danmaku": [{"ext": "xml", "url": "https://comment.bilibili.com/38552669484.xml"}], "ai-zh": [{"ext": "srt", "data": "1\n00:00:01,260 --> 00:00:02,140\n同学们大家好\n\n2\n00:00:02,140 --> 00:00:03,480\n我是你们的子文老师\n\n3\n00:00:03,480 --> 00:00:07,360\n这堂课我们来学习一下康复UI的基础操作\n\n4\n00:00:07,360 --> 00:00:09,740\n我们这堂课一共分成了三个部分\n\n5\n00:00:09,740 --> 00:00:12,580\n第一个部分是康复UI的基础知识\n\n6\n00:00:12,580 --> 00:00:15,900\n第二个部分是搭建基础工作流的方法\n\n7\n00:00:15,900 --> 00:00:19,380\n第三个部分是一些复杂工作流的初探\n\n8\n00:00:19,380 --> 00:00:21,220\n我们先来看第一个部分\n\n9\n00:00:21,220 --> 00:00:22,880\n康复UI的基础知识\n\n10\n00:00:22,880 --> 00:00:25,939\n首先我们要了解一下什么是康复UI\n\n11\n00:00:25,939 --> 00:00:27,299\n其实CONVI呢\n\n12\n00:00:27,299 --> 00:00:31,219\n就是以工作流的形式去进行运行和使用的\n\n13\n00:00:31,219 --> 00:00:32,380\nServer defasion\n\n14\n00:00:32,380 --> 00:00:34,380\n我们前一阵子的课程里面\n\n15\n00:00:34,380 --> 00:00:38,720\n曾经学过web ui形式的SBSEBDEFASION\n\n16\n00:00:38,720 --> 00:00:41,870\n那么今天我们要给大家介绍的就是SD\n\n17\n00:00:41,870 --> 00:00:42,870\nSEVINFUSION呢\n\n18\n00:00:42,870 --> 00:00:46,070\n其实它是可以有两种表现形式的\n\n19\n00:00:46,070 --> 00:00:47,830\n一种呢是web ui\n\n20\n00:00:47,830 --> 00:00:50,610\n也就是用界面形式去表现出来的\n\n21\n00:00:50,610 --> 00:00:53,230\n另外一部分呢就是用工作流形式\n\n22\n00:00:53,230 --> 00:00:55,010\n也就是康复UI表现的\n\n23\n00:00:55,010 --> 00:00:57,430\n我们可以一起来看一下\n\n24\n00:00:58,030 --> 00:01:02,110\n以前的话我们主要用到的SB平台是lib\n\n25\n00:01:02,110 --> 00:01:03,330\nlib这个平台\n\n26\n00:01:03,330 --> 00:01:06,650\n当我们点进来这个网站的首页以后\n\n27\n00:01:06,650 --> 00:01:09,770\n在左侧这个位置有一个在线生成\n\n28\n00:01:09,770 --> 00:01:12,240\n下面写的是web ui的按钮\n\n29\n00:01:12,240 --> 00:01:13,440\n点击进去以后\n\n30\n00:01:13,440 --> 00:01:14,820\n我们就可以进入到\n\n31\n00:01:14,820 --> 00:01:17,170\n已经很熟悉的这样的一个界面\n\n32\n00:01:17,170 --> 00:01:18,710\n那么在这个界面里呢\n\n33\n00:01:18,710 --> 00:01:21,030\n我们可以去选择它的大模型\n\n34\n00:01:21,030 --> 00:01:22,370\n选择VNE\n\n35\n00:01:22,370 --> 00:01:24,810\n在正反提示词里面输入\n\n36\n00:01:24,810 --> 00:01:28,699\n提示词下面还会有一系列的参数给我们选择\n\n37\n00:01:28,699 --> 00:01:30,539\n然后点击下生图\n\n38\n00:01:30,539 --> 00:01:33,350\n这边就可以实现它的结果\n\n39\n00:01:33,350 --> 00:01:37,270\n那么这个呢就是我们传统的所说的web ui了\n\n40\n00:01:37,270 --> 00:01:39,210\n那么CONFIUI是什么样子呢\n\n41\n00:01:39,210 --> 00:01:40,110\n可以看一下\n\n42\n00:01:40,110 --> 00:01:41,600\n就是这样的一个界面\n\n43\n00:01:41,600 --> 00:01:45,640\n这个界面的话是在它网站的首页左侧\n\n44\n00:01:45,640 --> 00:01:50,150\n这个位置有一个叫做在线工作流康复UI的按钮\n\n45\n00:01:50,150 --> 00:01:53,930\n点击以后就可以进入到这样一个黑色的界面\n\n46\n00:01:53,930 --> 00:01:56,050\n在这个界面里可以看到\n\n47\n00:01:56,050 --> 00:01:59,170\n像这样的一个一个的小方块\n\n48\n00:01:59,170 --> 00:02:03,860\n它们是被一些彩色的线条连接串联在一起\n\n49\n00:02:03,860 --> 00:02:06,740\n那么这个状态就是工作流的状态\n\n50\n00:02:06,740 --> 00:02:09,419\n每一个小方块叫做一个节点\n\n51\n00:02:09,419 --> 00:02:13,960\n那工作流也就是通过不同节点这些个功能\n\n52\n00:02:13,960 --> 00:02:15,760\n不同的节点有不同的功能\n\n53\n00:02:15,760 --> 00:02:17,040\n它们串联在一起\n\n54\n00:02:17,040 --> 00:02:21,579\n最后从左到右生成一个最终的结果\n\n55\n00:02:21,579 --> 00:02:24,119\n那么以上呢就是我们所说的啊\n\n56\n00:02:24,119 --> 00:02:25,970\n什么是康复UI\n\n57\n00:02:25,970 --> 00:02:31,410\n简单来说它就是以工作流形式去进行运行的SD\n\n58\n00:02:31,410 --> 00:02:34,510\n那么接下来说一下康复UI和web ui\n\n59\n00:02:34,510 --> 00:02:35,970\n它们两个的异同点\n\n60\n00:02:35,970 --> 00:02:37,690\n首先相同点\n\n61\n00:02:37,690 --> 00:02:40,050\n它们其实本质上是一样的\n\n62\n00:02:40,050 --> 00:02:40,990\n是相同的\n\n63\n00:02:40,990 --> 00:02:44,630\n其实呢都是在实现SD的各种功能\n\n64\n00:02:44,630 --> 00:02:47,630\n也就是说它就是SD不同的表现形式\n\n65\n00:02:47,630 --> 00:02:49,190\n那么它的不同点\n\n66\n00:02:49,190 --> 00:02:52,190\n第一个就是操作逻辑是不一样的\n\n67\n00:02:52,190 --> 00:02:55,370\n一个呢是以工作流的形式去进行操作\n\n68\n00:02:55,370 --> 00:02:58,290\n还有一个的话呢是界面化的形式\n\n69\n00:02:58,290 --> 00:03:01,630\n通过选择不同的这些参数和命令\n\n70\n00:03:01,630 --> 00:03:03,690\n然后去实现功能\n\n71\n00:03:03,690 --> 00:03:05,490\n第二个就是康复UI\n\n72\n00:03:05,490 --> 00:03:08,370\n它工作流呢是可以导入和导出的\n\n73\n00:03:08,370 --> 00:03:11,079\n我们看刚才的这样的一个界面\n\n74\n00:03:11,079 --> 00:03:14,479\n在这个界面里可以看到上面这个位置\n\n75\n00:03:14,479 --> 00:03:15,940\n有一个下载按钮\n\n76\n00:03:15,940 --> 00:03:18,680\n当我点击这个下载按钮的时候\n\n77\n00:03:18,680 --> 00:03:21,380\n这边就可以把当前的这个工作流\n\n78\n00:03:21,380 --> 00:03:24,770\n以一个文件的形式下载到我们的电脑上\n\n79\n00:03:24,770 --> 00:03:28,330\n那么你把这个文件拿到别人电脑上再去进行\n\n80\n00:03:28,330 --> 00:03:29,110\n打开的话\n\n81\n00:03:29,110 --> 00:03:30,250\n完全可以\n\n82\n00:03:30,250 --> 00:03:32,910\n这样的话我们就可以把同一个工作流\n\n83\n00:03:32,910 --> 00:03:34,650\n用在不同的场合\n\n84\n00:03:34,650 --> 00:03:37,050\n给不同的人去进行使用\n\n85\n00:03:37,050 --> 00:03:40,370\n同时也可以像点击这样的一个按钮\n\n86\n00:03:40,370 --> 00:03:42,690\n它可以打开本地的工作流\n\n87\n00:03:42,690 --> 00:03:45,070\n可以选择某一个工作流的文件\n\n88\n00:03:45,070 --> 00:03:46,290\n点击打开以后\n\n89\n00:03:46,290 --> 00:03:48,110\n那在我们这个电脑上\n\n90\n00:03:48,110 --> 00:03:50,790\n就可以去使用别人的工作流\n\n91\n00:03:50,790 --> 00:03:52,870\n这是它非常灵活的一点\n\n92\n00:03:52,870 --> 00:03:57,870\n而这一点呢是外部UI所不具备的好\n\n93\n00:03:57,870 --> 00:04:00,610\n那么我们还有一个就是CTRI呢\n\n94\n00:04:00,610 --> 00:04:03,140\n它的更新频率是很快的\n\n95\n00:04:03,140 --> 00:04:05,460\n那我们可以看到刚才康复UI\n\n96\n00:04:05,460 --> 00:04:07,060\n它是通过不同的节点\n\n97\n00:04:07,060 --> 00:04:09,040\n不同的功能组合到一起\n\n98\n00:04:09,040 --> 00:04:11,200\n然后去进行实现功能的\n\n99\n00:04:11,200 --> 00:04:12,960\n那么这样的不同的节点\n\n100\n00:04:12,960 --> 00:04:15,860\n不同的功能是可以通过不同的开发者\n\n101\n00:04:15,860 --> 00:04:18,040\n他们自己去进行开发\n\n102\n00:04:18,040 --> 00:04:20,800\n并且上传提供给你们下载\n\n103\n00:04:20,800 --> 00:04:24,410\n这样