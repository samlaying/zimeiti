=pc&trid=8707ed7483f94abfb00547a30921189u&gen=playurlv3&upsig=f5bfcee1dad348469d8fedbb861b1361&uparams=e,mid,uipk,oi,deadline,os,og,nbs,platform,trid,gen&hdnts=exp=1780726699~hmac=85401f4b893e32c7b95eba407d2cedea57ca33d323f59cfbc1261db6a8d26858&bvc=vod&nettype=0&bw=106846&lrs=0&build=0&dl=0&f=u_0_0&qn_dyeid=c39ff6b9eebdbd4a007f09696a239f8b&agrr=0&buvid=56CBBADE-6E37-C95A-FAC9-97160BE6D01C13885infoc&orderid=0,2", "ext": "mp4", "fps": 30.0, "width": 1920, "height": 1080, "vcodec": "avc1.640033", "acodec": "none", "dynamic_range": "SDR", "tbr": 106.751, "quality": 80, "format_id": "30080", "format": "1080P 高清", "protocol": "https", "video_ext": "mp4", "audio_ext": "none", "abr": 0, "vbr": 106.751, "resolution": "1920x1080", "aspect_ratio": 1.78, "filesize_approx": 3205025, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/138.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.bilibili.com/video/BV1D5Gi6QEN7?p=44"}}], "duration": 240.187, "subtitles": {"danmaku": [{"ext": "xml", "url": "https://comment.bilibili.com/38553193678.xml"}], "ai-zh": [{"ext": "srt", "data": "1\n00:00:01,140 --> 00:00:02,020\n同学们大家好\n\n2\n00:00:02,020 --> 00:00:03,400\n我是你们的子文老师\n\n3\n00:00:03,400 --> 00:00:05,370\n这堂课咱们来学习一下\n\n4\n00:00:05,370 --> 00:00:09,110\n如何利用AI工具去编写电商的详情页的\n\n5\n00:00:09,110 --> 00:00:10,500\n详情页的文案\n\n6\n00:00:10,500 --> 00:00:14,320\n如果你曾经试图用AI去写电商详情页\n\n7\n00:00:14,320 --> 00:00:17,200\n那么你可能会发现AI给你的这种文案\n\n8\n00:00:17,200 --> 00:00:18,560\n要么就是太生硬了\n\n9\n00:00:18,560 --> 00:00:19,980\n要么就是像流水账\n\n10\n00:00:19,980 --> 00:00:20,680\n没有钩子\n\n11\n00:00:20,680 --> 00:00:21,710\n也没有亮点\n\n12\n00:00:21,710 --> 00:00:23,910\n还不如自己去憋半个小时呢\n\n13\n00:00:23,910 --> 00:00:26,470\n但是呢你不用急着去否定AI\n\n14\n00:00:26,470 --> 00:00:27,870\n其实不是AI不行\n\n15\n00:00:27,870 --> 00:00:29,030\n而是你不会用\n\n16\n00:00:29,030 --> 00:00:31,710\n咱们今天就教你一套方法\n\n17\n00:00:31,710 --> 00:00:33,350\n让AI去写出\n\n18\n00:00:33,350 --> 00:00:36,700\n像你像人还还能去带货\n\n19\n00:00:36,700 --> 00:00:39,810\n卖货的这样的一个详情页的文案\n\n20\n00:00:40,210 --> 00:00:43,650\n咱们知道电商详情页的文案它不是作文\n\n21\n00:00:43,650 --> 00:00:45,030\n它也不是白描\n\n22\n00:00:45,030 --> 00:00:48,310\n而是对用户心理的一寸一寸的拆解\n\n23\n00:00:48,310 --> 00:00:52,330\n以及呢对于产品价值一个点一个点的打磨\n\n24\n00:00:52,330 --> 00:00:54,310\n最怕的就是三件事儿\n\n25\n00:00:54,310 --> 00:00:56,129\n第一个呢是写的太假了\n\n26\n00:00:56,129 --> 00:00:59,009\n如果你全都是像什么质地柔软啦\n\n27\n00:00:59,009 --> 00:01:00,129\n高端大气呀\n\n28\n00:01:00,129 --> 00:01:01,109\n像这样的形容词\n\n29\n00:01:01,109 --> 00:01:02,369\n它是没有画面感的\n\n30\n00:01:02,369 --> 00:01:03,410\n这样不行\n\n31\n00:01:03,410 --> 00:01:05,610\n第二个呢就是写的太笼统了\n\n32\n00:01:05,610 --> 00:01:09,450\n比如说像什么有效防晒或者是三秒吸收\n\n33\n00:01:09,450 --> 00:01:11,730\n像这样的形容词呢都是太空了\n\n34\n00:01:11,730 --> 00:01:13,289\n它是打动不了人的\n\n35\n00:01:13,289 --> 00:01:15,229\n还有就是写的太AI\n\n36\n00:01:15,229 --> 00:01:17,349\n比如说就是那种套路开头\n\n37\n00:01:17,349 --> 00:01:20,449\n然后呢用模板的语言一眼就看穿\n\n38\n00:01:20,449 --> 00:01:21,990\n它是自动生成的\n\n39\n00:01:21,990 --> 00:01:25,070\n所以咱们要是用AI去写电商文案\n\n40\n00:01:25,070 --> 00:01:27,310\n它的底层逻辑一共有四点\n\n41\n00:01:27,310 --> 00:01:29,540\n第一个就是人设优先\n\n42\n00:01:29,540 --> 00:01:31,520\n就是要写谁在用\n\n43\n00:01:31,520 --> 00:01:33,990\n而不是这是什么\n\n44\n00:01:33,990 --> 00:01:36,610\n第二个呢就是要痛点破题\n\n45\n00:01:36,610 --> 00:01:38,070\n要有场景\n\n46\n00:01:38,070 --> 00:01:39,570\n从场景入手\n\n47\n00:01:39,570 --> 00:01:42,620\n能够引起你的情绪的共鸣\n\n48\n00:01:42,620 --> 00:01:45,020\n第三个就是卖点钉锤\n\n49\n00:01:45,020 --> 00:01:46,200\n你要有数字\n\n50\n00:01:46,200 --> 00:01:47,020\n有对比\n\n51\n00:01:47,020 --> 00:01:47,900\n有细节\n\n52\n00:01:47,900 --> 00:01:49,250\n还要有感知\n\n53\n00:01:49,250 --> 00:01:52,470\n最后一个就是语言要去掉AI味\n\n54\n00:01:52,470 --> 00:01:54,450\n要拒绝像什么赋能啊\n\n55\n00:01:54,450 --> 00:01:55,210\n驱动啊\n\n56\n00:01:55,210 --> 00:02:00,480\n像这样的词语要用一种生活化的语言去表达好\n\n57\n00:02:00,480 --> 00:02:01,220\n那么最后呢\n\n58\n00:02:01,220 --> 00:02:05,320\n咱们用一个实践的案例去说明整个的过程\n\n59\n00:02:05,320 --> 00:02:09,100\n我们把这段提示词给到deep sc看一下\n\n60\n00:02:09,100 --> 00:02:10,199\n他是这么写的啊\n\n61\n00:02:10,199 --> 00:02:11,960\n请根据以下的信息\n\n62\n00:02:11,960 --> 00:02:13,180\n用口语化\n\n63\n00:02:13,180 --> 00:02:13,960\n真实\n\n64\n00:02:13,960 --> 00:02:18,329\n代入感强的风格去写一段电商详情页的文案\n\n65\n00:02:18,329 --> 00:02:20,369\n第一个呢就是产品的类型啊\n\n66\n00:02:20,369 --> 00:02:23,010\n它是一个防晒喷雾用户的人设\n\n67\n00:02:23,010 --> 00:02:24,930\n就是他面对的这个消费者\n\n68\n00:02:24,930 --> 00:02:27,860\n消费人群是25~35岁的女性\n\n69\n00:02:27,860 --> 00:02:31,200\n使用的场景是早上出门前的3分钟\n\n70\n00:02:31,200 --> 00:02:34,920\n卖点和亮点就是三秒吸收不油腻\n\n71\n00:02:34,920 --> 00:02:35,820\n不闷痘\n\n72\n00:02:35,820 --> 00:02:39,890\nSPF50加有控油的成分\n\n73\n00:02:39,890 --> 00:02:43,490\n那么风风格的要求要避免有AI感\n\n74\n00:02:43,490 --> 00:02:47,180\n像一个熟人一样推荐你产品那样去表达\n\n75\n00:02:47,180 --> 00:02:49,420\n说出一段150字以内的描述\n\n76\n00:02:49,420 --> 00:02:51,260\n文案适合放在详情页\n\n77\n00:02:51,260 --> 00:02:53,940\n场景描述或者是核心卖点区\n\n78\n00:02:53,940 --> 00:02:57,100\n但是他这里面是有一定的区域的啊\n\n79\n00:02:57,100 --> 00:03:00,740\n好然后我们点击下发送\n\n80\n00:03:04,960 --> 00:03:06,680\n可以看到它已经生成了\n\n81\n00:03:06,680 --> 00:03:08,560\n写的是每天早上赶着出门\n\n82\n00:03:08,560 --> 00:03:10,829\n哪有时间等防晒慢慢吸收\n\n83\n00:03:10,829 --> 00:03:12,069\n姐妹我懂你\n\n84\n00:03:12,069 --> 00:03:15,369\n这款防晒喷雾简直是为懒人量身定制\n\n85\n00:03:15,369 --> 00:03:17,849\n喷上喷上脸三秒就吸收\n\n86\n00:03:17,849 --> 00:03:18,949\n完全不黏腻\n\n87\n00:03:18,949 --> 00:03:20,190\n不泛油光\n\n88\n00:03:20,190 --> 00:03:23,830\nSSPF50加的高倍防护力\n\n89\n00:03:23,830 --> 00:03:26,520\n让你在太阳底下也能白成一道光\n\n90\n00:03:26,520 --> 00:03:28,700\n最绝的是添加了控油成分\n\n91\n00:03:28,700 --> 00:03:32,030\n我这个混油皮用了一夏天都没有闷痘\n\n92\n00:03:32,030 --> 00:03:33,250\n妆前喷一喷\n\n93\n00:03:33,250 --> 00:03:34,970\n还能让底妆更加服帖\n\n94\n00:03:34,970 --> 00:03:37,430\n我现在的化妆台C位永远是她\n\n95\n00:03:37,430 --> 00:03:39,880\n3分钟搞定防晒加控油\n\n96\n00:03:39,880 --> 00:03:41,540\n多睡一会儿懒觉不香吗\n\n97\n00:03:41,540 --> 00:03:43,820\n你看一共149次\n\n98\n00:03:43,820 --> 00:03:47,460\n就是按照刚才咱们提示词里面的这些要求\n\n99\n00:03:47,460 --> 00:03:48,840\n去生成的对吧\n\n100\n00:03:48,840 --> 00:03:50,550\n非常有活人感啊\n\n101\n00:03:50,550 --> 00:03:51,050\n好\n\n102\n00:03:51,050 --> 00:03:55,510\n那么以上呢就是如何利用AI工具去编写\n\n103\n00:03:55,510 --> 00:03:57,790\n电商详情页文案的方法\n\n104\n00:03:57,790 --> 00:03:59,500\n咱们大家学会了吗\n\n"}]}, "webpage_url": "https://www.bilibili.com/video/BV1D5Gi6QEN7?p=44", "webpage_url_basename": "BV1D5Gi6QEN7", "webpage_url_domain": "bilibili.com", "extractor": "BiliBili", "extractor_key": "BiliBili", "playlist_count": 82, "playlist": "【AI零基础入门】清华大佬终于讲完了AIGC全套教程变现课！含AI广告制作+AI绘画+视频视听语言全流程！全程干货无废话，学完即可副业变现！", "playlist_id": "BV1D5Gi6QEN7", "playlist_title": "【AI零基础入门】清华大佬终于讲完了AIGC全套教程变现课！含AI广告制作+AI绘画+视频视听语言全流程！全程干货无废话，学完即可副业变现！", "playlist_webpage_url": "https://www.bilibili.com/video/BV1D5Gi6QEN7/", "n_entries": 64, "playlist_index": 44, "thumbnails": [{"url": "http://i2.hdslb.com/bfs/archive/ddf2b57576483ae9189affdcd82a8353a0b54e86.jpg", "id": "0"}], "display_id": "BV1D5Gi6QEN7_p44", "fulltitle": "【AI零基础入门】清华大佬终于讲完了AIGC全套教程变现课！含AI广告制作+AI绘画+视频视听语言全流程！全程干货无废话，学完即可副业变现！ p44 【AI文生图】AI 编写电商详情页文案", "duration_string": "4:00", "upload_date": "20260523", "epoch": 1780719514, "format": "1080P 高清+30280 - audio only", "format_id": "30080+30280", "ext": "mp4", "protocol": "https+https", "filesize_approx": 5812675, "tbr": 193.60500000000002, "width": 1920, "height": 1080, "resolution": "1920x1080", "fps": 30.0, "dynamic_range": "SDR", "vcodec": "avc1.640033", "vbr": 106.751, "aspect_ratio": 1.78, "acodec": "mp4a.40.2", "abr": 86.854, "_type": "video", "_version": {"version": "2026.03.17", "release_git_head": "04d6974f502bbdfaed72c624344f262e30ad9708", "repository": "yt-dlp/yt-dlp"}}